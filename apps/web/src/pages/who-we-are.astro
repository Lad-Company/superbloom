---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ContactBand from '../components/ContactBand.astro';
import Marquee from '../components/Marquee.astro';
import FactCardGrid from '../components/FactCardGrid.astro';
import DisciplineList from '../components/DisciplineList.astro';
import TwoUp from '../components/TwoUp.astro';
import Faq from '../components/Faq.astro';
import SurfaceSection from '../components/SurfaceSection.astro';
import PageHero from '../components/PageHero.astro';
import WhoWeAreFeaturedMedia from '../components/who-we-are/WhoWeAreFeaturedMedia.astro';
import WhoWeAreIntro from '../components/who-we-are/WhoWeAreIntro.astro';
import WhoWeAreAdvantages from '../components/who-we-are/WhoWeAreAdvantages.astro';
import { fetchSafe, getSanityClient } from '../lib/sanity';
import { isPreviewRequest } from '../lib/preview';
import { setContentCache } from '../lib/cacheHeaders';
import { whoWeAreQuery } from '../lib/queries';
import { seoImage } from '../lib/seo';
import type { WhoWeAreQueryResult } from '../sanity.types';

const preview = isPreviewRequest(Astro.cookies);
const client = getSanityClient(preview);
setContentCache(Astro.response, preview);

const page = await fetchSafe<WhoWeAreQueryResult>(client, whoWeAreQuery);
if (page === undefined) {
  Astro.response.status = 500;
  return Astro.rewrite('/500');
}

const heroHeading = page?.heroHeading ?? 'Audiences move fast. We help you move faster.';
const introStatement =
  page?.introStatement ??
  'SuperBloom is an independent creative company built to move brands beyond advertising. We bring varied disciplines together powered by a collective of unexpected minds who make unignorable work.';
const marqueeText =
  page?.marquee?.text ??
  'Campaigns. Content. Experiences. branded Entertainment. Social. strategy. creative.';
const featuredMedia = page?.featuredMedia?.media ?? null;
const featuredMediaRatio = page?.featuredMedia?.aspectRatio ?? '16:9';
const introMedia = page?.introMedia?.length ? page.introMedia : (featuredMedia ? [featuredMedia] : []);
const statCards = page?.statCards ?? [];
const advantageHeadline = page?.advantageHeadline ?? 'Our unfair advantage';
const advantageBlocks = page?.advantageBlocks ?? [];
const disciplines = page?.disciplines ?? [];
const ctas = page?.ctas ?? [];
const faqs = page?.faqs ?? [];
// Site Settings toggle; undefined means the doc predates the field, so keep
// rendering (matches the schema's initialValue: true).
const showFaq = page?.showFaq ?? true;
const faqVisible = showFaq && faqs.length > 0;

---

<Layout title="Who We Are" description={introStatement} image={seoImage(featuredMedia)} navRole="dark">
  <SurfaceSection role="dark">
    <div class="who-hero-pad">
      <PageHero heading={heroHeading} />
    </div>
  </SurfaceSection>

  <SurfaceSection role="brand-accent">
    <WhoWeAreFeaturedMedia
      media={featuredMedia}
      ratio={featuredMediaRatio}
      title={heroHeading}
    />
  </SurfaceSection>

  <SurfaceSection role="brand-muted">
    <Marquee text={marqueeText} />
  </SurfaceSection>

  {/* WhoWeAreIntro renders its own SurfaceSection via the shared
      ParallaxStatement section component. */}
  <WhoWeAreIntro
    statement={introStatement}
    media={introMedia}
    showImageLayers={page?.showImageLayers}
    theme={page?.introTheme}
  />

  {statCards.length > 0 && (
    <FactCardGrid cards={statCards} />
  )}

  {advantageBlocks.length > 0 && (
    <WhoWeAreAdvantages headline={advantageHeadline} blocks={advantageBlocks} />
  )}

  {disciplines.length > 0 && (
    <SurfaceSection role="dark">
      <div class="discipline-section">
        <DisciplineList items={disciplines} />
      </div>
    </SurfaceSection>
  )}

  {ctas.length > 0 && (
    <SurfaceSection role="dark" class:list={[!faqVisible && 'ctas-pad-bottom']}>
      <TwoUp items={ctas} />
    </SurfaceSection>
  )}

  {faqVisible && (
    <SurfaceSection role="dark">
      <Faq items={faqs} />
    </SurfaceSection>
  )}

  <ContactBand role="brand-accent" />
  <Footer />
</Layout>

<style>
  .discipline-section {
    /* Top padding only: the next section (TwoUp) carries its own 4xl top
       padding, so a bottom pad here would double the gap to 400px. The
       single 4xl (2xl on mobile via TwoUp) is the intended inter-section
       spacing. */
    padding: var(--space-4xl) 0 0;
  }

  /* TwoUp keeps zero bottom padding because the FAQ below it carries the
     inter-section gap as top padding. When the FAQ is hidden (Site Settings
     toggle or no questions), that gap would land inside ContactBand's accent
     surface and leave this dark section flush with the boundary — restore
     the FAQ's share (4xl desktop, 2xl mobile) here instead. */
  .ctas-pad-bottom {
    padding-bottom: var(--space-4xl);
  }
  @media (--bp-small) {
    .ctas-pad-bottom {
      padding-bottom: var(--space-2xl);
    }
  }

  /* The header (dark) and the lead media (accent) are separate colored
     sections, so the 96px header→media hand-off must sit on the black header,
     not inside the colored media box. Desktop only; the mobile hero keeps its
     own bottom padding. */
  @media (--bp-desktop) {
    .who-hero-pad {
      padding-bottom: var(--space-xl);
    }
  }
</style>
