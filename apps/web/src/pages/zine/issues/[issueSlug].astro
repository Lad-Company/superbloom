---
import Layout from '../../../layouts/Layout.astro'
import Footer from '../../../components/Footer.astro'
import ContactBand from '../../../components/ContactBand.astro'
import IssueDetail from '../../../components/zine/IssueDetail.astro'
import IssuuEmbed from '../../../components/zine/IssuuEmbed.astro'
import {fetchSafe, getSanityClient, rewriteToServerError} from '../../../lib/sanity'
import {isPreviewRequest} from '../../../lib/preview'
import {setContentCache} from '../../../lib/cacheHeaders'
import {issueArchiveQuery, issueBySlugQuery, zineLandingQuery} from '../../../lib/queries'
import {seoDescription, seoImage} from '../../../lib/seo'

const issueSlug = Astro.params.issueSlug
const preview = isPreviewRequest(Astro.cookies)
const client = getSanityClient(preview)
const issue = await fetchSafe(client, issueBySlugQuery, {slug: issueSlug})

if (issue === undefined) return rewriteToServerError(Astro)

if (!issue) {
  Astro.response.status = 404
  return Astro.rewrite('/404')
}

// ISSUU-embed-only issues skip the full treatment: their archive URL serves a
// minimal flipbook page instead.
const isEmbedOnly = issue.issueMode === 'embed'

if (!isEmbedOnly) {
  const zineLanding = await fetchSafe(client, zineLandingQuery)

  if (zineLanding === undefined) return rewriteToServerError(Astro)

  if (zineLanding?.currentIssue?.slug === issue.slug) {
    return Astro.redirect('/zine', 302)
  }
}

setContentCache(Astro.response, preview)

const pastIssues = isEmbedOnly ? [] : await fetchSafe(client, issueArchiveQuery, {slug: issue.slug})

if (pastIssues === undefined) return rewriteToServerError(Astro)
---

<Layout
  title={issue.title ?? 'Zine'}
  description={seoDescription(issue.editorLetter?.body)}
  image={seoImage(issue.heroMedia)}
  canonicalUrl={`/zine/issues/${issue.slug}`}
  navRole="dark"
>
  {
    isEmbedOnly ? (
      <IssuuEmbed title={issue.title} eyebrow={issue.eyebrow} issuuUrl={issue.issuuUrl} />
    ) : (
      <>
        <IssueDetail issue={issue} pastIssues={pastIssues} />
        <ContactBand role="brand-deep" />
      </>
    )
  }
  <Footer />
</Layout>
