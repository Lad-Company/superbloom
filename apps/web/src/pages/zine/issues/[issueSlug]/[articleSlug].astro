---
import Layout from '../../../../layouts/Layout.astro'
import Footer from '../../../../components/Footer.astro'
import ContactBand from '../../../../components/ContactBand.astro'
import ArticleDetail from '../../../../components/editorial/ArticleDetail.astro'
import ZineStoriesRail from '../../../../components/zine/ZineStoriesRail.astro'
import {getSanityClient} from '../../../../lib/sanity'
import {isPreviewRequest} from '../../../../lib/preview'
import {setContentCache} from '../../../../lib/cacheHeaders'
import {zineArticleBySlugQuery} from '../../../../lib/queries'
import {seoDescription, seoImage} from '../../../../lib/seo'

const issueSlug = Astro.params.issueSlug
const articleSlug = Astro.params.articleSlug
const preview = isPreviewRequest(Astro.cookies)
const client = getSanityClient(preview)
const result = await client.fetch(zineArticleBySlugQuery, {issueSlug, articleSlug})

if (!result?.article || !result.issueSlug) {
  Astro.response.status = 404
  return Astro.rewrite('/404')
}

setContentCache(Astro.response, preview)

const article = result.article
const moreArticles = (result.articles ?? []).filter((item) => item.slug !== article.slug)
---

<Layout
  title={`${article.title ?? 'Article'} — ${result.title ?? 'Zine'}`}
  description={seoDescription(article.overview)}
  image={seoImage(article.leadMedia)}
  canonicalUrl={`/zine/issues/${result.issueSlug}/${article.slug}`}
  navRole="light"
>
  <ArticleDetail article={article} />
  <ZineStoriesRail
    issueSlug={result.issueSlug}
    articles={moreArticles}
    listDefaults={result.listDefaults}
    articleOverrides={result.articleOverrides}
    globalCardDefaults={result.globalCardDefaults}
  />
  <ContactBand role="brand-deep" />
  <Footer />
</Layout>
