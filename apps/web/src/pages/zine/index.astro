---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import ContactBand from '../../components/ContactBand.astro'
import IssueDetail from '../../components/zine/IssueDetail.astro'
import {getSanityClient} from '../../lib/sanity'
import {isPreviewRequest} from '../../lib/preview'
import {setContentCache} from '../../lib/cacheHeaders'
import {zineLandingQuery} from '../../lib/queries'
import {seoDescription, seoImage} from '../../lib/seo'

const preview = isPreviewRequest(Astro.cookies)
const client = getSanityClient(preview)
const zineLanding = await client.fetch(zineLandingQuery)

if (!zineLanding?.currentIssue) {
  Astro.response.status = 404
  return Astro.rewrite('/404')
}

setContentCache(Astro.response, preview)

const introFallbackMedia = [
  zineLanding.currentIssue.heroMedia,
  zineLanding.currentIssue.cardMedia,
].filter((media): media is NonNullable<typeof media> => media !== null)
// Reads happen on the internal ISSUU flipbook page.
const currentIssue = zineLanding.currentIssue
const currentIssueHref =
  currentIssue.issuuUrl && currentIssue.slug
    ? `/zine/issues/${currentIssue.slug}/read`
    : '/zine'
---

<Layout
  title={zineLanding.currentIssue.title ?? 'Zine'}
  description={seoDescription(zineLanding.currentIssue.editorLetter?.body)}
  image={seoImage(zineLanding.currentIssue.heroMedia)}
  canonicalUrl="/zine"
  navRole="dark"
>
  <IssueDetail
    issue={zineLanding.currentIssue}
    pastIssues={zineLanding.pastIssues ?? []}
    landingIntro={{
      heading: zineLanding.intro?.heading,
      imageLayers: zineLanding.intro?.imageLayers,
      fallbackMedia: introFallbackMedia,
      ctaLabel: zineLanding.intro?.ctaLabel,
      ctaHref: currentIssueHref,
    }}
  />
  <ContactBand role="brand-deep" />
  <Footer />
</Layout>
