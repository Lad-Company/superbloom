---
import ContactBand from '../../components/ContactBand.astro'
import Footer from '../../components/Footer.astro'
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import ContentCardList from '../../components/ContentCardList.astro'
import MixedArticleCard from '../../components/MixedArticleCard.astro'
import ProgressiveLoadMore from '../../components/ProgressiveLoadMore.astro'
import SortControl from '../../components/SortControl.astro'
import TypeFilter from '../../components/TypeFilter.astro'
import SurfaceSection from '../../components/SurfaceSection.astro'
import {parseArticleTypeFilter} from '../../lib/articleTypes'
import {indexPageQuery, indexViewAllNewestQuery, indexViewAllOldestQuery} from '../../lib/queries'
import {getSanityClient} from '../../lib/sanity'
import {isPreviewRequest} from '../../lib/preview'
import {setContentCache} from '../../lib/cacheHeaders'
import type {
  IndexPageQueryResult,
  IndexViewAllNewestQueryResult,
  IndexViewAllOldestQueryResult,
} from '../../sanity.types'
import type {PartialContentCardSettings} from '../../lib/contentCard'

const preview = isPreviewRequest(Astro.cookies)
const client = getSanityClient(preview)
setContentCache(Astro.response, preview)

const BATCH_SIZE = 12
const sort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest'
const type = parseArticleTypeFilter(Astro.url.searchParams.get('type'))
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10)
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1
const recordLimit = page * BATCH_SIZE

const indexPage = await client.fetch<IndexPageQueryResult>(indexPageQuery)
const pageHeader = indexPage?.header ?? "What they've been saying"
const featured = indexPage?.featured?.filter((entry) => entry?.item) ?? []
const featuredIds = featured
  .map((entry) => entry.item?._id)
  .filter((id): id is string => Boolean(id))
const viewAllQuery = sort === 'oldest' ? indexViewAllOldestQuery : indexViewAllNewestQuery
const fetchedItems = await client.fetch<
  IndexViewAllNewestQueryResult | IndexViewAllOldestQueryResult
>(viewAllQuery, {
  featuredIds,
  tagId: indexPage?.allSection?.tagId ?? null,
  typeFilter: type,
  offset: 0,
  end: recordLimit + 1,
})
const items = fetchedItems.slice(0, recordLimit)
const hasMore = fetchedItems.length > recordLimit
const listSettings = indexPage?.allSection?.listDefaults as PartialContentCardSettings
const globalSettings = indexPage?.globalCardDefaults as PartialContentCardSettings
const overrideFor = (id: string) =>
  indexPage?.allSection?.itemOverrides?.find(
    (override) => override?.itemId === id,
  ) as PartialContentCardSettings

const queryFor = (nextPage: number, nextSort = sort) => {
  const params = new URLSearchParams()
  if (nextSort === 'oldest') params.set('sort', nextSort)
  if (type) params.set('type', type)
  if (nextPage > 1) params.set('page', String(nextPage))
  const query = params.toString()
  return query ? `/index?${query}` : '/index'
}
---

<Layout title="Index" description={pageHeader} canonicalUrl="/index" navRole="light">
  <SurfaceSection role="light">
    <main>
      <PageHero heading={pageHeader} id="featured-heading" />
      {
        featured.length > 0 && (
          <section class="featured" aria-labelledby="featured-heading">
            <ContentCardList columnPack>
              {featured.map((entry) => {
                const item = entry.item!
                const settings = entry as PartialContentCardSettings
                return (
                  <MixedArticleCard
                    item={item}
                    settings={settings}
                    globalSettings={globalSettings}
                    minimal
                  />
                )
              })}
            </ContentCardList>
          </section>
        )
      }

      <section class="view-all" aria-labelledby="view-all-heading">
        <div class="view-all-header">
          <h2 id="view-all-heading" class="type-h3">View All</h2>
          <div class="view-all-controls" data-active-control="sort">
            <SortControl value={sort} type={type} />
            <TypeFilter value={type} sort={sort} />
          </div>
        </div>
        <div data-browse-results>
          <ContentCardList class="all-card-list">
            {
              items.map((item) => {
                const settings = overrideFor(item._id)
                return (
                  <MixedArticleCard
                    item={item}
                    settings={settings}
                    listSettings={listSettings}
                    globalSettings={globalSettings}
                    minimal
                  />
                )
              })
            }
          </ContentCardList>
          {hasMore && <ProgressiveLoadMore href={queryFor(page + 1)} />}
        </div>
      </section>
    </main>
  </SurfaceSection>
  <ContactBand role="brand-tertiary" />
  <Footer />
</Layout>

<style>
  .featured {
    padding: var(--space-xl) var(--page-inset) var(--space-3xl);
  }

  .view-all {
    padding: var(--space-3xl) var(--page-inset);
    padding-top: var(--space-xl);
  }

  .view-all h2 {
    margin: 0;
  }

  .view-all-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }

  .view-all-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  /* With JS, only one browse control is displayed at a time; clicking its
     label swaps to the other. Without JS both stay visible and functional. */
  :global(html.js) .view-all-controls[data-active-control='sort'] :global(.type-filter),
  :global(html.js) .view-all-controls[data-active-control='filter'] :global(.sort-control) {
    display: none;
  }

  .view-all :global(progressive-load-more) {
    margin: var(--space-xl) 0 0 var(--page-inset);
  }

  @media (--bp-below-desktop) {
    /* Mobile featured hand-off matches the consistent 32px + 32px = 64px gap
       used by Work, Who We Are, and the case-study lead media. */
    .featured {
      padding: var(--space-xs) var(--space-3xs) var(--space-2xl);
    }

    .view-all {
      padding: var(--space-2xl) var(--space-3xs);
    }

    .view-all-header {
      margin-bottom: var(--space-xs);
    }

    .view-all :global(progressive-load-more) {
      margin-left: 0;
    }
  }
</style>
