---
import Layout from '../../../layouts/Layout.astro'
import Footer from '../../../components/Footer.astro'
import TagList from '../../../components/TagList.astro'
import Button from '../../../components/Button.astro'
import SelectDropdown from '../../../components/SelectDropdown.astro'
import {getProduct} from '../../../lib/shopify'

const handle = Astro.params.handle
const product = handle ? await getProduct(handle).catch(() => null) : null
if (!product) return Astro.redirect('/404', 302)
const initialVariant =
  product.variants.find((variant) => variant.availableForSale) ?? product.variants[0]
const formatMoney = (amount: string, currency: string) =>
  new Intl.NumberFormat('en-US', {style: 'currency', currency}).format(Number(amount))
---

<Layout title={`${product.title} | Shop | Superbloom House`} navRole="light">
  <main class="detail" data-product-detail data-variants={JSON.stringify(product.variants)}>
    <div class="image">
      {
        product.featuredImage ? (
          <img
            src={product.featuredImage.url}
            alt={product.featuredImage.altText ?? product.title}
          />
        ) : (
          <div class="placeholder" />
        )
      }
      {
        !product.availableForSale && (
          <div class="availability-badge">
            <TagList typeLabel="Sold out" />
          </div>
        )
      }
    </div>
    <div class="content">
      <p class="type-eyebrow">Shop</p>
      <h1 class="type-h2">{product.title}</h1>
      <p class="price" data-price>
        {formatMoney(initialVariant.price.amount, initialVariant.price.currencyCode)}
      </p>
      <form data-add-form>
        {
          product.options.map((option) => (
            <div class="option-field">
              <span class="option-label">{option.name}</span>
              <SelectDropdown
                name={`option-${option.name}`}
                label={option.name}
                placeholder={option.name}
                options={option.values.map((optionValue) => ({
                  value: optionValue,
                  label: optionValue,
                }))}
                value={
                  initialVariant.selectedOptions.find(
                    (selectedOption) => selectedOption.name === option.name,
                  )?.value
                }
                data-option={option.name}
              />
            </div>
          ))
        }
        <p data-availability aria-live="polite">
          {initialVariant.availableForSale ? 'In stock' : 'Sold out'}
        </p>
        <Button
          as="button"
          type="submit"
          label="Add to cart"
          data-add
          disabled={!initialVariant.availableForSale}
        />
        <p data-feedback aria-live="polite"></p>
      </form>
      <div class="description" set:html={product.descriptionHtml} />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  function initProductDetail() {
    const root = document.querySelector<HTMLElement>('[data-product-detail]')
    if (!root) return
    const variants = JSON.parse(root.dataset.variants ?? '[]')
    const form = root.querySelector<HTMLFormElement>('[data-add-form]')
    const price = root.querySelector<HTMLElement>('[data-price]')
    const availability = root.querySelector<HTMLElement>('[data-availability]')
    const button = root.querySelector<HTMLButtonElement>('[data-add]')
    const feedback = root.querySelector<HTMLElement>('[data-feedback]')
    const money = (value: {amount: string; currencyCode: string}) =>
      new Intl.NumberFormat('en-US', {style: 'currency', currency: value.currencyCode}).format(
        Number(value.amount),
      )
    let selected = variants.find((variant: any) => variant.availableForSale) ?? variants[0]

    function selectVariant() {
      const values = [...(root?.querySelectorAll<HTMLElement>('[data-option]') ?? [])].map(
        (dropdown) => ({
          name: dropdown.dataset.option,
          value:
            dropdown.querySelector<HTMLInputElement>('[data-select-dropdown-input]')?.value ?? '',
        }),
      )
      selected = variants.find((variant: any) =>
        values.every((value) =>
          variant.selectedOptions.some(
            (option: any) => option.name === value.name && option.value === value.value,
          ),
        ),
      )
      if (!selected) return
      if (price) price.textContent = money(selected.price)
      if (availability)
        availability.textContent = selected.availableForSale ? 'In stock' : 'Sold out'
      if (button) button.disabled = !selected.availableForSale
    }

    // SelectDropdown inputs dispatch a bubbling change event on selection.
    root?.addEventListener('change', selectVariant)
    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!selected?.availableForSale) return
      if (button) button.disabled = true
      if (feedback) feedback.textContent = 'Adding to cart…'
      try {
        const response = await fetch('/api/shop/cart/add.json', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({variantId: selected.id, quantity: 1}),
        })
        if (!response.ok) throw new Error()
        if (feedback) feedback.textContent = 'Added to cart.'
        document.dispatchEvent(new CustomEvent('shop:cart-updated'))
      } catch {
        if (feedback) feedback.textContent = 'Could not add item. Please try again.'
      } finally {
        if (button) button.disabled = !selected?.availableForSale
      }
    })
  }

  document.addEventListener('astro:page-load', initProductDetail)
</script>

<style>
  .detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    padding: calc(var(--space-4xl) + var(--space-xl)) var(--page-inset) var(--space-4xl);
  }
  .image {
    position: relative;
  }
  .image img,
  .placeholder {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--fg-12);
    border-radius: var(--radius-media);
  }
  .content {
    max-width: 36rem;
  }
  h1,
  .content > p {
    margin: 0 0 var(--space-2xs);
  }
  .price {
    font-size: 1.5rem;
  }
  form {
    display: grid;
    gap: var(--space-3xs);
    margin: var(--space-xs) 0;
  }
  .option-field {
    display: grid;
    gap: var(--pad-6);
  }
  .description :global(p) {
    margin: 0 0 var(--space-3xs);
  }
  @media (--bp-small) {
    .detail {
      grid-template-columns: 1fr;
      padding-top: calc(var(--space-4xl) + var(--space-xl));
    }
  }
</style>
