---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import PageHero from '../../components/PageHero.astro'
import ProductGrid from '../../components/shop/ProductGrid.astro'
import ShopFeature from '../../components/shop/ShopFeature.astro'
import {listProducts} from '../../lib/shopify'
import {getSanityClient} from '../../lib/sanity'
import {isPreviewRequest} from '../../lib/preview'
import {shopPageQuery} from '../../lib/queries'
import {isShopFeatureComplete} from '../../lib/shopFeature'

const cursor = Astro.url.searchParams.get('after')
let result: Awaited<ReturnType<typeof listProducts>> | null = null
let error = false
try {
  result = await listProducts(cursor)
} catch {
  error = true
}

// Optional CMS feature above the product grid; a CMS outage never takes
// the shop down with it.
async function fetchFeatured() {
  const shopPage = await getSanityClient(isPreviewRequest(Astro.cookies)).fetch(shopPageQuery)
  return shopPage?.featured ?? null
}
const featured = await fetchFeatured().catch(() => null)
---

<Layout title="Shop | Superbloom House" navRole="dark">
  <main>
    {
      /* The published shop page either has a complete Featured Item or none
         (Sanity blocks publishing a partial one), so the feature replaces the
         Shop header outright — the header returns when the section is cleared
         and the doc republished. */
      !isShopFeatureComplete(featured) && <PageHero heading="Shop" />
    }
    <ShopFeature featured={featured} />
    {
      error ? (
        <p class="message">Unable to load products. Please try again.</p>
      ) : (
        result && (
          <ProductGrid
            products={result.products}
            nextCursor={result.pageInfo.endCursor}
            hasNextPage={result.pageInfo.hasNextPage}
          />
        )
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  :global(body) {
    --bg: #000000;
    --fg: #ffffff;
    --fg-12: rgba(255, 255, 255, 0.12);
    --fg-60: rgba(255, 255, 255, 0.6);
    background: #000000;
    color: #ffffff;
  }
  .message {
    padding: var(--space-xl) var(--page-inset);
  }
</style>
