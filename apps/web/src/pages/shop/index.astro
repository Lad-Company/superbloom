---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import PageHero from '../../components/PageHero.astro'
import ProductGrid from '../../components/shop/ProductGrid.astro'
import ShopFeature from '../../components/shop/ShopFeature.astro'
import {listProducts} from '../../lib/shopify'
import {fetchSafe, getSanityClient} from '../../lib/sanity'
import {isPreviewRequest} from '../../lib/preview'
import {shopPageQuery} from '../../lib/queries'

// CMS page settings (heading, grid collection, hover fill, optional feature
// above the grid); a CMS outage never takes the shop down with it — the grid
// just falls back to all products, alphabetical. fetchSafe still reports the
// outage to Sentry so the silent degradation is visible.
const shopPage = await fetchSafe(
  getSanityClient(isPreviewRequest(Astro.cookies)),
  shopPageQuery,
)
const collectionHandle = shopPage?.collectionHandle ?? null

const cursor = Astro.url.searchParams.get('after')
let result: Awaited<ReturnType<typeof listProducts>> | null = null
let error = false
try {
  result = await listProducts(cursor, collectionHandle)
} catch {
  error = true
}
---

<Layout title="Shop | Superbloom House" navRole="dark">
  <main>
    <PageHero heading={shopPage?.heading ?? 'Shop'} />
    <ShopFeature featured={shopPage?.featured ?? null} />
    {
      error ? (
        <p class="message">Unable to load products. Please try again.</p>
      ) : (
        result && (
          <ProductGrid
            products={result.products}
            nextCursor={result.pageInfo.endCursor}
            hasNextPage={result.pageInfo.hasNextPage}
            hoverColor={shopPage?.hoverColor ?? null}
            collectionHandle={collectionHandle}
          />
        )
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  :global(body) {
    --bg: #000000;
    --fg: #ffffff;
    --fg-12: rgba(255, 255, 255, 0.12);
    --fg-60: rgba(255, 255, 255, 0.6);
    background: #000000;
    color: #ffffff;
  }
  .message {
    padding: var(--space-xl) var(--page-inset);
  }
</style>
