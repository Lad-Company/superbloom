---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import PageHero from '../../components/PageHero.astro'
import ProductGrid from '../../components/shop/ProductGrid.astro'
import {listProducts} from '../../lib/shopify'

const cursor = Astro.url.searchParams.get('after')
let result: Awaited<ReturnType<typeof listProducts>> | null = null
let error = false
try {
  result = await listProducts(cursor)
} catch {
  error = true
}
---

<Layout title="Shop | Superbloom House" navRole="dark">
  <main>
    <PageHero heading="Shop" />
    {
      error ? (
        <p class="message">Unable to load products. Please try again.</p>
      ) : (
        result && (
          <ProductGrid
            products={result.products}
            nextCursor={result.pageInfo.endCursor}
            hasNextPage={result.pageInfo.hasNextPage}
          />
        )
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  :global(body) {
    --bg: #000000;
    --fg: #ffffff;
    --fg-12: rgba(255, 255, 255, 0.12);
    --fg-60: rgba(255, 255, 255, 0.6);
    background: #000000;
    color: #ffffff;
  }
  .message {
    padding: var(--space-xl) var(--page-inset);
  }
</style>
