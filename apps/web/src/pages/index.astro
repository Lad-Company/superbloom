---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'
import HomepageComposition from '../components/home/HomepageComposition.astro'
import {getSanityClient} from '../lib/sanity'
import {isPreviewRequest} from '../lib/preview'
import {setContentCache} from '../lib/cacheHeaders'
import {homepageQuery} from '../lib/queries'
import type {HomepageQueryResult} from '../sanity.types'

const preview = isPreviewRequest(Astro.cookies)
const client = getSanityClient(preview)
setContentCache(Astro.response, preview)

const homepage: HomepageQueryResult = await client.fetch(homepageQuery)
---

<Layout navRole="dark">
  {homepage && <HomepageComposition homepage={homepage} />}
  <Footer />
</Layout>
