---
import Layout from '../../layouts/Layout.astro'
import ContactBand from '../../components/ContactBand.astro'
import Footer from '../../components/Footer.astro'
import CaseStudyComposition from '../../components/case/CaseStudyComposition.astro'
import {fetchSafe, getSanityClient} from '../../lib/sanity'
import {isPreviewRequest} from '../../lib/preview'
import {setContentCache} from '../../lib/cacheHeaders'
import {caseBrandVars} from '../../lib/caseBrandVars'
import {caseStudyBySlugQuery} from '../../lib/queries'
import {seoDescription, seoImage} from '../../lib/seo'
import type {CaseStudyBySlugQueryResult} from '../../sanity.types'

const {slug} = Astro.params
const preview = isPreviewRequest(Astro.cookies)
const client = getSanityClient(preview)
const caseStudy = await fetchSafe<CaseStudyBySlugQueryResult>(client, caseStudyBySlugQuery, {slug})

if (caseStudy === undefined) {
  Astro.response.status = 500
  return Astro.rewrite('/500')
}

if (!caseStudy) {
  Astro.response.status = 404
  return Astro.rewrite('/404')
}

setContentCache(Astro.response, preview)
---

<Layout
  title={caseStudy.title ?? 'Case Study'}
  description={seoDescription((caseStudy as {summary?: unknown}).summary)}
  image={seoImage(caseStudy.leadMedia)}
  navRole="case-primary"
  bodyStyle={caseBrandVars(caseStudy)}
>
  <CaseStudyComposition caseStudy={caseStudy} />
  <ContactBand role="brand-deep" />
  <Footer />
</Layout>
