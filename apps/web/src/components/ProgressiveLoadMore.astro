---
import Button from './Button.astro'

interface Props {
  href: string
}

const {href} = Astro.props
---

<progressive-load-more>
  <div class="load-more-wrapper" data-load-more>
    <Button href={href} label="Load more" />
  </div>
</progressive-load-more>

<script>
  class ProgressiveLoadMoreElement extends HTMLElement {
    private loading = false
    private observer?: IntersectionObserver

    connectedCallback() {
      const wrapper = this.querySelector<HTMLElement>('[data-load-more]')
      const link = wrapper?.querySelector<HTMLAnchorElement>('.btn')
      const label = wrapper?.querySelector<HTMLElement>('.btn__label')
      const list = this.previousElementSibling
      if (!wrapper || !link || !list || !('IntersectionObserver' in window)) return

      this.observer = new IntersectionObserver(
        async ([entry]) => {
          if (!entry.isIntersecting || this.loading || !link.href) return
          this.loading = true
          if (label) label.textContent = 'Loading…'

          try {
            const response = await fetch(link.href)
            if (!response.ok) throw new Error('Could not load more cards')
            const nextPage = new DOMParser().parseFromString(await response.text(), 'text/html')
            const knownIds = new Set(
              Array.from(list.querySelectorAll('[data-content-card-id]')).map((card) =>
                card.getAttribute('data-content-card-id'),
              ),
            )
            nextPage.querySelectorAll('.all-card-list > [data-content-card-id]').forEach((card) => {
              if (!knownIds.has(card.getAttribute('data-content-card-id'))) list.append(card)
            })
            const nextWrapper = nextPage.querySelector<HTMLElement>('[data-load-more]')
            const nextLink = nextWrapper?.querySelector<HTMLAnchorElement>('.btn')
            if (nextLink) {
              link.href = nextLink.href
              if (label) label.textContent = 'Load more'
            } else {
              this.observer?.disconnect()
              this.remove()
            }
            history.replaceState(null, '', response.url)
          } catch {
            if (label) label.textContent = 'Retry loading more'
          } finally {
            this.loading = false
          }
        },
        {rootMargin: '400px'},
      )
      this.observer.observe(wrapper)
    }

    disconnectedCallback() {
      this.observer?.disconnect()
    }
  }

  if (!customElements.get('progressive-load-more')) {
    customElements.define('progressive-load-more', ProgressiveLoadMoreElement)
  }
</script>

<style>
  progressive-load-more {
    display: block;
  }
</style>
