---
import type {HTMLAttributes} from 'astro/types'
import '../styles/contentCardRail.css'

type ButtonProps = HTMLAttributes<'button'> & Record<string, unknown>

interface Props {
  label: string
  heading?: string | null
  class?: string
  showNextButton?: boolean
  showControls?: boolean
  scrollJack?: boolean
  buttonProps?: ButtonProps
  previousButtonProps?: ButtonProps
  nextButtonProps?: ButtonProps
}

const {
  label,
  heading,
  class: className,
  showNextButton = true,
  showControls = true,
  scrollJack = true,
  buttonProps = {},
  previousButtonProps = {},
  nextButtonProps = {},
} = Astro.props

const mergedPreviousProps = {
  type: 'button' as const,
  'aria-label': `Previous ${heading ?? label}`,
  'data-motion-control': true,
  ...buttonProps,
  ...previousButtonProps,
  class: ['control', 'previous', 'surface-wipe', buttonProps.class, previousButtonProps.class]
    .filter(Boolean)
    .join(' '),
}

const mergedNextProps = {
  type: 'button' as const,
  'aria-label': `Next ${heading ?? label}`,
  'data-motion-control': true,
  ...buttonProps,
  ...nextButtonProps,
  class: ['control', 'next', 'surface-wipe', buttonProps.class, nextButtonProps.class]
    .filter(Boolean)
    .join(' '),
}
---

<card-carousel
  class:list={['card-carousel', className]}
  aria-label={label}
  data-scroll-jack={scrollJack ? 'true' : 'false'}
>
  {
    (heading || showControls) && (
      <div class="header">
        {heading && <h2 class="heading type-h3">{heading}</h2>}
        {showControls && (
          <div class="controls" aria-label={`${heading ?? label} controls`}>
            <button {...mergedPreviousProps}>
              <span class="control__icon" aria-hidden="true">←</span>
            </button>
            {showNextButton && (
              <button {...mergedNextProps}>
                <span class="control__icon" aria-hidden="true">→</span>
              </button>
            )}
          </div>
        )}
      </div>
    )
  }
  <div class="rail">
    <div class="track" role="region" tabindex="0" aria-label={label}>
      <slot />
    </div>
  </div>
</card-carousel>

<script>
  import { initHorizontalRail, type HorizontalRailHandle } from '../lib/motion'

  class CardCarouselElement extends HTMLElement {
    private railHandle?: HorizontalRailHandle
    private track?: HTMLElement

    connectedCallback() {
      this.track = (this.querySelector('.track') as HTMLElement | null) ?? undefined
      this.dataset.enhanced = 'true'

      const railContainer = (this.querySelector('.rail') as HTMLElement | null) ?? this
      if (this.track && this.dataset.scrollJack !== 'false') {
        this.railHandle = initHorizontalRail(this, railContainer, this.track)
      }

      this.querySelector('.previous')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.scrollCards(-1)
      })
      this.querySelector('.next')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.scrollCards(1)
      })
    }

    disconnectedCallback() {
      this.railHandle?.destroy()
    }

    private scrollCards(direction: 1 | -1) {
      if (this.classList.contains('is-scroll-jacked') && this.railHandle) {
        if (direction === -1) {
          this.railHandle.previous()
        } else {
          this.railHandle.next()
        }
        return
      }

      const amount = (this.track?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 0
      this.track?.scrollBy({ left: direction * amount, behavior: 'smooth' })
    }
  }

  if (!customElements.get('card-carousel')) {
    customElements.define('card-carousel', CardCarouselElement)
  }
</script>

<style>
  .card-carousel {
    display: block;
  }

  .rail {
    position: relative;
    overflow: hidden;
  }

  .header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--page-gutter);
    margin-bottom: var(--space-xs);
  }

  .heading {
    margin: 0;
  }

  .controls {
    display: flex;
    gap: var(--space-3xs);
  }

  card-carousel:not([data-enhanced]) .controls {
    display: none;
  }

  .control {
    width: 40px;
    height: 40px;
    border: 1px solid color-mix(in srgb, var(--fg) 30%, transparent);
    border-radius: var(--radius-control);
    background: transparent;
    color: inherit;
    cursor: pointer;
    --wipe-surface: var(--fg);
    --wipe-ink: var(--bg);
  }

  .control__icon {
    position: relative;
    z-index: 2;
  }

  .control:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .track {
    display: flex;
    gap: var(--page-gutter);
    overflow-x: auto;
    padding-right: var(--space-xs);
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .is-scroll-jacked .track {
    overflow: visible;
    scroll-snap-type: none;
  }

  /* Widths come from styles/contentCardRail.css (shared with the News
     marquee): cardWidth is a literal fraction of the viewport (1/2 = 50vw). */
  .track > :global(.content-card) {
    scroll-snap-align: start;
  }

  @media (--bp-960) {
    .track {
      gap: var(--space-16);
    }
  }

  @media (--bp-600) {
    .header {
      align-items: start;
    }

    .track {
      gap: 12px;
      padding-right: 12px;
    }
  }
</style>
