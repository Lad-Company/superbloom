---
import {type SurfaceRole, vars} from '../lib/surfaceRole'

interface Props {
  role?: SurfaceRole
}

const {role = 'light'} = Astro.props
const links = [
  {label: 'Our Work', href: '/work'},
  {label: 'Who We Are', href: '/who-we-are'},
  {label: 'News & Press', href: '/index'},
  {label: 'Zine', href: '/zine'},
]
---

<nav class="navigation" aria-label="Primary navigation" style={vars[role]}>
  <a href="/" class="logo" data-route-link aria-label="Superbloom House"></a>
  <ul class="desktop-links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="type-eyebrow underline-draw" data-route-link>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="desktop-actions">
    <a
      href="#contact"
      class:list={['btn', 'btn-secondary', 'surface-wipe', 'type-label']}
      data-motion-control
      data-lets-chat><span class="nav__label">Let's Chat</span></a
    >
    <a href="/shop" class="btn btn-tertiary surface-wipe type-label" data-motion-control
      ><span class="nav__label">Shop</span></a
    >
    <a
      href="/cart"
      class="cart-link underline-draw type-label"
      data-cart-link
      hidden
      aria-label="Cart, 0 items">Cart <span data-cart-count>0</span></a
    >
  </div>
  <details class="compact-menu" data-dropdown>
    <summary class="compact-toggle" aria-label="Menu">
      <span class="compact-toggle__icon" aria-hidden="true"></span>
    </summary>
    <div class="compact-panel">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="compact-link" data-route-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="compact-actions">
        <a
          href="#contact"
          class:list={['btn', 'btn-secondary', 'surface-wipe', 'compact-btn-label']}
          data-motion-control
          data-lets-chat><span class="nav__label">Let's Chat</span></a
        >
        <a href="/shop" class="btn btn-tertiary surface-wipe compact-btn-label" data-motion-control
          ><span class="nav__label">Shop</span></a
        >
        <a
          href="/cart"
          class="type-label underline-draw"
          data-cart-link
          hidden
          aria-label="Cart, 0 items">Cart <span data-cart-count>0</span></a
        >
      </div>
    </div>
  </details>
</nav>

<script>
  import { navigate } from 'astro:transitions/client'
  import {initDropdownDismiss} from '../lib/dropdownDismiss'
  import {initShyNav} from '../lib/shyNav'

  // Compact menu shares the site-wide dropdown dismissal (outside pointer,
  // Escape).
  initDropdownDismiss()

  // Desktop shy nav: hides on scroll down, re-appears on any scroll up, and
  // re-colors to the surface beneath it while revealed. Rebound after each
  // view-transition swap.
  initShyNav()
  document.addEventListener('astro:page-load', initShyNav)

  const updateCartLinks = (itemCount: number) => {
    const isActive = itemCount > 0
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((count) => {
      count.textContent = String(itemCount)
    })
    document.querySelectorAll<HTMLAnchorElement>('[data-cart-link]').forEach((link) => {
      link.hidden = !isActive
      link.setAttribute('aria-label', `Cart, ${itemCount} ${itemCount === 1 ? 'item' : 'items'}`)
    })
  }

  const refreshCartCount = async () => {
    try {
      const response = await fetch('/api/shop/cart/get.json')
      if (!response.ok) return
      const cart = await response.json()
      updateCartLinks(cart.itemCount)
    } catch {
      /* ignore cart fetch errors */
    }
  }
  document.addEventListener('astro:page-load', refreshCartCount)
  document.addEventListener('shop:cart-updated', refreshCartCount)

  // Let's Chat scrolls to the contact band. When the band is on the current
  // page the click falls through to the global smooth-scroll anchor handler
  // (native anchor jump under reduced motion). Pages without a contact band
  // (shop, cart) route to Who We Are, which always renders one.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLAnchorElement>('[data-lets-chat]')
    if (!trigger) return
    if (document.getElementById('contact')) return
    event.preventDefault()
    navigate('/who-we-are#contact')
  })
</script>

<style>
  .navigation {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    padding: var(--space-16) var(--page-gutter);
    width: 100%;
    color: var(--fg);
    --fg-12: color-mix(in srgb, var(--fg) 12%, transparent);
    --fg-20: color-mix(in srgb, var(--fg) 20%, transparent);
    --fg-60: color-mix(in srgb, var(--fg) 60%, transparent);
  }
  .logo,
  a {
    text-decoration: none;
  }
  .logo {
    display: inline-block;
    flex-shrink: 0;
    width: 248px;
    aspect-ratio: 697 / 41;
    background-color: currentColor;
    mask-image: url('/superbloom-house-logo.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: left center;
    -webkit-mask-image: url('/superbloom-house-logo.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: left center;
  }
  .desktop-links,
  .desktop-actions {
    display: flex;
    align-items: center;
  }
  .desktop-links {
    justify-content: space-evenly;
    gap: 0;
  }
  .desktop-actions {
    gap: var(--space-3xs);
    flex-shrink: 0;
    justify-self: end;
  }
  .btn {
    padding: var(--space-3xs) var(--space-16);
    border-radius: var(--radius-control);
    backdrop-filter: blur(var(--frosted-layer-blur));
    -webkit-backdrop-filter: blur(var(--frosted-layer-blur));
  }
  .btn-secondary {
    background: var(--fg);
    color: var(--bg);
    --wipe-surface: var(--bg);
    --wipe-ink: var(--fg);
  }
  .btn-tertiary {
    background: var(--fg-12);
    color: var(--fg);
    --wipe-surface: var(--fg);
    --wipe-ink: var(--bg);
  }
  .cart-link {
    text-decoration: none;
  }
  .compact-menu {
    display: none;
  }

  @media (--bp-below-desktop) {
    .navigation {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2xs);
    }
    .desktop-links,
    .desktop-actions {
      display: none;
    }
    .compact-menu {
      display: block;
    }

    /* Toggle button (hamburger, morphs to X when the panel is open). */
    .compact-toggle {
      position: relative;
      z-index: 60;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      cursor: pointer;
      list-style: none;
    }
    .compact-toggle::-webkit-details-marker {
      display: none;
    }
    .compact-toggle__icon,
    .compact-toggle__icon::before,
    .compact-toggle__icon::after {
      content: '';
      display: block;
      width: 28px;
      height: 2px;
      background: currentColor;
      transition: transform var(--motion-quick) var(--motion-ease-out),
        opacity var(--motion-instant) linear;
    }
    .compact-toggle__icon::before {
      position: absolute;
      transform: translateY(-8px);
    }
    .compact-toggle__icon::after {
      position: absolute;
      transform: translateY(8px);
    }
    .compact-menu[open] .compact-toggle__icon {
      background: transparent;
    }
    .compact-menu[open] .compact-toggle__icon::before {
      transform: rotate(45deg);
    }
    .compact-menu[open] .compact-toggle__icon::after {
      transform: rotate(-45deg);
    }

    /* Full-screen overlay panel with a magenta frame. */
    .compact-panel {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      padding: calc(var(--space-2xs) + 40px) var(--space-2xs) var(--space-2xs);
      background: #000;
      color: #fff;
      overflow-y: auto;
    }
    .compact-panel ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      margin-top: var(--space-2xs);
    }
    .compact-link {
      font-family: var(--font-display-tight);
      font-weight: 750;
      /* Mobile menu links ride the shared type-h3 ramp, matching the zine
         landing intro statement (spec §3.4). */
      font-size: var(--type-h3);
      line-height: 0.95;
      letter-spacing: 0;
      text-transform: uppercase;
      color: #fff;
    }
    .compact-actions {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }
    .compact-actions .btn {
      display: block;
      text-align: center;
      padding: var(--space-3xs) var(--space-16);
    }
    .compact-btn-label {
      font-family: var(--font-interface);
      font-weight: 750;
      font-size: 28px;
      line-height: 1;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }
    /* Panel buttons wear fixed colors: the open menu is a constant black
       surface, so they must not consume the nav's --bg/--fg — on desktop the
       shy nav rewrites those vars as it samples sections, which recolored
       the buttons mid-scroll. Let's Chat mirrors the dark-surface control
       (white pill, black ink, wipe inverts); Shop's wipe inverts its pinned
       resting colors. */
    .compact-actions .btn-secondary {
      background: #fff;
      color: #000;
      --wipe-surface: #000;
      --wipe-ink: #fff;
    }
    .compact-actions .btn-tertiary {
      background: #2a2a2a;
      color: #fff;
      --wipe-surface: #fff;
      --wipe-ink: #000;
    }

    /* Flip logo + toggle to white so they read on the black overlay; the
       shy bar's tint/blur would read as a stray strip over the panel. */
    .navigation:has(.compact-menu[open]) {
      color: #fff;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom-color: transparent;
    }
    .navigation:has(.compact-menu[open]) .logo {
      position: relative;
      z-index: 60;
    }
  }

  /* Small phones (below the 390px standard-iPhone baseline) step the menu
     links down one shared ramp to type-h4 so the longest link stays on one
     line; bigger phones keep the type-h3 match with the zine statement. */
  @media (--bp-390) {
    .compact-link {
      font-size: var(--type-h4);
    }
  }

  @media (--bp-small) {
    .navigation {
      padding: var(--space-3xs);
    }
    .logo {
      max-width: 13ch;
    }
  }

  /* The fixed shy bar and the open compact menu must paint above the case
     study spine nav (z-index: 20, sticky at top: 0). The compact panel's own
     z-index: 50 lives inside the nav's stacking context, so only the nav's
     z-index counts against page content — at 10 the spine nav painted over
     the open menu and the revealed bar, and ate clicks meant for the logo. */
  .navigation.is-shy,
  .navigation:has(.compact-menu[open]) {
    z-index: 30;
  }

  /* Shy nav, all breakpoints: past the page top the nav becomes a fixed
     frosted bar — hidden while scrolling down, revealed on any upward
     scroll. On desktop the revealed bar re-colors to the sampled surface
     beneath it (lib/shyNav.ts); on compact breakpoints it keeps the SSR
     role colors. Either way the bar's tint and blur track --bg so it stays
     legible over dark, light, and brand surfaces. */
  .navigation {
    /* The shy slide rides the quick ramp (240ms) — at --motion-standard
       (480ms) the bar read as sluggish to arrive on a flick upward. */
    transition:
      transform var(--motion-quick) var(--motion-ease-out),
      color var(--motion-quick) linear,
      background-color var(--motion-quick) linear;
  }
  .navigation.is-shy {
    position: fixed;
    transform: translateY(-110%);
    /* The hairline below the bar uses the shared border recipe (1px, fg at
       20%). */
    border-bottom: 1px solid var(--fg-20);
  }
  /* The frost (tint + 35px blur) lives on a pseudo-layer, not the nav: a
     backdrop-filter on the sliding bar forces a full blur re-render of the
     content beneath it on every animation frame — off the compositor fast
     path on mobile, and the source of the reveal's dropped frames. While
     the bar slides (is-animating, set in lib/shyNav.ts) the frost fades out
     and the bar wears a near-solid tint, so the slide is a pure composited
     transform; the frost fades back in once the bar lands. */
  .navigation.is-shy::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 10%, transparent);
    backdrop-filter: blur(var(--frosted-layer-blur));
    -webkit-backdrop-filter: blur(var(--frosted-layer-blur));
    transition: opacity var(--motion-quick) linear;
  }
  .navigation.is-shy.is-animating {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }
  .navigation.is-shy.is-animating::before {
    opacity: 0;
  }
  .navigation.is-shy.is-revealed {
    transform: translateY(0);
  }

  /* The open compact menu's panel is position: fixed inside the nav, and any
     non-none transform on the nav — even translateY(0) once the reveal
     transition settles — makes the nav the panel's containing block,
     collapsing the full-screen menu to the bar's box. Drop the transform
     (and the shy backdrop-filter, same effect) while the menu is open; the
     nav is force-revealed in that state (lib/shyNav.ts), so there's no
     visual change. The .is-shy class in the selector is needed to outrank
     .navigation.is-shy.is-revealed above. */
  .navigation.is-shy:has(.compact-menu[open]) {
    transform: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    /* Also drop the slide-time tint and frost: the open menu is a constant
       black surface, and a frosted strip above it reads as a glitch. */
    background: transparent;
  }
  .navigation.is-shy:has(.compact-menu[open])::before {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .compact-toggle__icon,
    .compact-toggle__icon::before,
    .compact-toggle__icon::after {
      transition: none;
    }

    /* Reduced motion keeps the shy show/hide behavior but drops the slide
       and color tweens. */
    .navigation {
      transition: none;
    }
  }
</style>
