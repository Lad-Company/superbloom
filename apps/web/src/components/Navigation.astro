---
import {type SurfaceRole, vars} from '../lib/surfaceRole'

interface Props {
  role?: SurfaceRole
}

const {role = 'light'} = Astro.props
const links = [
  {label: 'Our Work', href: '/work'},
  {label: 'Who We Are', href: '/who-we-are'},
  {label: 'News & Press', href: '/index'},
  {label: 'Zine', href: '/zine'},
]
---

<nav class="navigation" aria-label="Primary navigation" style={vars[role]}>
  <a href="/" class="logo" data-route-link aria-label="Superbloom House"></a>
  <ul class="desktop-links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="type-eyebrow underline-draw" data-route-link>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="desktop-actions">
    <a
      href="#contact"
      class:list={['btn', 'btn-secondary', 'surface-wipe', 'type-label']}
      data-motion-control
      data-lets-chat><span class="nav__label">Let's Chat</span></a
    >
    <a href="/shop" class="btn btn-tertiary surface-wipe type-label" data-motion-control
      ><span class="nav__label">Shop</span></a
    >
    <a
      href="/cart"
      class="cart-link underline-draw type-label"
      data-cart-link
      hidden
      aria-label="Cart, 0 items">Cart <span data-cart-count>0</span></a
    >
  </div>
  <details class="compact-menu" data-dropdown>
    <summary class="type-label">Menu</summary>
    <div class="compact-panel">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="type-label underline-draw" data-route-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="#contact"
        class:list={['btn', 'btn-secondary', 'surface-wipe', 'type-label']}
        data-motion-control
        data-lets-chat><span class="nav__label">Let's Chat</span></a
      >
      <a href="/shop" class="btn btn-tertiary surface-wipe type-label" data-motion-control
        ><span class="nav__label">Shop</span></a
      >
      <a
        href="/cart"
        class="type-label underline-draw"
        data-cart-link
        hidden
        aria-label="Cart, 0 items">Cart <span data-cart-count>0</span></a
      >
    </div>
  </details>
</nav>

<script>
  import {initDropdownDismiss} from '../lib/dropdownDismiss'

  // Compact menu shares the site-wide dropdown dismissal (outside pointer,
  // Escape).
  initDropdownDismiss()

  const updateCartLinks = (itemCount: number) => {
    const isActive = itemCount > 0
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((count) => {
      count.textContent = String(itemCount)
    })
    document.querySelectorAll<HTMLAnchorElement>('[data-cart-link]').forEach((link) => {
      link.hidden = !isActive
      link.setAttribute('aria-label', `Cart, ${itemCount} ${itemCount === 1 ? 'item' : 'items'}`)
    })
  }

  const refreshCartCount = async () => {
    try {
      const response = await fetch('/api/shop/cart/get.json')
      if (!response.ok) return
      const cart = await response.json()
      updateCartLinks(cart.itemCount)
    } catch {
      /* ignore cart fetch errors */
    }
  }
  document.addEventListener('astro:page-load', refreshCartCount)
  document.addEventListener('shop:cart-updated', refreshCartCount)

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLAnchorElement>('[data-lets-chat]')
    if (!trigger) return
    event.preventDefault()
    const target = document.getElementById('contact')
    if (target) {
      target.scrollIntoView({behavior: 'smooth'})
      return
    }
    const form = document.querySelector('form')
    if (form) {
      form.scrollIntoView({behavior: 'smooth'})
      return
    }
    window.location.href = '/'
  })
</script>

<style>
  .navigation {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    padding: 19px var(--page-gutter);
    width: 100%;
    color: var(--fg);
    --fg-12: color-mix(in srgb, var(--fg) 12%, transparent);
    --fg-60: color-mix(in srgb, var(--fg) 60%, transparent);
  }
  .logo,
  a {
    text-decoration: none;
  }
  .logo {
    display: inline-block;
    flex-shrink: 0;
    width: 248px;
    aspect-ratio: 697 / 41;
    background-color: currentColor;
    mask-image: url('/superbloom-house-logo.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: left center;
    -webkit-mask-image: url('/superbloom-house-logo.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: left center;
  }
  .desktop-links,
  .desktop-actions {
    display: flex;
    align-items: center;
  }
  .desktop-links {
    justify-content: space-evenly;
    gap: 0;
  }
  .desktop-actions {
    gap: var(--space-3xs);
    flex-shrink: 0;
    justify-self: end;
  }
  .btn {
    padding: var(--space-3xs) 16px;
    border-radius: var(--radius-control);
    backdrop-filter: blur(var(--frosted-layer-blur));
    -webkit-backdrop-filter: blur(var(--frosted-layer-blur));
  }
  .btn-secondary {
    background: var(--fg);
    color: var(--bg);
    --wipe-surface: var(--bg);
    --wipe-ink: var(--fg);
    --surface-wipe-outline: var(--fg);
  }
  .btn-tertiary {
    background: var(--fg-12);
    color: var(--fg);
    --wipe-surface: var(--fg);
    --wipe-ink: var(--bg);
    --surface-wipe-outline: var(--bg);
  }
  .cart-link {
    text-decoration: none;
  }
  .compact-menu {
    display: none;
  }

  @media (max-width: 1023px) {
    .navigation {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2xs);
    }
    .desktop-links,
    .desktop-actions {
      display: none;
    }
    .compact-menu {
      display: block;
      position: relative;
    }
    .compact-menu summary {
      cursor: pointer;
      list-style: none;
      padding: var(--space-3xs) 16px;
      border: 1px solid currentColor;
      border-radius: var(--radius-control);
    }
    .compact-menu summary::-webkit-details-marker {
      display: none;
    }
    .compact-panel {
      position: absolute;
      top: calc(100% + var(--space-3xs));
      right: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      min-width: 220px;
      padding: var(--space-2xs);
      background: var(--bg);
      color: var(--fg);
      border-radius: var(--radius-control);
    }
    .compact-panel ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
    }
    .compact-panel .btn {
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    .navigation {
      padding: var(--space-3xs);
    }
    .logo {
      max-width: 13ch;
    }
  }
</style>
