---
import {type SurfaceRole, vars} from '../lib/surfaceRole'

interface Props {
  role?: SurfaceRole
}

const {role = 'light'} = Astro.props
const links = [
  {label: 'Our Work', href: '/work'},
  {label: 'Who We Are', href: '/who-we-are'},
  {label: 'News & Press', href: '/index'},
  {label: 'Zine', href: '/zine'},
]
---

<nav class="navigation" aria-label="Primary navigation" style={vars[role]}>
  <a href="/" class="logo" data-route-link aria-label="Superbloom House"></a>
  <ul class="desktop-links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="type-eyebrow underline-draw" data-route-link>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="desktop-actions">
    <a
      href="#contact"
      class:list={['btn', 'btn-secondary', 'surface-wipe', 'type-label']}
      data-motion-control
      data-lets-chat><span class="nav__label">Let's Chat</span></a
    >
    <a href="/shop" class="btn btn-tertiary surface-wipe type-label" data-motion-control
      ><span class="nav__label">Shop</span></a
    >
    <a
      href="/cart"
      class="cart-link underline-draw type-label"
      data-cart-link
      hidden
      aria-label="Cart, 0 items">Cart <span data-cart-count>0</span></a
    >
  </div>
  <details class="compact-menu" data-dropdown>
    <summary class="compact-toggle" aria-label="Menu">
      <span class="compact-toggle__icon" aria-hidden="true"></span>
    </summary>
    <div class="compact-panel">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="compact-link" data-route-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="compact-actions">
        <a
          href="#contact"
          class:list={['btn', 'btn-secondary', 'surface-wipe', 'compact-btn-label']}
          data-motion-control
          data-lets-chat><span class="nav__label">Let's Chat</span></a
        >
        <a href="/shop" class="btn btn-tertiary surface-wipe compact-btn-label" data-motion-control
          ><span class="nav__label">Shop</span></a
        >
        <a
          href="/cart"
          class="type-label underline-draw"
          data-cart-link
          hidden
          aria-label="Cart, 0 items">Cart <span data-cart-count>0</span></a
        >
      </div>
    </div>
  </details>
</nav>

<script>
  import { navigate } from 'astro:transitions/client'
  import {initDropdownDismiss} from '../lib/dropdownDismiss'

  // Compact menu shares the site-wide dropdown dismissal (outside pointer,
  // Escape).
  initDropdownDismiss()

  const updateCartLinks = (itemCount: number) => {
    const isActive = itemCount > 0
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((count) => {
      count.textContent = String(itemCount)
    })
    document.querySelectorAll<HTMLAnchorElement>('[data-cart-link]').forEach((link) => {
      link.hidden = !isActive
      link.setAttribute('aria-label', `Cart, ${itemCount} ${itemCount === 1 ? 'item' : 'items'}`)
    })
  }

  const refreshCartCount = async () => {
    try {
      const response = await fetch('/api/shop/cart/get.json')
      if (!response.ok) return
      const cart = await response.json()
      updateCartLinks(cart.itemCount)
    } catch {
      /* ignore cart fetch errors */
    }
  }
  document.addEventListener('astro:page-load', refreshCartCount)
  document.addEventListener('shop:cart-updated', refreshCartCount)

  // Let's Chat scrolls to the contact band. When the band is on the current
  // page the click falls through to the global smooth-scroll anchor handler
  // (native anchor jump under reduced motion). Pages without a contact band
  // (shop, cart) route to Who We Are, which always renders one.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLAnchorElement>('[data-lets-chat]')
    if (!trigger) return
    if (document.getElementById('contact')) return
    event.preventDefault()
    navigate('/who-we-are#contact')
  })
</script>

<style>
  .navigation {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    padding: var(--space-16) var(--page-gutter);
    width: 100%;
    color: var(--fg);
    --fg-12: color-mix(in srgb, var(--fg) 12%, transparent);
    --fg-60: color-mix(in srgb, var(--fg) 60%, transparent);
  }
  .logo,
  a {
    text-decoration: none;
  }
  .logo {
    display: inline-block;
    flex-shrink: 0;
    width: 248px;
    aspect-ratio: 697 / 41;
    background-color: currentColor;
    mask-image: url('/superbloom-house-logo.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: left center;
    -webkit-mask-image: url('/superbloom-house-logo.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: left center;
  }
  .desktop-links,
  .desktop-actions {
    display: flex;
    align-items: center;
  }
  .desktop-links {
    justify-content: space-evenly;
    gap: 0;
  }
  .desktop-actions {
    gap: var(--space-3xs);
    flex-shrink: 0;
    justify-self: end;
  }
  .btn {
    padding: var(--space-3xs) var(--space-16);
    border-radius: var(--radius-control);
    backdrop-filter: blur(var(--frosted-layer-blur));
    -webkit-backdrop-filter: blur(var(--frosted-layer-blur));
  }
  .btn-secondary {
    background: var(--fg);
    color: var(--bg);
    --wipe-surface: var(--bg);
    --wipe-ink: var(--fg);
    --surface-wipe-outline: var(--fg);
  }
  .btn-tertiary {
    background: var(--fg-12);
    color: var(--fg);
    --wipe-surface: var(--fg);
    --wipe-ink: var(--bg);
    --surface-wipe-outline: var(--bg);
  }
  .cart-link {
    text-decoration: none;
  }
  .compact-menu {
    display: none;
  }

  @media (max-width: 1023px) {
    .navigation {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2xs);
    }
    .desktop-links,
    .desktop-actions {
      display: none;
    }
    .compact-menu {
      display: block;
    }

    /* Toggle button (hamburger, morphs to X when the panel is open). */
    .compact-toggle {
      position: relative;
      z-index: 60;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      cursor: pointer;
      list-style: none;
    }
    .compact-toggle::-webkit-details-marker {
      display: none;
    }
    .compact-toggle__icon,
    .compact-toggle__icon::before,
    .compact-toggle__icon::after {
      content: '';
      display: block;
      width: 28px;
      height: 2px;
      background: currentColor;
      transition: transform var(--motion-quick) var(--motion-ease-out),
        opacity var(--motion-instant) linear;
    }
    .compact-toggle__icon::before {
      position: absolute;
      transform: translateY(-8px);
    }
    .compact-toggle__icon::after {
      position: absolute;
      transform: translateY(8px);
    }
    .compact-menu[open] .compact-toggle__icon {
      background: transparent;
    }
    .compact-menu[open] .compact-toggle__icon::before {
      transform: rotate(45deg);
    }
    .compact-menu[open] .compact-toggle__icon::after {
      transform: rotate(-45deg);
    }

    /* Full-screen overlay panel with a magenta frame. */
    .compact-panel {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      padding: calc(var(--space-2xs) + 40px) var(--space-2xs) var(--space-2xs);
      background: #000;
      color: #fff;
      overflow-y: auto;
    }
    .compact-panel ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      margin-top: var(--space-2xs);
    }
    .compact-link {
      font-family: var(--font-display-tight);
      font-weight: 750;
      /* Mobile menu links ride the shared type-section-heading ramp (spec
         §3.4: folded from a bespoke 64 cap to the canonical 56 step). */
      font-size: var(--type-section-heading);
      line-height: 0.95;
      letter-spacing: 0;
      text-transform: uppercase;
      color: #fff;
    }
    .compact-actions {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }
    .compact-actions .btn {
      display: block;
      text-align: center;
      padding: var(--space-3xs) var(--space-16);
    }
    .compact-btn-label {
      font-family: var(--font-interface);
      font-weight: 750;
      font-size: 28px;
      line-height: 1;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }
    .compact-actions .btn-tertiary {
      background: #2a2a2a;
      color: #fff;
    }

    /* Flip logo + toggle to white so they read on the black overlay. */
    .navigation:has(.compact-menu[open]) {
      color: #fff;
    }
    .navigation:has(.compact-menu[open]) .logo {
      position: relative;
      z-index: 60;
    }
  }

  @media (max-width: 767px) {
    .navigation {
      padding: var(--space-3xs);
    }
    .logo {
      max-width: 13ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compact-toggle__icon,
    .compact-toggle__icon::before,
    .compact-toggle__icon::after {
      transition: none;
    }
  }
</style>
