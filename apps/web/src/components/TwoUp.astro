---
import MediaFrame, {type Media} from './MediaFrame.astro'
import Button from './Button.astro'

interface Cta {
  _key?: string
  heading: string | null
  label?: string | null
  href?: string | null
  media?: Media | null
}

interface Props {
  items: Cta[]
}

const {items} = Astro.props
---

<div class="two-up">
  {
    items.map((item) => (
      <div class="col">
        <MediaFrame
          media={item.media}
          ratio="1:1"
          placement={{context: 'split', collapseAt: 'small'}}
          title={item.heading ?? undefined}
        />
        {item.heading && <p class="heading type-h5">{item.heading}</p>}
        {item.label && <Button href={item.href ?? '#'} label={item.label} />}
      </div>
    ))
  }
</div>

<style>
  .two-up {
    display: flex;
    gap: var(--page-gutter);
    /* No bottom padding: the next section (Faq, or ContactBand when no
       faqs) carries its own 4xl top padding, so a bottom pad here would
       double the gap to 400px. */
    padding: var(--space-4xl) var(--space-xs) 0;
    align-items: flex-start;
  }
  .col {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .col :global(.btn) {
    align-self: flex-start;
  }
  .heading {
    margin: 0;
  }
  @media (--bp-small) {
    .two-up {
      flex-direction: column;
      /* The desktop row pins children to flex-start; stacked, that
         shrink-wraps each column to its content width and pins it left.
         Stretch makes columns (and their media) full width. */
      align-items: stretch;
      /* Bottom padding stays 0 on mobile too; Faq's 2xl top padding is the
         single spacer. */
      padding: var(--space-2xl) var(--space-3xs) 0;
    }
  }
</style>
