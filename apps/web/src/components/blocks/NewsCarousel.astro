---
import Marquee from '../Marquee.astro'
import ArticleCard from '../ArticleCard.astro'
import SurfaceSection from '../SurfaceSection.astro'
import '../../styles/contentCardRail.css'
import type {HomepageQueryResult} from '../../sanity.types'
import type {ContentCardSettingsInput, PartialContentCardSettings} from '../../lib/contentCard'

type NewsBlock = NonNullable<NonNullable<HomepageQueryResult>['news']>

interface Props {
  headline?: string | null
  items: NewsBlock['items']
  role: 'light'
  listDefaults?: PartialContentCardSettings
  itemOverrides?: Array<{articleId?: string | null} & ContentCardSettingsInput> | null
  globalSettings?: PartialContentCardSettings
  showHeadline?: boolean
}

const {
  headline,
  items: itemsInput,
  role,
  listDefaults: listSettings,
  itemOverrides,
  globalSettings,
  showHeadline = false,
} = Astro.props
const items = itemsInput ?? []
const overrides = new Map(itemOverrides?.map((override) => [override.articleId, override]))
// The marquee loops by translating -50%, so each half must stay wider than the
// viewport. Repeat the authored set enough times per half for short lists.
const copiesPerHalf = items.length > 0 ? Math.ceil(8 / items.length) : 1
const halfItems = Array.from({length: copiesPerHalf}, () => items).flat()
---

{
  items.length > 0 && (
    <SurfaceSection role={role} class="news">
      <div class="inner">
        {showHeadline && <h2 class="headline type-h3">{headline ?? 'News'}</h2>}
        <Marquee>
          {halfItems.map((item) => (
            <ArticleCard
              item={item}
              settings={overrides.get(item._id)}
              listSettings={listSettings}
              globalSettings={globalSettings}
            />
          ))}
        </Marquee>
      </div>
    </SurfaceSection>
  )
}

<style>
  .news {
    /* Stack above the home parallax section so its bleeding pointer layers
       float underneath this section. */
    position: relative;
    z-index: 1;
  }

  .inner {
    padding: var(--space-4xl) var(--page-inset) var(--space-2xl);
  }
  .headline {
    margin: 0 0 var(--space-xs);
  }

  /* Full-bleed: the marquee flows to the viewport edges, outside the gutter. */
  .inner :global(.marquee-track--items) {
    margin-inline: calc(-1 * var(--page-inset));
  }

  /* Card widths live in styles/contentCardRail.css (shared with CardCarousel):
     cardWidth is a literal fraction of the viewport (1/2 = 50vw, full = 100vw). */

  @media (--bp-small) {
    .inner {
      /* Follows the 100svh media hero, so the top owns the full 64px
         hand-off; bottom 32 pairs with the next section's 32. */
      padding-block: var(--space-m) var(--space-xs);
    }
  }

  @media (--bp-600) {
    .inner {
      padding-inline: 12px;
    }

    .inner :global(.marquee-track--items) {
      margin-inline: -12px;
    }
  }
</style>
