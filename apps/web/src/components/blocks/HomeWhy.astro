---
import SurfaceSection from '../SurfaceSection.astro'
import MediaFrame from '../MediaFrame.astro'
import Button from '../Button.astro'
import type {Media} from '../MediaFrame.astro'

interface Props {
  headline: string
  body?: string | null
  ctaLabel?: string | null
  ctaHref?: string | null
  media?: Media | null
}

const {headline, body, ctaLabel, ctaHref, media} = Astro.props
---

<SurfaceSection role="light">
  <div class="why">
    <div class="text">
      <h2 class="type-h2" data-motion-text data-unit="words" data-scroll="true">{headline}</h2>
      {body && <p class="body type-body">{body}</p>}
      {ctaLabel && ctaHref && <Button href={ctaHref} label={ctaLabel} />}
    </div>
    {
      media && (
        <div class="visual">
          <MediaFrame {media} ratio="4:5" placement={{context: 'split'}} title={headline} />
        </div>
      )
    }
  </div>
</SurfaceSection>

<style>
  .why {
    display: grid;
    /* True 50/50: text and media blocks each take half the width. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--page-gutter);
    padding: var(--space-4xl) var(--page-inset);
    align-items: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: start;
  }
  h2 {
    margin: 0;
  }
  .body {
    margin: 0;
    max-width: 34ch;
  }
  .visual {
    padding-top: var(--space-xs);
  }
  @media (--bp-below-desktop) {
    .why {
      grid-template-columns: 1fr;
      padding: var(--space-3xl) var(--space-2xs);
    }
  }
  @media (--bp-small) {
    .why {
      padding: var(--space-xs) var(--space-3xs);
    }
  }
</style>
