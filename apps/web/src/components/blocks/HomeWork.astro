---
import SurfaceSection from '../SurfaceSection.astro'
import MediaFrame, {type Media, type MediaRatio} from '../MediaFrame.astro'
import TagList from '../TagList.astro'
import Button from '../Button.astro'
import type {MediaAspectRatio} from '../../lib/contentCard'
import {
  WORK_MOSAIC_PRESETS,
  resolveMosaic,
  type WorkMosaicPresetName,
} from '../../lib/workMosaic'

interface WorkItem {
  _id: string | null
  title: string | null
  slug: string | null
  summary: string | null
  tags: Array<{title: string | null; color: string | null}> | null
  media: Media | null
}

interface Props {
  headline?: string | null
  ctaLabel?: string | null
  /** Desktop mosaic arrangement, selected in the CMS. Unknown values fall back
     to the default preset; see lib/workMosaic for the preset contract. */
  preset?: string | null
  items: Array<{
    item: WorkItem
    mediaAspectRatio?: MediaAspectRatio | null
  }>
}

const {headline = 'Our Work', ctaLabel = 'View all', preset, items} = Astro.props

const asPreset = (value: string | null | undefined) =>
  value && value in WORK_MOSAIC_PRESETS
    ? WORK_MOSAIC_PRESETS[value as WorkMosaicPresetName]
    : null

// Resolution order: dev-only ?workPreset= override (for VQA), then the
// CMS-selected preset, then the default.
const activePreset =
  (import.meta.env.DEV ? asPreset(Astro.url.searchParams.get('workPreset')) : null) ??
  asPreset(preset) ??
  WORK_MOSAIC_PRESETS['stagger-right']

// Interlocking 4-slot mosaic. Each preset slot owns its column span, default
// ratio, and caption anchor; row spans and caption lanes are derived from the
// grid geometry so media edges interlock and captions never touch media.
const displayedItems = items.slice(0, activePreset.slots.length)
const resolvedSlots = resolveMosaic(
  activePreset,
  (index) => displayedItems[index]?.mediaAspectRatio,
)

// Mirror of workMosaic's CAPTION_BAND_ROWS: caption text lives in the rows
// immediately below the slot's media, so adjacent media inside that band
// must keep text off themselves with gutter padding. The band fits the
// worst-case caption (8px pad + 2×28.8px headline + 8px gap + 2×22.1px
// summary = 117.8px) at the 1024px desktop floor, where 12cqw = 122.9px.
const CAPTION_BAND_ROWS = 12

// The caption's anchored side (left for caption-left, right for
// caption-right) needs gutter padding when it sits at the page edge or
// shares its column line with another slot — either in the same row, or in
// the caption band below. Otherwise the text terminus aligns flush with the
// slot's media edge and the clear lane absorbs the inner gap to anything
// further down the band.
const anchoredAtEdge = (index: number): boolean => {
  const slot = activePreset.slots[index]
  const my = resolvedSlots[index]
  if (!my) return false
  const isLeft = slot.captionAnchor === 'left'
  const anchoredCol = isLeft ? slot.column - 1 : slot.column - 1 + slot.span
  if (isLeft ? anchoredCol === 0 : anchoredCol === 12) return true

  const myEnd = my.rowStart + my.rowSpan

  return activePreset.slots.some((other, otherIndex) => {
    if (otherIndex === index) return false
    const otherLeft = other.column - 1
    const otherRight = otherLeft + other.span
    const colMatches = isLeft ? otherRight === anchoredCol : otherLeft === anchoredCol
    if (!colMatches) return false
    const oth = resolvedSlots[otherIndex]
    if (!oth) return false
    const othEnd = oth.rowStart + oth.rowSpan

    if (my.rowStart < othEnd && oth.rowStart < myEnd) return true

    const bandStart = myEnd
    const bandEnd = bandStart + CAPTION_BAND_ROWS
    return oth.rowStart < bandEnd && othEnd > bandStart
  })
}
---

<SurfaceSection role="light">
  <div class="work">
    <div class="header">
      <h2 class="type-h2" data-motion-text data-unit="words" data-scroll="true">
        {headline}
      </h2>
      <Button href="/work" label={ctaLabel ?? 'View all'} />
    </div>
    {
      displayedItems.length > 0 && (
        <div class="mosaic">
          {displayedItems.map((entry, index) => {
            const slot = resolvedSlots[index]
            const {item} = entry
            const href = item.slug ? `/work/${item.slug}` : '#'
            const paddedAnchor = anchoredAtEdge(index)
            const captionClassList = [
              'caption',
              paddedAnchor && (slot.captionAnchor === 'left'
                ? 'caption-edge-left'
                : 'caption-edge-right'),
            ].filter(Boolean)
            return (
              <a
                class:list={['mosaic-item', `caption-${slot.captionAnchor}`]}
                href={href}
                style={`--gc: ${slot.gridColumn}; --cap-max: ${slot.captionMaxCqw}cqw; grid-row: ${slot.rowStart} / span ${slot.rowSpan};`}
              >
                <MediaFrame
                  media={item.media}
                  ratio={slot.ratio as MediaRatio}
                  sizes={`(max-width: 1023.98px) 100vw, ${slot.widthVw}vw`}
                  title={item.title}
                >
                  <TagList slot="overlay" tags={item.tags} />
                </MediaFrame>
                <div class:list={captionClassList}>
                  {item.title && <p class="headline type-h6 line-clamp-2">{item.title}</p>}
                  {item.summary && <p class="summary type-caption line-clamp-2">{item.summary}</p>}
                </div>
              </a>
            )
          })}
        </div>
      )
    }
  </div>
</SurfaceSection>

<script>
  import {initPosterReveal} from '../../lib/posterReveal'

  // The mosaic renders MediaFrame inside its own links (not EditorialCard),
  // so it binds the same Card Poster Reveal wiring itself; posterReveal
  // dedupes per card when both run on one page.
  document.addEventListener('astro:page-load', () => initPosterReveal())
</script>

<style>
  .work {
    padding: var(--space-4xl) var(--page-inset);
  }
  .header {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--page-gutter);
    margin-bottom: var(--space-2xl);
  }
  h2 {
    margin: 0;
  }

  .mosaic {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 1cqw;
    column-gap: 0;
    row-gap: 0;
  }

  .mosaic-item {
    grid-column: var(--gc);
    position: relative;
    display: block;
    color: var(--fg);
    text-decoration: none;
  }

  /* Desktop: the section drops the page gutters so the mosaic media bleeds to
     the viewport edges; the header keeps the page inset and captions keep
     their gutter padding. The cell (derived from the media's aspect ratio)
     defines the shape; the image fills it so neighbouring edges touch exactly.
     On mobile the media keeps its own aspect ratio and stacks. */
  @media (--bp-desktop) {
    .work {
      padding-inline: 0;
    }
    .header {
      padding-inline: var(--page-inset);
    }
    .mosaic-item :global(.media-frame) {
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .caption {
    position: absolute;
    top: 100%;
    left: 0;
    max-width: var(--cap-max);
    padding-top: var(--space-xs-4);
    /* Default: caption text aligns flush with the media's anchored edge.
       The clear lane math (max-width) absorbs the gap to any neighbouring
       media on the inner side, so the inner edge needs no gutter padding
       when the anchored side is free of page and media boundaries. */
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-4);
  }

  /* Right-anchored captions flip the box to right:0 and right-align the
     text so the text terminus sits flush with the media's right edge.
     Inert on mobile, where captions go static. */
  .mosaic-item.caption-right .caption {
    left: auto;
    right: 0;
    text-align: right;
  }

  /* When the anchored side sits at the page edge or shares its column
     line with another slot (same row, or in the caption band below),
     retain gutter padding on that side so the text terminus doesn't
     touch the page or the neighbouring media. */
  .caption-edge-left {
    padding-left: var(--page-gutter);
  }
  .caption-edge-right {
    padding-right: var(--page-gutter);
  }

  .headline,
  .summary {
    margin: 0;
  }

  .headline {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .summary {
    color: var(--fg-60);
  }

  .mosaic-item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (--bp-below-desktop) {
    .work {
      padding: var(--space-3xl) var(--space-2xs);
    }
    .mosaic {
      container-type: normal;
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      row-gap: var(--space-xl);
    }
    .mosaic-item {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }
    .caption {
      position: static;
      max-width: none;
      padding-top: var(--space-2xs);
      padding-right: 0;
      padding-left: 0;
    }
  }
  @media (--bp-small) {
    .work {
      padding: var(--space-xs) var(--space-3xs);
    }
  }
</style>
