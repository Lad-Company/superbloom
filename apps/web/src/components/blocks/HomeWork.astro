---
import SurfaceSection from '../SurfaceSection.astro'
import MediaFrame, {type Media, type MediaRatio} from '../MediaFrame.astro'
import TagList from '../TagList.astro'
import Button from '../Button.astro'
import type {MediaAspectRatio} from '../../lib/contentCard'
import {
  WORK_MOSAIC_PRESETS,
  resolveMosaic,
  type WorkMosaicPresetName,
} from '../../lib/workMosaic'

interface WorkItem {
  _id: string | null
  title: string | null
  slug: string | null
  summary: string | null
  tags: Array<{title: string | null; color: string | null}> | null
  media: Media | null
}

interface Props {
  headline?: string | null
  ctaLabel?: string | null
  /** Desktop mosaic arrangement; see lib/workMosaic for the preset contract. */
  preset?: WorkMosaicPresetName
  items: Array<{
    item: WorkItem
    mediaAspectRatio?: MediaAspectRatio | null
  }>
}

const {headline = 'Our Work', ctaLabel = 'View all', preset = 'stagger-right', items} = Astro.props

// Dev-only override so the three presets can be VQA'd via
// /?workPreset=stagger-left or /?workPreset=split-stagger.
const requestedPreset = import.meta.env.DEV ? Astro.url.searchParams.get('workPreset') : null
const activePreset =
  requestedPreset && requestedPreset in WORK_MOSAIC_PRESETS
    ? WORK_MOSAIC_PRESETS[requestedPreset as WorkMosaicPresetName]
    : WORK_MOSAIC_PRESETS[preset]

// Interlocking 4-slot mosaic. Each preset slot owns its column span, default
// ratio, and caption anchor; row spans and caption lanes are derived from the
// grid geometry so media edges interlock and captions never touch media.
const displayedItems = items.slice(0, activePreset.slots.length)
const resolvedSlots = resolveMosaic(
  activePreset,
  (index) => displayedItems[index]?.mediaAspectRatio,
)
---

<SurfaceSection role="light">
  <div class="work">
    <div class="header">
      <h2 class="type-h2" data-motion-text data-unit="words" data-scroll="true">
        {headline}
      </h2>
      <Button href="/work" label={ctaLabel ?? 'View all'} />
    </div>
    {
      displayedItems.length > 0 && (
        <div class="mosaic">
          {displayedItems.map((entry, index) => {
            const slot = resolvedSlots[index]
            const {item} = entry
            const href = item.slug ? `/work/${item.slug}` : '#'
            return (
              <a
                class:list={['mosaic-item', `caption-${slot.captionAnchor}`]}
                href={href}
                style={`--gc: ${slot.gridColumn}; --cap-max: ${slot.captionMaxCqw}cqw; grid-row: ${slot.rowStart} / span ${slot.rowSpan};`}
              >
                <MediaFrame
                  media={item.media}
                  ratio={slot.ratio as MediaRatio}
                  sizes={`(max-width: 1023px) 100vw, ${slot.widthVw}vw`}
                  title={item.title}
                >
                  <TagList slot="overlay" tags={item.tags} />
                </MediaFrame>
                <div class="caption">
                  {item.title && <p class="headline type-h6 line-clamp-2">{item.title}</p>}
                  {item.summary && <p class="summary type-caption line-clamp-1">{item.summary}</p>}
                </div>
              </a>
            )
          })}
        </div>
      )
    }
  </div>
</SurfaceSection>

<style>
  .work {
    padding: var(--space-4xl) var(--page-inset);
  }
  .header {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--page-gutter);
    margin-bottom: var(--space-2xl);
  }
  h2 {
    margin: 0;
  }

  .mosaic {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 1cqw;
    column-gap: 0;
    row-gap: 0;
  }

  .mosaic-item {
    grid-column: var(--gc);
    position: relative;
    display: block;
    color: var(--fg);
    text-decoration: none;
  }

  /* Desktop: the section drops the page gutters so the mosaic media bleeds to
     the viewport edges; the header keeps the page inset and captions keep
     their gutter padding. The cell (derived from the media's aspect ratio)
     defines the shape; the image fills it so neighbouring edges touch exactly.
     On mobile the media keeps its own aspect ratio and stacks. */
  @media (min-width: 1024px) {
    .work {
      padding-inline: 0;
    }
    .header {
      padding-inline: var(--page-inset);
    }
    .mosaic-item :global(.media-frame) {
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .caption {
    position: absolute;
    top: 100%;
    left: 0;
    max-width: var(--cap-max);
    padding-top: var(--space-xs-4);
    padding-right: var(--page-gutter);
    padding-left: var(--page-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-4);
  }

  /* Presets may anchor a caption to the slot's right edge when the clear lane
     sits on that side; the gutter padding still keeps text off the screen
     edge and neighbouring media. Inert on mobile, where captions go static. */
  .mosaic-item.caption-right .caption {
    left: auto;
    right: 0;
  }

  .headline,
  .summary {
    margin: 0;
  }

  .headline {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .summary {
    color: var(--fg-60);
  }

  .mosaic-item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 1023px) {
    .work {
      padding: var(--space-3xl) var(--space-2xs);
    }
    .mosaic {
      container-type: normal;
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      row-gap: var(--space-xl);
    }
    .mosaic-item {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }
    .caption {
      position: static;
      max-width: none;
      padding-top: var(--space-2xs);
      padding-right: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 767px) {
    .work {
      padding: var(--space-2xl) var(--space-3xs);
    }
  }
</style>
