---
import SurfaceSection from '../SurfaceSection.astro'
import MediaFrame, {type Media, type MediaRatio} from '../MediaFrame.astro'
import TagList from '../TagList.astro'
import Button from '../Button.astro'
import type {MediaAspectRatio} from '../../lib/contentCard'

interface WorkItem {
  _id: string | null
  title: string | null
  slug: string | null
  summary: string | null
  tags: Array<{title: string | null; color: string | null}> | null
  media: Media | null
}

interface Props {
  headline?: string | null
  ctaLabel?: string | null
  items: Array<{
    item: WorkItem
    mediaAspectRatio?: MediaAspectRatio | null
  }>
}

const {headline = 'Our Work', ctaLabel = 'View all', items} = Astro.props

// Fixed 4-slot interlocking mosaic. Each slot owns its column span, its
// default orientation, and how wide its floating caption may grow before it
// would collide with a neighbouring image.
const SLOTS = [
  {column: '1 / span 8', span: 8, ratio: '16:9', captionMax: '16cqw'},
  {column: '9 / span 4', span: 4, ratio: '4:5', captionMax: '33cqw'},
  {column: '3 / span 6', span: 6, ratio: '1:1', captionMax: '33cqw'},
  {column: '7 / span 6', span: 6, ratio: '16:9', captionMax: '50cqw'},
] as const

// Height / width for each supported aspect ratio, used to derive a card's row
// span on the proportional (1cqw) row grid so image edges interlock exactly.
const RATIO_HW: Record<string, number> = {
  '2:1': 1 / 2,
  '16:9': 9 / 16,
  '3:2': 2 / 3,
  '1:1': 1,
  '4:5': 5 / 4,
  '9:16': 16 / 9,
}

const displayedItems = items.slice(0, SLOTS.length).map((entry, index) => {
  const slot = SLOTS[index]
  const ratio = entry.mediaAspectRatio && RATIO_HW[entry.mediaAspectRatio] ? entry.mediaAspectRatio : slot.ratio
  const rowSpan = Math.max(1, Math.round((slot.span / 12) * 100 * RATIO_HW[ratio]))
  return {entry, slot, ratio, rowSpan}
})

// Vertical placement: slots 1 & 2 share the top edge; slot 3 butts against the
// bottom of slot 1; slot 4 butts against the bottom of slot 3.
const rowStartFor = (index: number): number => {
  switch (index) {
    case 0:
    case 1:
      return 1
    case 2:
      return 1 + (displayedItems[0]?.rowSpan ?? 0)
    default:
      return 1 + (displayedItems[0]?.rowSpan ?? 0) + (displayedItems[2]?.rowSpan ?? 0)
  }
}
---

<SurfaceSection role="light">
  <div class="work">
    <div class="header">
      <h2 class="type-h2" data-motion-text data-unit="words" data-scroll="true">
        {headline}
      </h2>
      <Button href="/work" label={ctaLabel ?? 'View all'} />
    </div>
    {
      displayedItems.length > 0 && (
        <div class="mosaic">
          {displayedItems.map(({entry, slot, ratio, rowSpan}, index) => {
            const {item} = entry
            const href = item.slug ? `/work/${item.slug}` : '#'
            return (
              <a
                class="mosaic-item"
                href={href}
                style={`--gc: ${slot.column}; --cap-max: ${slot.captionMax}; grid-row: ${rowStartFor(index)} / span ${rowSpan};`}
              >
                <MediaFrame media={item.media} ratio={ratio as MediaRatio} title={item.title}>
                  <TagList slot="overlay" tags={item.tags} />
                </MediaFrame>
                <div class="caption">
                  {item.title && <p class="headline type-h6 line-clamp-2">{item.title}</p>}
                  {item.summary && <p class="summary type-caption line-clamp-1">{item.summary}</p>}
                </div>
              </a>
            )
          })}
        </div>
      )
    }
  </div>
</SurfaceSection>

<style>
  .work {
    padding: var(--space-4xl) var(--page-inset);
  }
  .header {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--page-gutter);
    margin-bottom: var(--space-2xl);
  }
  h2 {
    margin: 0;
  }

  .mosaic {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 1cqw;
    column-gap: 0;
    row-gap: 0;
  }

  .mosaic-item {
    grid-column: var(--gc);
    position: relative;
    display: block;
    color: var(--fg);
    text-decoration: none;
  }

  /* On desktop the cell (derived from the media's aspect ratio) defines the
     shape; the image fills it so neighbouring edges touch exactly. On mobile
     the media keeps its own aspect ratio and stacks. */
  @media (min-width: 1024px) {
    .mosaic-item :global(.media-frame) {
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .caption {
    position: absolute;
    top: 100%;
    left: 0;
    max-width: var(--cap-max);
    padding-top: var(--space-xs-4);
    padding-right: var(--page-gutter);
    padding-left: var(--page-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-4);
  }

  .headline,
  .summary {
    margin: 0;
  }

  .headline {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .summary {
    color: var(--fg-60);
  }

  .mosaic-item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 1023px) {
    .work {
      padding: var(--space-3xl) var(--space-2xs);
    }
    .mosaic {
      container-type: normal;
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      row-gap: var(--space-xl);
    }
    .mosaic-item {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }
    .caption {
      position: static;
      max-width: none;
      padding-top: var(--space-2xs);
      padding-right: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 767px) {
    .work {
      padding: var(--space-2xl) var(--space-3xs);
    }
  }
</style>
