---
import Button from '../Button.astro'
import MediaFrame, {type Media} from '../MediaFrame.astro'
import PortableText from '../PortableText.astro'
import SurfaceSection from '../SurfaceSection.astro'
import type {TypedObject} from 'astro-portabletext/types'

type PortableBlock = TypedObject & {children?: Array<{text?: string | null}>}

interface Props {
  issue?: {slug?: string | null} | null
  currentIssueSlug?: string | null
  promoHeadline?: string | null
  promoIntro?: PortableBlock[] | null
  promoMedia?: Media | null
  ctaLabel?: string | null
}

const {issue, currentIssueSlug, promoHeadline, promoIntro, promoMedia, ctaLabel} = Astro.props
const href = issue?.slug
  ? issue.slug === currentIssueSlug
    ? '/zine'
    : `/zine/issues/${issue.slug}`
  : '/zine'
---

<SurfaceSection role="brand-tertiary" aria-labelledby="home-zine-heading">
  <div class="home-zine">
    <MediaFrame media={promoMedia} ratio="4:5" title={promoHeadline} class="media" />
    <div class="content">
      <h2 id="home-zine-heading" class="type-h3">{promoHeadline}</h2>
      {promoIntro && <PortableText value={promoIntro} class="type-caption" />}
      <Button href={href} label={ctaLabel ?? 'Explore the Zine'} />
    </div>
  </div>
</SurfaceSection>

<style>
  .home-zine {
    display: grid;
    grid-template-columns: minmax(0, 540px) minmax(0, 1fr);
    gap: var(--page-gutter);
    align-items: start;
    padding: var(--space-3xl) var(--page-inset);
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-xs);
    padding-inline: var(--space-xs);
  }

  h2 {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .home-zine {
      grid-template-columns: 1fr;
      padding: var(--space-2xl) var(--page-inset);
    }

    .content {
      padding-inline: 0;
    }

    h2 {
      font-size: 48px;
    }
  }
</style>
