---
import MixedArticleCard from '../MixedArticleCard.astro'
import type {IndexPageQueryResult} from '../../sanity.types'
import type {ContentCardSettingsInput, PartialContentCardSettings} from '../../lib/contentCard'

type FeaturedEntry = NonNullable<NonNullable<IndexPageQueryResult>['featured']>[number]
type FeaturedItem = NonNullable<FeaturedEntry['item']>

interface Props {
  items: FeaturedItem[]
  globalSettings?: PartialContentCardSettings
}

const {items, globalSettings} = Astro.props
const [lead, ...side] = items

// Layout is locked by design (openai.com/news/company-announcements
// reference): featured cards author no card settings in the CMS. The lead
// story owns the 3/4 column at 16:9; side cards lock to 1:1 with info
// pinned below.
const LEAD_SETTINGS = {
  cardWidth: '3/4',
  mediaAspectRatio: '16:9',
  infoPosition: 'below',
} satisfies ContentCardSettingsInput
const SIDE_SETTINGS = {
  cardWidth: '1/4',
  mediaAspectRatio: '1:1',
  infoPosition: 'below',
} satisfies ContentCardSettingsInput
---

{
  lead && (
    <div class="index-featured">
      <div class="grid">
        <div class="lead">
          <div class="stick">
            {/* The lead card owns the /index LCP — load its media eager. */}
            <MixedArticleCard
              item={lead}
              settings={LEAD_SETTINGS}
              globalSettings={globalSettings}
              priority
              minimal
            />
          </div>
        </div>
        {side.length > 0 && (
          <div class="rail-slot">
            <div class="rail">
              {side.slice(0, 3).map((item) => (
                <MixedArticleCard
                  item={item}
                  settings={SIDE_SETTINGS}
                  globalSettings={globalSettings}
                  minimal
                />
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )
}

<style>
  .index-featured {
    display: block;
  }

  /* Stacked (below desktop) the lead and rail cards read as one list, so
     every step is the shared stacked-item gap. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--stack-gap);
  }

  .lead,
  .rail-slot {
    min-width: 0;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--stack-gap);
  }

  /* Scroll-jacked side rail with no JS (GH #187): the rail sits in normal
     flow, so when it overhangs the lead it owns the row height and reserves
     the pin distance by itself; the lead card sticks to the viewport top
     while the rail scrolls past. The rail cannot be scrolled independently
     and pointer position is irrelevant — it just reads the native scroll
     position. The jack ends when the last side card's bottom meets the lead
     card's bottom; scrolling up reverses it until the first side card locks
     back to the lead's top edge. Because CSS reserves the height, SSR and
     hydrated geometry are identical — the old JS version wrote
     el.style.height = grid + railOverhang only after hydration, growing the
     section and shifting everything below it. */
  @media (--bp-desktop) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--page-gutter);
      /* The taller column owns the row height; the lead's grid area
         stretches so the sticky card has room to travel. */
      align-items: stretch;
    }

    .lead {
      grid-column: span 3;
    }

    .stick {
      position: sticky;
      top: 0;
    }

    .rail-slot {
      grid-column: span 1;
    }

    .rail {
      gap: var(--space-xs);
    }
  }
</style>
