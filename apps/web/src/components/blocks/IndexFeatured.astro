---
import MixedArticleCard from '../MixedArticleCard.astro'
import type {IndexPageQueryResult} from '../../sanity.types'
import type {ContentCardSettingsInput, PartialContentCardSettings} from '../../lib/contentCard'

type FeaturedEntry = NonNullable<NonNullable<IndexPageQueryResult>['featured']>[number]
type FeaturedItem = NonNullable<FeaturedEntry['item']>

interface Props {
  items: FeaturedItem[]
  globalSettings?: PartialContentCardSettings
}

const {items, globalSettings} = Astro.props
const [lead, ...side] = items

// Layout is locked by design (openai.com/news/company-announcements
// reference): featured cards author no card settings in the CMS. The lead
// story owns the 3/4 column at 16:9; side cards lock to 1:1 with info
// pinned below.
const LEAD_SETTINGS = {
  cardWidth: '3/4',
  mediaAspectRatio: '16:9',
  infoPosition: 'below',
} satisfies ContentCardSettingsInput
const SIDE_SETTINGS = {
  cardWidth: '1/4',
  mediaAspectRatio: '1:1',
  infoPosition: 'below',
} satisfies ContentCardSettingsInput
---

{
  lead && (
    <index-featured class="index-featured" data-lenis-prevent>
      <div class="lead">
        <MixedArticleCard
          item={lead}
          settings={LEAD_SETTINGS}
          globalSettings={globalSettings}
          minimal
        />
      </div>
      {side.length > 0 && (
        <div class="rail-slot">
          <div class="rail" role="region" tabindex="0" aria-label="More featured stories">
            {side.slice(0, 3).map((item) => (
              <MixedArticleCard
                item={item}
                settings={SIDE_SETTINGS}
                globalSettings={globalSettings}
                minimal
              />
            ))}
          </div>
        </div>
      )}
    </index-featured>
  )
}

<script>
  // Scroll-jacked side rail: while the featured grid is under the pointer,
  // wheel input translates the rail instead of scrolling the page; once the
  // rail is exhausted in that direction the page scroll resumes. The rail
  // moves by transform rather than native overflow, so it renders no
  // scrollbar of its own and never clips its cards (overflow stays visible).
  // `data-lenis-prevent` keeps Lenis from double-handling these wheel events.
  class IndexFeaturedElement extends HTMLElement {
    private rail: HTMLElement | null = null
    private railSlot: HTMLElement | null = null
    private offset = 0
    private maxOffset = 0
    private observer?: ResizeObserver
    private desktop = window.matchMedia('(min-width: 1024px)')

    connectedCallback() {
      this.railSlot = this.querySelector(':scope > .rail-slot')
      this.rail = this.railSlot?.querySelector(':scope > .rail') ?? null
      if (!this.rail || !this.railSlot) return
      this.observer = new ResizeObserver(() => this.measure())
      this.observer.observe(this.railSlot)
      this.observer.observe(this.rail)
      this.addEventListener('wheel', this.handleWheel, {passive: false})
      this.rail.addEventListener('keydown', this.handleKeydown)
      this.desktop.addEventListener('change', this.handleBreakpoint)
      this.measure()
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.removeEventListener('wheel', this.handleWheel)
      this.rail?.removeEventListener('keydown', this.handleKeydown)
      this.desktop.removeEventListener('change', this.handleBreakpoint)
    }

    private handleBreakpoint = () => {
      if (!this.desktop.matches) this.setOffset(0)
      this.measure()
    }

    private measure() {
      if (!this.rail || !this.railSlot) return
      this.maxOffset = this.desktop.matches
        ? Math.max(0, this.rail.scrollHeight - this.railSlot.clientHeight)
        : 0
      this.setOffset(this.offset)
    }

    private setOffset(next: number) {
      this.offset = Math.min(Math.max(next, 0), this.maxOffset)
      this.rail?.style.setProperty('transform', `translateY(${-this.offset}px)`)
    }

    /** True when the rail cannot move further in the scroll direction and
     *  the gesture should fall through to the page. */
    private exhausted(delta: number) {
      if (delta > 0) return this.offset >= this.maxOffset
      if (delta < 0) return this.offset <= 0
      return true
    }

    private handleWheel = (event: WheelEvent) => {
      if (!this.desktop.matches || this.maxOffset <= 0) return
      if (event.ctrlKey || event.deltaY === 0) return
      // deltaMode 1 = lines (Firefox); normalize to pixels.
      const delta = event.deltaY * (event.deltaMode === 1 ? 16 : 1)
      if (this.exhausted(delta)) return
      event.preventDefault()
      this.setOffset(this.offset + delta)
    }

    private handleKeydown = (event: KeyboardEvent) => {
      if (!this.desktop.matches || this.maxOffset <= 0) return
      const step = 40
      const page = this.railSlot?.clientHeight ?? 0
      let next: number
      switch (event.key) {
        case 'ArrowDown':
          next = this.offset + step
          break
        case 'ArrowUp':
          next = this.offset - step
          break
        case 'PageDown':
          next = this.offset + page
          break
        case 'PageUp':
          next = this.offset - page
          break
        case 'Home':
          next = 0
          break
        case 'End':
          next = this.maxOffset
          break
        default:
          return
      }
      if (this.exhausted(next - this.offset)) return
      event.preventDefault()
      this.setOffset(next)
    }
  }

  if (!customElements.get('index-featured')) {
    customElements.define('index-featured', IndexFeaturedElement)
  }
</script>

<style>
  .index-featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .lead,
  .rail-slot {
    min-width: 0;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  @media (--bp-desktop) {
    .index-featured {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--page-gutter);
      /* The lead card alone owns the row height; the rail is pinned to it. */
      align-items: stretch;
    }

    .lead {
      grid-column: span 3;
    }

    .rail-slot {
      grid-column: span 1;
      position: relative;
    }

    /* Scroll-jacked rail: absolutely pinned to the lead card's height, but
       never clipped (overflow stays visible — extra cards bleed past the
       lead's bottom edge) and never scrollbar'd (movement is transform-
       driven from the hijacked page scroll). */
    .rail {
      position: absolute;
      inset: 0;
      gap: var(--space-xs);
      overflow: visible;
      scrollbar-width: none;
      will-change: transform;
    }

    .rail:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }
  }
</style>
