---
import MixedArticleCard from '../MixedArticleCard.astro'
import type {IndexPageQueryResult} from '../../sanity.types'
import type {ContentCardSettingsInput, PartialContentCardSettings} from '../../lib/contentCard'

type FeaturedEntry = NonNullable<NonNullable<IndexPageQueryResult>['featured']>[number]
type FeaturedItem = NonNullable<FeaturedEntry['item']>

interface Props {
  items: FeaturedItem[]
  globalSettings?: PartialContentCardSettings
}

const {items, globalSettings} = Astro.props
const [lead, ...side] = items

// Layout is locked by design (openai.com/news/company-announcements
// reference): featured cards author no card settings in the CMS. The lead
// story owns the 3/4 column at 4:5; side cards lock to 1:1 with info
// pinned below.
const LEAD_SETTINGS = {
  cardWidth: '3/4',
  mediaAspectRatio: '4:5',
  infoPosition: 'below',
} satisfies ContentCardSettingsInput
const SIDE_SETTINGS = {
  cardWidth: '1/4',
  mediaAspectRatio: '1:1',
  infoPosition: 'below',
} satisfies ContentCardSettingsInput
---

{
  lead && (
    <div class="index-featured">
      <div class="lead">
        <MixedArticleCard
          item={lead}
          settings={LEAD_SETTINGS}
          globalSettings={globalSettings}
          minimal
        />
      </div>
      {side.length > 0 && (
        <div class="rail-slot">
          <div class="rail" tabindex="0" aria-label="More featured stories">
            {side.slice(0, 3).map((item) => (
              <MixedArticleCard
                item={item}
                settings={SIDE_SETTINGS}
                globalSettings={globalSettings}
                minimal
              />
            ))}
          </div>
        </div>
      )}
    </div>
  )
}

<style>
  .index-featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .lead,
  .rail-slot {
    min-width: 0;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  @media (--bp-desktop) {
    .index-featured {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--page-gutter);
      /* The lead card alone owns the row height; the rail is pinned to it. */
      align-items: stretch;
    }

    .lead {
      grid-column: span 3;
    }

    .rail-slot {
      grid-column: span 1;
      position: relative;
    }

    /* Scroll-jacked rail: absolutely pinned to the lead card's height, so a
       third side card overflows into the rail's own scroll instead of
       growing the row. Wheel/trackpad over the rail scrolls the rail, not
       the page. */
    .rail {
      position: absolute;
      inset: 0;
      gap: var(--space-xs);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }

    .rail:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }
  }
</style>
