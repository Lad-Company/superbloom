---
import {type Media} from '../MediaFrame.astro'
import PointerFollowMedia from '../PointerFollowMedia.astro'
import SurfaceSection from '../SurfaceSection.astro'

interface Props {
  headline?: string | null
  images?: (Media | null)[] | null
}

const {headline, images} = Astro.props
const layers = (images ?? []).filter((entry): entry is Media => Boolean(entry?.asset)).slice(0, 4)
---

<SurfaceSection role="light" class="home-parallax" data-pointer-scope>
  <PointerFollowMedia media={layers} />
  {headline && (
    <div class="content">
      <h2>{headline}</h2>
    </div>
  )}
</SurfaceSection>

<style>
  .home-parallax {
    position: relative;
    display: flex;
    /* Statement pins to the top of the section (matching the Zine landing
       intro sibling); the min-height below belongs to the pointer layers. */
    align-items: flex-start;
    min-height: clamp(460px, 56vw, 760px);
    /* No bottom padding: the section hands off flush to the Capes section. */
    padding: clamp(var(--space-3xl), 12vw, var(--space-4xl)) var(--page-inset) 0;
    /* Let the pointer layers bleed past the top/bottom edges so they slide
       underneath the neighboring sections (which paint above with their own
       backgrounds); clip only horizontally so no scrollbar appears. */
    overflow-x: clip;
    overflow-y: visible;
    isolation: isolate;
  }

  /* Match the zine landing intro: the pointer layers float underneath the
     section's content rather than covering it. */
  .home-parallax :global(.pointer-follow) {
    z-index: 0;
  }

  .content {
    position: relative;
    z-index: 1;
    width: 100%;
    pointer-events: none;
  }

  h2 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display-tight);
    /* Statement rides the shared type-h3 ramp — same size as its sibling
       Zine statement (spec §3.4). */
    font-size: var(--type-h3);
    font-weight: 750;
    line-height: 0.9;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  @media (--bp-small) {
    .home-parallax {
      min-height: 420px;
      padding: var(--space-xs) var(--space-3xs) 0;
    }

    h2 {
      max-width: none;
    }
  }
</style>
