---
import {type Media} from '../MediaFrame.astro'
import ParallaxStatement from '../ParallaxStatement.astro'

/* Thin wrapper around the shared ParallaxStatement section (see D2). */
interface Props {
  headline?: string | null
  images?: (Media | null)[] | null
  showImageLayers?: boolean | null
  /* CMS black/white toggle for the section surface. Unset (existing
     documents) defaults to light, preserving the pre-toggle appearance. */
  theme?: 'light' | 'dark' | null
}

const {headline, images, showImageLayers, theme} = Astro.props
---

<ParallaxStatement
  role={theme ?? 'light'}
  headline={headline}
  media={images}
  showLayers={showImageLayers}
/>
