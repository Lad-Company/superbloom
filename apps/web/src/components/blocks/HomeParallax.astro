---
import {type Media} from '../MediaFrame.astro'
import ParallaxStatement from '../ParallaxStatement.astro'

/* Thin wrapper around the shared ParallaxStatement section (see D2). */
interface Props {
  headline?: string | null
  images?: (Media | null)[] | null
  showImageLayers?: boolean | null
}

const {headline, images, showImageLayers} = Astro.props
---

<ParallaxStatement role="light" headline={headline} media={images} showLayers={showImageLayers} />
