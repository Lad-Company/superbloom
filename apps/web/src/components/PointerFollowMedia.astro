---
import MediaFrame, {type Media} from './MediaFrame.astro'

interface Props {
  media: (Media | null)[]
  title?: string
  class?: string
}

const {media, title = '', class: className} = Astro.props
const items = media.filter((entry): entry is Media => Boolean(entry?.asset)).slice(0, 4)
// Each tracer image is up to ~30vw wide; on mobile the tracer is hidden and
// the parent section paints full-bleed, so hint 100vw below the lg breakpoint.
const sizes = '(max-width: 767.98px) 100vw, 50vw'
---

{
  items.length > 0 && (
    <div class:list={['pointer-follow', className]} data-pointer-follow>
      {items.map((entry) => (
        <div class="follow-item" data-follow-item>
          <MediaFrame media={entry} ratio="fill" sizes={sizes} title={title} />
        </div>
      ))}
    </div>
  )
}

<script>
  import {MOTION, POINTER_TRAIL, REDUCED_MOTION_QUERY} from '../lib/motion'

  // Pointer-follow image tracer: as the cursor travels through a
  // data-pointer-scope section, images pop up along its path — one per
  // POINTER_TRAIL.spawnDistance px of travel — hold briefly, and cut out.
  // Spawning is distance-driven, never time-driven; planted images never
  // move. See docs/pointer-follow-tracer-spec.md.

  const mm = window.matchMedia(REDUCED_MOTION_QUERY)
  // Mirrors the CSS gates below: the tracer stays inert on coarse pointers
  // and below --bp-small, where sections paint text-only.
  const coarsePointer = window.matchMedia('(pointer: coarse)')
  const smallScreen = window.matchMedia('(max-width: 767.98px)')

  interface Slot {
    el: HTMLElement
    timer: ReturnType<typeof setTimeout> | null
  }

  interface Group {
    scope: HTMLElement
    root: HTMLElement
    slots: Slot[]
    nextIndex: number
    zCounter: number
    hasLastSpawn: boolean
    lastSpawnX: number
    lastSpawnY: number
  }

  const groups: Group[] = []
  let visibilityObserver: IntersectionObserver | null = null

  const inert = () => mm.matches || coarsePointer.matches || smallScreen.matches

  const clearSlot = (slot: Slot) => {
    if (slot.timer !== null) clearTimeout(slot.timer)
    slot.timer = null
    // Back to the resting state (opacity 0, enter scale, no transition), so
    // a later recycle snaps here invisibly in a single frame.
    delete slot.el.dataset.state
  }

  const clearGroup = (group: Group) => {
    group.slots.forEach(clearSlot)
    group.hasLastSpawn = false
  }

  const spawn = (group: Group, x: number, y: number) => {
    // Slot i is bound to pool image i, so the sequential cycle simply walks
    // the slots. When every slot is alive, the next slot in cycle is the
    // oldest living one, and this recycles it: its exit is cut short and the
    // enter restarts at the new position. Effective concurrency is therefore
    // min(POINTER_TRAIL.maxAlive, pool size).
    const slot = group.slots[group.nextIndex]
    group.nextIndex = (group.nextIndex + 1) % group.slots.length

    if (slot.timer !== null) clearTimeout(slot.timer)
    delete slot.el.dataset.state

    // Planted centered on the cursor position at spawn time; static
    // thereafter. left/top are never transitioned, so the plant itself
    // does not animate. Newest spawn stacks on top within the tracer layer.
    slot.el.style.left = `${x}px`
    slot.el.style.top = `${y}px`
    slot.el.style.zIndex = String(++group.zCounter)

    // Force a style flush so the enter transition restarts from the enter
    // scale even when recycling a slot that was mid-lifecycle.
    void slot.el.offsetWidth

    slot.el.dataset.state = 'living'

    // Fixed lifecycle — enter (MOTION.quick) → hold (POINTER_TRAIL.hold) →
    // exit (POINTER_TRAIL.exitDuration) → free. Never extended by continued
    // movement.
    slot.timer = setTimeout(() => {
      slot.el.dataset.state = 'exiting'
      slot.timer = setTimeout(() => clearSlot(slot), POINTER_TRAIL.exitDuration * 1000)
    }, (MOTION.quick + POINTER_TRAIL.hold) * 1000)
  }

  const onPointerMove = (event: PointerEvent) => {
    if (inert()) return
    for (const group of groups) {
      // The section rect is read fresh on every move — never cached across
      // scroll — so spawning tracks the section's actual on-screen bounds.
      const rect = group.scope.getBoundingClientRect()
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom
      if (!inside) {
        // Leaving the section resets the spawn point, so re-entry always
        // requires a fresh spawnDistance of travel before the first spawn.
        group.hasLastSpawn = false
        continue
      }
      if (!group.hasLastSpawn) {
        group.lastSpawnX = event.clientX
        group.lastSpawnY = event.clientY
        group.hasLastSpawn = true
        continue
      }
      const distance = Math.hypot(event.clientX - group.lastSpawnX, event.clientY - group.lastSpawnY)
      if (distance >= POINTER_TRAIL.spawnDistance) {
        group.lastSpawnX = event.clientX
        group.lastSpawnY = event.clientY
        spawn(group, event.clientX - rect.left, event.clientY - rect.top)
      }
    }
  }

  const clearSpawnPoints = () => {
    // Living images simply finish their lifecycle and clear; only the
    // distance baseline resets.
    for (const group of groups) group.hasLastSpawn = false
  }

  const initPointerTrail = () => {
    document.querySelectorAll<HTMLElement>('[data-pointer-follow]').forEach((group) => {
      if (group.dataset.pointerFollowInitialized) return
      const items = Array.from(group.querySelectorAll<HTMLElement>('[data-follow-item]'))
      if (!items.length) return
      group.dataset.pointerFollowInitialized = 'true'

      const scope = group.closest<HTMLElement>('[data-pointer-scope]') ?? group
      // Publish the configured scale stops so the CSS transitions below and
      // the JS motion config can't drift apart.
      group.style.setProperty('--trail-enter-scale', String(POINTER_TRAIL.enterScale))
      group.style.setProperty('--trail-exit-scale', String(POINTER_TRAIL.exitScale))
      group.style.setProperty('--trail-exit-duration', `${POINTER_TRAIL.exitDuration * 1000}ms`)

      groups.push({
        scope,
        root: group,
        slots: items.slice(0, POINTER_TRAIL.maxAlive).map((el) => ({el, timer: null})),
        nextIndex: 0,
        zCounter: 0,
        hasLastSpawn: false,
        lastSpawnX: 0,
        lastSpawnY: 0,
      })
    })

    // Offscreen sections run no timers: living images are cleared as the
    // section leaves the viewport, and the bounds check in onPointerMove
    // already prevents spawns while it is outside.
    visibilityObserver?.disconnect()
    visibilityObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) continue
          const group = groups.find((g) => g.root === entry.target)
          if (group) clearGroup(group)
        }
      },
      {threshold: 0},
    )
    for (const group of groups) visibilityObserver.observe(group.root)
  }

  const teardown = () => {
    visibilityObserver?.disconnect()
    visibilityObserver = null
    groups.forEach(clearGroup)
    groups.splice(0)
    document.querySelectorAll<HTMLElement>('[data-pointer-follow]').forEach((group) => {
      delete group.dataset.pointerFollowInitialized
    })
  }

  window.addEventListener('pointermove', onPointerMove, {passive: true})
  window.addEventListener('blur', clearSpawnPoints)
  document.addEventListener('pointerleave', clearSpawnPoints)
  mm.addEventListener('change', () => {
    if (mm.matches) groups.forEach(clearGroup)
  })

  // Deferred by Layout until after the hero reveal (same boot contract as
  // the retired cluster); torn down before each View Transition swap.
  document.addEventListener('sbh:motion-deferred', initPointerTrail)
  document.addEventListener('astro:before-swap', teardown)
</script>

<style>
  .pointer-follow {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .follow-item {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(180px, 22vw, 320px);
    aspect-ratio: 4 / 5;
    will-change: transform, opacity;
    opacity: 0;
    transform: translate(-50%, -50%) scale(var(--trail-enter-scale, 0.5));
    /* No transition at rest: a recycled slot snaps back here invisibly in
       one frame before its enter transition restarts. */
    transition: none;
  }

  .follow-item:nth-child(2) {
    width: min(29vw, 420px);
    aspect-ratio: 1.1;
  }

  .follow-item:nth-child(3) {
    width: min(20vw, 290px);
    aspect-ratio: 0.85;
  }

  .follow-item:nth-child(4) {
    width: min(17vw, 250px);
    aspect-ratio: 0.75;
  }

  .follow-item :global(.media-frame) {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-media);
  }

  /* Enter: opacity pops in a single frame (deliberately not transitioned
     here) while scale settles over --motion-quick — the same speed as a
     Surface Wipe / Underline Draw hover. */
  .follow-item[data-state='living'] {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition: transform var(--motion-quick) var(--motion-ease-out);
  }

  /* Exit: a quick cut — 80ms, faster than a press state — with a token
     shrink, so it reads as a pop-out rather than a hard removal or a slow
     fade. */
  .follow-item[data-state='exiting'] {
    opacity: 0;
    transform: translate(-50%, -50%) scale(var(--trail-exit-scale, 0.92));
    transition:
      transform var(--trail-exit-duration, 80ms) var(--motion-ease-out),
      opacity var(--trail-exit-duration, 80ms) var(--motion-ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .follow-item {
      will-change: auto;
      transition: none;
    }
  }

  /* Mobile and coarse pointers hide the tracer at the component level so
     every pointer-follow section (home, zine landing, who-we-are) paints
     full-bleed text only. */
  @media (--bp-small) {
    .pointer-follow {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .pointer-follow {
      display: none;
    }
  }
</style>
