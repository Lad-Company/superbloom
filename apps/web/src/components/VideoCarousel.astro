---
import MediaFrame, {type Media} from './MediaFrame.astro'
import PortableText from './PortableText.astro'
import type {TypedObject} from 'astro-portabletext/types'

export type CarouselLayout = 'full' | 'textRight' | 'textLeft'

interface Props {
  videos?: Array<Media | null> | null
  /** Accessible name for the carousel region; defaults to "Video carousel". */
  label?: string | null
  /** Display variant: 'full' bleeds edge-to-edge with the controls centered
   *  below; 'textRight'/'textLeft' give the carousel 3/4 of the row with a
   *  descriptive 1/4 text box beside it and the controls at the carousel's
   *  bottom inner corner. Documents saved before the layout field existed
   *  render as 'full'. */
  layout?: CarouselLayout | null
  /** Descriptive text box content for the split layouts. */
  text?: TypedObject[] | null
}

const {videos, label, text} = Astro.props
const layout: CarouselLayout =
  Astro.props.layout === 'textRight' || Astro.props.layout === 'textLeft'
    ? Astro.props.layout
    : 'full'

// Defensive: schema validation already requires video assets, but stale or
// in-flight content could still hold an image — the carousel only plays video.
const playable = (videos ?? []).filter(
  (video): video is Media =>
    video?.asset?._type === 'mux.video' && Boolean(video.asset.playbackId),
)

/** Mux stores aspect_ratio as "W:H" ("16:9", "640:360", ...). The ratio sizes
 *  each slide so the video keeps its intrinsic shape while a height cap
 *  narrows tall videos instead of letting them stand taller than a 16:9
 *  slide. */
const intrinsicRatio = (video: Media): number => {
  const value = video.asset?._type === 'mux.video' ? video.asset.aspectRatio : null
  const match = value?.match(/^(\d+):(\d+)$/)
  if (!match) return 16 / 9
  const w = Number(match[1])
  const h = Number(match[2])
  return w > 0 && h > 0 ? w / h : 16 / 9
}

// Split layouts anchor the active slide to the track edge beside the text and
// trail upcoming videos past the opposite page gutter — the sequence flows
// away from the text. textRight reverses the track so the first video sits at
// the right edge with the rest flowing left; textLeft keeps authored order.
const ordered = layout === 'textRight' ? [...playable].reverse() : playable
const ratios = ordered.map(intrinsicRatio)
const ariaLabel = label?.trim() ? `${label} video carousel` : 'Video carousel'
const multiple = playable.length > 1
// The full-width layout opens on the second video so the active slide is
// flanked by neighbours on both sides; split layouts open on the first video,
// anchored to the edge beside the text (the schema requires ≥ three videos).
const initialIndex =
  layout === 'full' ? (playable.length > 1 ? 1 : 0) : layout === 'textRight' ? ordered.length - 1 : 0
// Slide numbering follows the authored video order, not the DOM order (the
// textRight track renders reversed).
const slideNumber = (index: number) =>
  layout === 'textRight' ? ordered.length - index : index + 1
---

{
  playable.length > 0 && (
    <video-carousel
      class="video-carousel"
      data-layout={layout}
      aria-label={ariaLabel}
      style={`--ratio-first: ${ratios[0]}; --ratio-last: ${ratios[ratios.length - 1]};`}
    >
      {layout === 'textLeft' && (
        <div class="aside">
          <PortableText value={text ?? []} />
        </div>
      )}
      <div class="stage">
        <div class="track" role="region" tabindex="0" aria-label={ariaLabel}>
          {ordered.map((video, index) => (
            <div
              class="slide"
              data-slide
              data-active={index === initialIndex ? '' : undefined}
              role="group"
              aria-roledescription="slide"
              aria-label={`${slideNumber(index)} of ${ordered.length}`}
              style={`--ratio: ${ratios[index]};`}
            >
              <MediaFrame
                media={video}
                ratio="intrinsic"
                controls="full"
                active={index === initialIndex}
                priority={index === initialIndex}
                title={video.altText}
              />
            </div>
          ))}
        </div>
        {multiple && (
          <div class="controls" aria-label={`${ariaLabel} controls`}>
            <button
              type="button"
              class="control previous surface-wipe"
              data-motion-control
              aria-label="Previous video"
            >
              <span class="control__icon" aria-hidden="true">←</span>
            </button>
            <button
              type="button"
              class="control next surface-wipe"
              data-motion-control
              aria-label="Next video"
            >
              <span class="control__icon" aria-hidden="true">→</span>
            </button>
          </div>
        )}
      </div>
      {layout === 'textRight' && (
        <div class="aside">
          <PortableText value={text ?? []} />
        </div>
      )}
    </video-carousel>
  )
}

<script>
  class VideoCarouselElement extends HTMLElement {
    private track: HTMLElement | null = null
    private slides: HTMLElement[] = []
    private prev: HTMLButtonElement | null = null
    private next: HTMLButtonElement | null = null
    private slideHandlers: Array<{slide: HTMLElement; handler: () => void}> = []
    private layout: string = 'full'
    private activeIndex = 0
    private scrollFrame = 0
    private targetIndex: number | null = null
    private targetTimer: ReturnType<typeof setTimeout> | null = null
    // Matches --bp-below-desktop: split layouts stack there and behave like
    // the full-width layout (centered slides, second-video start).
    private belowDesktop = window.matchMedia('(max-width: 1023.98px)')

    /** Split layouts anchor the active slide to the track edge beside the
     *  text on desktop; everywhere else slides center. */
    private get anchored() {
      return this.layout !== 'full' && !this.belowDesktop.matches
    }

    /** Logical navigation direction in DOM order: the textRight track renders
     *  reversed, so the next video is the previous DOM sibling. */
    private get navDir() {
      return this.layout === 'textRight' ? -1 : 1
    }

    private handleScroll = () => {
      if (this.scrollFrame) return
      this.scrollFrame = requestAnimationFrame(() => {
        this.scrollFrame = 0
        this.syncActiveFromScroll()
      })
    }

    private handleKeydown = (event: KeyboardEvent) => {
      // Arrow keys belong to the Media Frame scrubber when focus is inside a
      // video's controls; the carousel only steers from the region itself.
      if ((event.target as HTMLElement | null)?.closest('media-frame')) return
      if (event.key === 'ArrowLeft') {
        event.preventDefault()
        this.goTo(this.activeIndex - this.navDir)
      } else if (event.key === 'ArrowRight') {
        event.preventDefault()
        this.goTo(this.activeIndex + this.navDir)
      }
    }

    private handlePrevClick = () => this.goTo(this.activeIndex - this.navDir)
    private handleNextClick = () => this.goTo(this.activeIndex + this.navDir)

    private handleBreakpoint = () => {
      // The anchoring mode flipped with the breakpoint; re-align the active
      // slide instantly.
      this.scrollToSlide(this.activeIndex, 'auto')
    }

    connectedCallback() {
      this.track = this.querySelector('.track')
      this.slides = Array.from(this.querySelectorAll('[data-slide]'))
      this.prev = this.querySelector('.previous')
      this.next = this.querySelector('.next')
      if (!this.track || this.slides.length === 0) return
      this.layout = this.dataset.layout ?? 'full'
      this.dataset.enhanced = 'true'

      this.track.addEventListener('scroll', this.handleScroll, {passive: true})
      this.track.addEventListener('keydown', this.handleKeydown)
      this.prev?.addEventListener('click', this.handlePrevClick)
      this.next?.addEventListener('click', this.handleNextClick)
      this.belowDesktop.addEventListener('change', this.handleBreakpoint)
      this.slides.forEach((slide, index) => {
        const handler = () => {
          if (index !== this.activeIndex) this.goTo(index)
        }
        this.slideHandlers.push({slide, handler})
        slide.addEventListener('click', handler)
      })

      // Open on the authored first video in split layouts (anchored to the
      // text-side edge), otherwise on the second video so the active slide is
      // flanked on both sides; the jump is instant, before the first paint.
      const initialIndex = this.anchored
        ? this.layout === 'textRight'
          ? this.slides.length - 1
          : 0
        : Math.min(1, this.slides.length - 1)
      this.scrollToSlide(initialIndex, 'auto')
      this.setActive(initialIndex)
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.scrollFrame)
      this.scrollFrame = 0
      if (this.targetTimer !== null) {
        clearTimeout(this.targetTimer)
        this.targetTimer = null
      }
      this.track?.removeEventListener('scroll', this.handleScroll)
      this.track?.removeEventListener('keydown', this.handleKeydown)
      this.prev?.removeEventListener('click', this.handlePrevClick)
      this.next?.removeEventListener('click', this.handleNextClick)
      this.belowDesktop.removeEventListener('change', this.handleBreakpoint)
      for (const {slide, handler} of this.slideHandlers) {
        slide.removeEventListener('click', handler)
      }
      this.slideHandlers = []
    }

    /** The active slide is whichever sits at the anchor: closest to the
     *  text-side track edge in split layouts, or to the center otherwise. */
    private nearestIndex(): number {
      if (!this.track) return 0
      const trackRect = this.track.getBoundingClientRect()
      const center = trackRect.left + trackRect.width / 2
      let best = 0
      let bestDistance = Infinity
      this.slides.forEach((slide, index) => {
        const rect = slide.getBoundingClientRect()
        const distance = this.anchored
          ? this.layout === 'textRight'
            ? Math.abs(rect.right - trackRect.right)
            : Math.abs(rect.left - trackRect.left)
          : Math.abs(rect.left + rect.width / 2 - center)
        if (distance < bestDistance) {
          bestDistance = distance
          best = index
        }
      })
      return best
    }

    private syncActiveFromScroll() {
      const nearest = this.nearestIndex()
      // While a button/click/keyboard navigation is animating toward a
      // target, don't let intermediate positions steal the active state.
      if (this.targetIndex !== null) {
        if (nearest !== this.targetIndex) return
        this.targetIndex = null
        if (this.targetTimer !== null) {
          clearTimeout(this.targetTimer)
          this.targetTimer = null
        }
      }
      this.setActive(nearest)
    }

    private setActive(index: number) {
      this.activeIndex = index
      this.slides.forEach((slide, i) => {
        const isActive = i === index
        slide.toggleAttribute('data-active', isActive)
        // Media Frame gates playback on its `active` attribute: only the
        // anchored video can play; neighbours pause as they recede.
        slide.querySelector('media-frame')?.toggleAttribute('active', isActive)
      })
      this.updateNav()
    }

    private updateNav() {
      if (!this.prev || !this.next) return
      const last = this.slides.length - 1
      // The textRight track renders reversed, so the authored first/last
      // videos sit at the opposite DOM ends and the disabled ends swap.
      this.prev.disabled =
        this.layout === 'textRight' ? this.activeIndex >= last : this.activeIndex <= 0
      this.next.disabled =
        this.layout === 'textRight' ? this.activeIndex <= 0 : this.activeIndex >= last
    }

    /** Scrolls so the given slide lands on the anchor: the text-side track
     *  edge in split layouts, or the track's center otherwise. */
    private scrollToSlide(index: number, behavior: ScrollBehavior) {
      if (!this.track) return
      const slide = this.slides[index]
      if (!slide) return
      const trackRect = this.track.getBoundingClientRect()
      const slideRect = slide.getBoundingClientRect()
      const delta = this.anchored
        ? this.layout === 'textRight'
          ? slideRect.right - trackRect.right
          : slideRect.left - trackRect.left
        : slideRect.left + slideRect.width / 2 - (trackRect.left + trackRect.width / 2)
      this.track.scrollTo({left: this.track.scrollLeft + delta, behavior})
    }

    private goTo(index: number) {
      if (!this.track || this.slides.length === 0) return
      const clamped = Math.min(Math.max(index, 0), this.slides.length - 1)
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      this.targetIndex = clamped
      if (this.targetTimer !== null) clearTimeout(this.targetTimer)
      this.targetTimer = setTimeout(() => {
        this.targetIndex = null
        this.targetTimer = null
      }, 800)
      this.scrollToSlide(clamped, reduced ? 'auto' : 'smooth')
      // Reflect the destination immediately (starts the video); the scroll
      // listener stays authoritative if the gesture is interrupted.
      this.setActive(clamped)
    }
  }

  if (!customElements.get('video-carousel')) {
    customElements.define('video-carousel', VideoCarouselElement)
  }
</script>

<style>
  .video-carousel {
    display: block;
    position: relative;
  }

  /* Split layouts: the carousel block always spans the row's full width, so
     this inner 12-column grid (same gutter) aligns with the page grid — the
     stage takes 3/4, the text box 1/4, top-aligned. */
  .video-carousel[data-layout='textRight'],
  .video-carousel[data-layout='textLeft'] {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--page-gutter);
    align-items: start;
  }

  /* The stage is the carousel's visible region and the container-query
     context for every slide measurement. In split layouts it overflows only
     the edge farthest from the text, flowing past the page gutter to the
     viewport edge; the text side stays flush with the grid. */
  .stage {
    container-type: inline-size;
    position: relative;
    min-width: 0;
    /* Slide width: the smaller of the carousel share and the height cap
       expressed through the video's own ratio, so every video renders at its
       intrinsic aspect ratio. The cap is the height a 16:9 video has at full
       slide width — no video ever stands taller than that, whatever its
       ratio. */
    --slide-w: 76cqw;
    --cap-h: calc(var(--slide-w) * 9 / 16);
  }

  .video-carousel[data-layout='textRight'] .stage {
    grid-column: 1 / 10;
    margin-left: calc(-1 * var(--page-inset));
  }

  .video-carousel[data-layout='textRight'] .aside {
    grid-column: 10 / -1;
  }

  .video-carousel[data-layout='textLeft'] .stage {
    grid-column: 4 / -1;
    margin-right: calc(-1 * var(--page-inset));
  }

  .video-carousel[data-layout='textLeft'] .aside {
    grid-column: 1 / 4;
  }

  .aside {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .aside :global(a:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .track {
    display: flex;
    align-items: center;
    gap: var(--page-gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* End padding lets the first and last slides reach the center; each side
       is derived from its end slide's width via --ratio-first/--ratio-last. */
    padding-inline:
      calc((100cqw - min(var(--slide-w), calc(var(--cap-h) * var(--ratio-first)))) / 2)
      calc((100cqw - min(var(--slide-w), calc(var(--cap-h) * var(--ratio-last)))) / 2);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Split layouts (desktop): the active slide anchors to the text-side track
     edge, so the padding moves to the far edge — that is what lets the last
     upcoming video reach the anchor while the rest trail past the gutter.
     textRight anchors right (its track renders reversed); textLeft anchors
     left. */
  @media (--bp-desktop) {
    .video-carousel[data-layout='textRight'] .track {
      padding-inline: calc(100cqw - min(var(--slide-w), calc(var(--cap-h) * var(--ratio-first)))) 0;
    }

    .video-carousel[data-layout='textLeft'] .track {
      padding-inline: 0 calc(100cqw - min(var(--slide-w), calc(var(--cap-h) * var(--ratio-last))));
    }

    .video-carousel[data-layout='textRight'] .slide {
      scroll-snap-align: end;
    }

    .video-carousel[data-layout='textLeft'] .slide {
      scroll-snap-align: start;
    }
  }

  .slide {
    flex: 0 0 auto;
    width: min(var(--slide-w), calc(var(--cap-h) * var(--ratio)));
    scroll-snap-align: center;
    position: relative;
    /* Receded state: neighbours shrink and dim so the anchored video sits
       slightly forward in space. */
    transform: scale(0.92);
    opacity: 0.55;
    transition:
      transform var(--motion-standard) var(--motion-ease-out),
      opacity var(--motion-standard) var(--motion-ease-out);
  }

  .slide[data-active] {
    transform: scale(1);
    opacity: 1;
    z-index: 2;
  }

  /* Only the anchored video shows its Media Control Bar and receives
     pointer input; trailing slides are click-to-anchor surfaces. */
  .slide:not([data-active]) {
    cursor: pointer;
  }

  .slide:not([data-active]) :global(.media-frame) {
    pointer-events: none;
  }

  .slide:not([data-active]) :global(.media-controls) {
    display: none;
  }

  /* Controls match the Card Carousel style (40px bordered squares), grouped
     at the Card Carousel's spacing and placed per layout: centered below the
     full-width track, or at the carousel's bottom inner corner in the split
     layouts (bottom right beside right-hand text, bottom left beside
     left-hand text). */
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: var(--space-xs);
  }

  .video-carousel[data-layout='full'] .controls {
    justify-content: center;
  }

  .video-carousel[data-layout='textRight'] .controls {
    justify-content: flex-end;
  }

  .video-carousel[data-layout='textLeft'] .controls {
    justify-content: flex-start;
  }

  video-carousel:not([data-enhanced]) .controls {
    display: none;
  }

  .control {
    width: 40px;
    height: 40px;
    border: 1px solid color-mix(in srgb, var(--fg) 30%, transparent);
    border-radius: var(--radius-control);
    background: transparent;
    color: inherit;
    cursor: pointer;
    --wipe-surface: var(--fg);
    --wipe-ink: var(--bg);
  }

  .control:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .control__icon {
    position: relative;
    z-index: 2;
  }

  .control:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* Without the carousel enhancement, native scroll + snap still browse the
     videos; show every slide plainly. */
  video-carousel:not([data-enhanced]) .slide {
    transform: none;
    opacity: 1;
  }

  @media (--bp-below-desktop) {
    .stage {
      --slide-w: 84cqw;
    }

    /* Split layouts stack in authored order (left-hand text above the
       carousel, right-hand text below it); the track then bleeds both edges
       and the controls center, matching the full-width layout. */
    .video-carousel[data-layout='textRight'],
    .video-carousel[data-layout='textLeft'] {
      grid-template-columns: 1fr;
    }

    .video-carousel[data-layout='textRight'] .stage,
    .video-carousel[data-layout='textLeft'] .stage {
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--page-inset));
    }

    .video-carousel[data-layout='textRight'] .aside,
    .video-carousel[data-layout='textLeft'] .aside {
      grid-column: 1 / -1;
    }

    .video-carousel[data-layout='textRight'] .controls,
    .video-carousel[data-layout='textLeft'] .controls {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>
