---
import type {TypedObject} from 'astro-portabletext/types'
import MediaFrame, {type Media, type MediaRatio} from './MediaFrame.astro'
import PortableText from './PortableText.astro'
import VideoCarousel from './VideoCarousel.astro'
import {
  contentLayoutSizes,
  getContentLayoutRowClassNames,
  isContentLayoutFullBleed,
  type ContentLayoutAlignment,
  type ContentLayoutWidth,
} from '../lib/contentLayout'

type MediaBlock = {
  _type: 'contentLayoutMedia'
  _key?: string | null
  width?: ContentLayoutWidth | null
  aspectRatio?: MediaRatio | null
  media?: Media | null
}

type TextBlock = {
  _type: 'contentLayoutText'
  _key?: string | null
  width?: ContentLayoutWidth | null
  text?: TypedObject[] | null
}

type SpacerBlock = {
  _type: 'contentLayoutSpacer'
  _key?: string | null
  width?: ContentLayoutWidth | null
}

// Carousels carry no width: they always span the full row (schema contract
// keeps a carousel as the row's only block).
type CarouselBlock = {
  _type: 'contentLayoutCarousel'
  _key?: string | null
  videos?: Array<Media | null> | null
}

export interface ContentLayoutRowValue {
  _type: 'contentLayoutRow'
  _key?: string | null
  blocks?: Array<MediaBlock | TextBlock | SpacerBlock | CarouselBlock> | null
  alignment?: ContentLayoutAlignment | null
  fullBleed?: boolean | null
}

interface Props {
  row: ContentLayoutRowValue
  mediaTitle?: string | null
}

const {row, mediaTitle} = Astro.props
const blocks = row.blocks ?? []
const classes = getContentLayoutRowClassNames({
  blocks,
  alignment: row.alignment,
  fullBleed: row.fullBleed,
})
const fullBleed = isContentLayoutFullBleed({
  blocks,
  alignment: row.alignment,
  fullBleed: row.fullBleed,
})
// Carousels have no width control because they always render edge-to-edge:
// a lone carousel block escapes the content gutter at every breakpoint.
const carouselBleed = blocks.length === 1 && blocks[0]?._type === 'contentLayoutCarousel'
// Full-bleed rows escape the content gutter and span the full viewport, so hint
// the browser at 100vw there for accurate srcset selection.
const sizesFor = (width?: ContentLayoutWidth | null) =>
  fullBleed ? '100vw' : contentLayoutSizes(width)
---

{
  blocks.length > 0 && (
    <div class:list={[classes.row, {'full-bleed': fullBleed, 'carousel-bleed': carouselBleed}]}>
      {blocks.map((block, index) => (
        <div
          class:list={classes.blocks[index]}
          aria-hidden={block._type === 'contentLayoutSpacer' || undefined}
        >
          {block._type === 'contentLayoutMedia' && (
            <MediaFrame
              media={block.media}
              ratio={block.aspectRatio ?? '16:9'}
              sizes={sizesFor(block.width ?? undefined)}
              title={mediaTitle}
            />
          )}
          {block._type === 'contentLayoutText' && (
            <div class="content-layout-text">
              <PortableText value={block.text ?? []} />
            </div>
          )}
          {block._type === 'contentLayoutCarousel' && (
            <VideoCarousel videos={block.videos} label={mediaTitle} />
          )}
        </div>
      ))}
    </div>
  )
}

<style>
  .content-layout-row {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--page-gutter);
    /* Text blocks top-align with the media beside them rather than stretching
       to the row height. */
    align-items: start;
  }
  .content-layout-row.single {
    display: flex;
  }
  .single.align-left {
    justify-content: flex-start;
  }
  .single.align-center {
    justify-content: center;
  }
  .single.align-right {
    justify-content: flex-end;
  }
  .content-layout-block {
    min-width: 0;
  }
  .width-1-4 {
    grid-column: span 3;
  }
  .width-1-3 {
    grid-column: span 4;
  }
  .width-1-2 {
    grid-column: span 6;
  }
  .width-2-3 {
    grid-column: span 8;
  }
  .width-3-4 {
    grid-column: span 9;
  }
  .width-full {
    grid-column: 1 / -1;
  }
  .single .width-1-4 {
    width: 25%;
  }
  .single .width-1-3 {
    width: calc(100% / 3);
  }
  .single .width-1-2 {
    width: 50%;
  }
  .single .width-2-3 {
    width: calc(200% / 3);
  }
  .single .width-3-4 {
    width: 75%;
  }
  .single .width-full {
    width: 100%;
  }
  .full-bleed {
    width: 100vw;
    max-width: none;
    margin-inline: calc(50% - 50vw);
  }
  /* Unlike opt-in full-bleed media (which re-insets below desktop), carousel
     rows keep the viewport escape at every breakpoint — no gutters. The
     two-class selector outranks the plain .full-bleed mobile revert. */
  .content-layout-row.carousel-bleed {
    width: 100vw;
    max-width: none;
    margin-inline: calc(50% - 50vw);
  }
  .content-layout-text {
    overflow-wrap: anywhere;
  }
  .content-layout-text :global(a:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  @media (--bp-below-desktop) {
    .content-layout-row,
    .content-layout-row.single {
      display: grid;
      grid-template-columns: 1fr;
    }
    .content-layout-block,
    .width-1-4,
    .width-1-3,
    .width-1-2,
    .width-2-3,
    .width-3-4,
    .width-full {
      width: 100%;
      grid-column: 1;
    }
    .full-bleed {
      width: 100%;
      margin-inline: 0;
    }
  }
</style>
