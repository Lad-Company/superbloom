---
import PageHero from '../PageHero.astro';
import Capes from '../blocks/Capes.astro';
import NewsCarousel from '../blocks/NewsCarousel.astro';
import HomeParallax from '../blocks/HomeParallax.astro';
import HomeWork from '../blocks/HomeWork.astro';
import HomeWhy from '../blocks/HomeWhy.astro';
import HomeZine from '../blocks/HomeZine.astro';
import HomePressCta from '../blocks/HomePressCta.astro';
import ContactBand from '../ContactBand.astro';
import type { HomepageQueryResult } from '../../sanity.types';

interface Props {
  homepage: NonNullable<HomepageQueryResult>;
}

const { homepage } = Astro.props;
const workItems = (homepage.work?.items ?? []).filter(
  (entry): entry is typeof entry & { item: NonNullable<typeof entry.item> } => entry.item !== null,
);
const creativeHeadline = homepage.why?.headline ?? 'The Creative Collective.';
const creativeBody =
  homepage.why?.body ??
  'One integrated creative agency model, powered by 300+ creative minds, built to help brands move faster, challenge convention, and create culturally relevant work.';

const moduleSurfaceRoles = {
  newsBlock: 'light',
  contactBlock: 'brand-deep',
} as const;
---

{homepage.hero && (
  <PageHero
    heading={homepage.hero.heading ?? ''}
    subheading={homepage.hero.showSubheading !== false ? homepage.hero.subheading : null}
    media={homepage.hero.heroMedia}
  />
)}

{homepage.news && (
  <NewsCarousel
    headline={homepage.news.headline}
    items={homepage.news.items ?? []}
    listDefaults={homepage.news.listDefaults}
    itemOverrides={homepage.news.itemOverrides}
    globalSettings={homepage.globalCardDefaults}
    role={moduleSurfaceRoles.newsBlock}
  />
)}

{homepage.parallax && (homepage.parallax.headline || (homepage.parallax.images?.length ?? 0) > 0) && (
  <HomeParallax
    headline={homepage.parallax.headline}
    images={homepage.parallax.images}
  />
)}

{homepage.capabilities && (
  <Capes
    headline={homepage.capabilities.headline}
    contextualCopy={homepage.capabilities.contextualCopy}
    capabilities={homepage.capabilities.capabilities ?? []}
  />
)}

{workItems.length > 0 && (
  <HomeWork
    headline={homepage.work?.headline ?? 'Our Work'}
    ctaLabel={homepage.work?.ctaLabel ?? 'View all'}
    preset={homepage.work?.layoutPreset}
    items={workItems}
  />
)}

<HomeWhy
  headline={creativeHeadline}
  body={creativeBody}
  ctaLabel={homepage.why?.ctaLabel ?? 'Explore our collective'}
  ctaHref={homepage.why?.ctaHref ?? '/who-we-are'}
  media={homepage.why?.media ?? homepage.fallbackCreativeMedia}
/>

{homepage.zine && (
  <HomeZine
    issue={homepage.zine.issue}
    currentIssueSlug={homepage.zine.currentIssueSlug}
    promoHeadline={homepage.zine.promoHeadline}
    promoIntro={homepage.zine.promoIntro}
    promoMedia={homepage.zine.promoMedia}
    ctaLabel={homepage.zine.ctaLabel}
  />
)}

<HomePressCta />

{homepage.contact && <ContactBand role={moduleSurfaceRoles.contactBlock} />}
