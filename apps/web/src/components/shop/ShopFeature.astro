---
import MediaFrame from '../MediaFrame.astro'
import PortableText from '../PortableText.astro'
import Button from '../Button.astro'
import {isShopFeatureComplete, type ShopFeatureValue} from '../../lib/shopFeature'
import type {ContentLayoutWidth} from '../../lib/contentLayout'
import {control} from '../../lib/surfaceRole'

interface Props {
  featured: ShopFeatureValue | null
}

const {featured} = Astro.props

// Twelfths of the 12-column grid, mirroring the content layout contract.
const WIDTH_COLUMNS: Record<ContentLayoutWidth, number> = {
  '1/4': 3,
  '1/3': 4,
  '1/2': 6,
  '2/3': 8,
  '3/4': 9,
  full: 12,
}

const mediaBlock = featured?.media
const textBlock = featured?.text
const mediaColumns = WIDTH_COLUMNS[mediaBlock?.width ?? '1/2']
const textColumns = WIDTH_COLUMNS[textBlock?.width ?? '1/2']
---

{
  isShopFeatureComplete(featured) && (
    <section
      class="shop-feature"
      aria-label="Featured"
      style={`--media-columns: ${mediaColumns}; --text-columns: ${textColumns}; ${control.onDark}`}
    >
      <div class="shop-feature-media">
        <MediaFrame
          media={mediaBlock?.media}
          ratio={mediaBlock?.aspectRatio ?? '1:1'}
          placement={{context: 'layoutBlock', width: mediaBlock?.width ?? '1/2', fullBleed: false}}
        />
      </div>
      <div class="shop-feature-copy">
        <PortableText value={textBlock?.text ?? []} class="type-body" />
        <Button href={featured?.ctaHref ?? undefined} label={featured?.ctaLabel ?? ''} />
      </div>
    </section>
  )
}

<style>
  /* The section rides the shop page's dark body surface; control.onDark (set
     inline above, same pattern as the PageHero media hero) resolves the CTA's
     --control-bg/--control-fg tokens so the button paints white-on-black and
     wipes to black-on-white instead of falling back to the light-surface
     default and disappearing on the black background. */
  .shop-feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    /* Min 64px between the columns (page-gutter is 24px), same as the
       zine Letter from the Editor split. */
    gap: max(var(--space-m), var(--page-gutter));
    padding: clamp(var(--space-3xl), 14vw, var(--space-4xl)) var(--page-inset);
  }

  .shop-feature-media,
  .shop-feature-copy {
    min-width: 0;
  }

  .shop-feature-media {
    grid-column: span var(--media-columns);
  }

  .shop-feature-copy {
    grid-column: span var(--text-columns);
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-xs);
  }

  .shop-feature-copy :global(.portable-text) {
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .shop-feature-copy :global(.portable-text p) {
    margin: 0 0 var(--space-xs);
  }

  .shop-feature-copy :global(.portable-text p:last-child) {
    margin-bottom: 0;
  }

  @media (--bp-below-desktop) {
    .shop-feature {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }

    .shop-feature-media,
    .shop-feature-copy {
      grid-column: 1 / -1;
    }
  }

  @media (--bp-small) {
    .shop-feature {
      padding-block: var(--space-xs);
    }
  }
</style>
