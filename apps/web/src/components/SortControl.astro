---
export interface Props {
  value: 'newest' | 'oldest'
}

const {value = 'newest'} = Astro.props
const nextSort = value === 'newest' ? 'oldest' : 'newest'
const href = nextSort === 'oldest' ? '/index?sort=oldest' : '/index'
const actionLabel =
  value === 'newest'
    ? 'Sorted by date, newest first. Activate to sort oldest first.'
    : 'Sorted by date, oldest first. Activate to sort newest first.'
---

<div class="sort-control">
  <span class="sort-label type-h5">Sort by</span>
  <a class="sort-toggle type-h5" href={href} data-sort-toggle aria-label={actionLabel}>
    <span class="sort-toggle-text underline-draw">Date</span>
    <span class="sort-arrow" data-direction={value} aria-hidden="true">
      <svg viewBox="0 0 18 9" width="18" height="9" fill="none">
        <path
          d="M1 1L9 8L17 1"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </a>
</div>

<script>
  // Progressive enhancement: swap only the sort section in place so changing
  // sort order does not trigger a full page reload or jump the visitor to the top.
  const regionOf = (node: Element | null | undefined) =>
    node?.closest<HTMLElement>('section') ?? null

  const swapRegion = async (url: string, region: HTMLElement) => {
    const response = await fetch(url)
    if (!response.ok) throw new Error('Sort request failed')
    const doc = new DOMParser().parseFromString(await response.text(), 'text/html')
    const nextRegion = regionOf(doc.querySelector('[data-sort-toggle]'))
    if (!nextRegion) throw new Error('Sorted section missing from response')
    region.innerHTML = nextRegion.innerHTML
    return response.url
  }

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0) return
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    const toggle = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-sort-toggle]')
    if (!toggle) return
    const region = regionOf(toggle)
    if (!region || !toggle.href) return

    event.preventDefault()
    swapRegion(toggle.href, region)
      .then((finalUrl) => history.pushState(null, '', finalUrl))
      .catch(() => {
        window.location.href = toggle.href
      })
  })

  window.addEventListener('popstate', () => {
    const region = regionOf(document.querySelector('[data-sort-toggle]'))
    if (!region) return
    swapRegion(window.location.href, region).catch(() => window.location.reload())
  })
</script>

<style>
  .sort-control {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .sort-label {
    color: var(--fg-30);
  }

  .sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .sort-toggle:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .sort-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--fg);
    transition: transform var(--motion-quick) var(--motion-ease-out);
  }

  .sort-arrow[data-direction='oldest'] {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .sort-arrow {
      transition: none;
    }
  }
</style>
