---
import type {ArticleTypeFilter} from '../lib/articleTypes'
import DropdownChevron from './DropdownChevron.astro'

export interface Props {
  value: 'newest' | 'oldest'
  type?: ArticleTypeFilter | null
}

const {value = 'newest', type = null} = Astro.props
const nextSort = value === 'newest' ? 'oldest' : 'newest'
const params = new URLSearchParams()
if (nextSort === 'oldest') params.set('sort', 'oldest')
if (type) params.set('type', type)
const query = params.toString()
const href = query ? `/index?${query}` : '/index'
const actionLabel =
  value === 'newest'
    ? 'Sorted by date, newest first. Activate to sort oldest first.'
    : 'Sorted by date, oldest first. Activate to sort newest first.'
---

<div class="sort-control">
  <button type="button" class="sort-label type-h5 underline-draw" data-mode-swap>Sort by</button>
  <a class="sort-toggle type-h5" href={href} data-sort-toggle aria-label={actionLabel}>
    <span class="sort-toggle-text underline-draw">Date</span>
    <span class="sort-arrow" data-direction={value} aria-hidden="true">
      <DropdownChevron />
    </span>
  </a>
</div>

<script>
  import {initBrowseSwap} from '../lib/browseSwap'

  // Progressive enhancement shared with the type filter: swap only the browse
  // section in place so changing sort order does not trigger a full page
  // reload or jump the visitor to the top.
  initBrowseSwap()
</script>

<style>
  .sort-control {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  /* Button reset only; font tokens come from the type-h5 class. */
  .sort-label {
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-30);
    cursor: pointer;
  }

  .sort-label:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .sort-toggle:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .sort-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--fg);
    transition: transform var(--motion-quick) var(--motion-ease-out);
  }

  .sort-arrow[data-direction='oldest'] {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .sort-arrow {
      transition: none;
    }
  }
</style>
