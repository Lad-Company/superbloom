---
import {type SurfaceRole, vars} from '../lib/surfaceRole'

interface Props {
  role?: SurfaceRole
  id?: string
  class?: string
  tabindex?: number
  'aria-labelledby'?: string
}

const {
  role = 'light',
  id,
  class: className,
  tabindex,
  'aria-labelledby': ariaLabelledBy,
} = Astro.props
---

<section
  id={id}
  tabindex={tabindex}
  aria-labelledby={ariaLabelledBy}
  data-surface-role={role}
  style={vars[role]}
  class:list={['surface-section', className]}
>
  <slot />
</section>

<style>
  .surface-section {
    --fg-12: color-mix(in srgb, var(--fg) 12%, transparent);
    --fg-60: color-mix(in srgb, var(--fg) 60%, transparent);
    background: var(--bg);
    color: var(--fg);
  }
</style>
