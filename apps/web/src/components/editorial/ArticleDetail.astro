---
import MediaFrame, {type Media} from '../MediaFrame.astro'
import PortableText from '../PortableText.astro'
import ArticleBodyRenderer from './ArticleBodyRenderer.astro'
import MixedArticleCard from '../MixedArticleCard.astro'
import CardCarousel from '../CardCarousel.astro'
import PageHero from '../PageHero.astro'
import Button from '../Button.astro'
import type {ContentLayoutRowValue} from '../ContentLayoutRow.astro'
import type {TypedObject} from 'astro-portabletext/types'
import type {
  CardWidth,
  InfoPosition,
  MediaAspectRatio,
  PartialContentCardSettings,
} from '../../lib/contentCard'

type Tag = {title?: string | null; color?: string | null}
type PortableBlock = TypedObject & {children?: Array<{text?: string | null}>}
type RelatedItem = {
  _type: 'article'
  articleType?: 'news' | 'editorial' | 'zine' | null
  title: string | null
  slug: string | null
  issueSlug?: string | null
  overview?: PortableBlock[] | null
  publicationDate?: string | null
  cardWidth?: CardWidth | null
  mediaAspectRatio?: MediaAspectRatio | null
  infoPosition?: InfoPosition | null
  cardMedia: Media | null
  tags: Tag[] | null
}
type BodyBlock = ContentLayoutRowValue

interface Props {
  article: {
    _type: 'article'
    articleType?: 'news' | 'editorial' | 'zine' | null
    title?: string | null
    publicationDate?: string | null
    overview?: PortableBlock[] | null
    leadMedia?: Media | null
    body?: BodyBlock[] | null
    destination?: string | null
    source?: string | null
    tags?: Tag[] | null
    relatedItems?: RelatedItem[] | null
    globalCardDefaults?: PartialContentCardSettings
  }
}

const {article} = Astro.props
const body = article.body ?? []
const relatedItems = article.relatedItems ?? []
// News-only footer CTA: destination/source are News-only CMS fields, so this
// never renders for Editorial or Zine articles.
const destinationCtaLabel = article.source
  ? `Read on ${article.source}`
  : 'Read the full story'
---

<article class="article-detail">
  <PageHero
    heading={article.title ?? ''}
    tags={article.tags?.map((tag) => tag.title ?? '').filter(Boolean)}
    headingSize="h3"
  />

  {
    article.leadMedia && (
      <div class="lead-media">
        <MediaFrame
          media={article.leadMedia}
          ratio="16:9"
          placement={{context: 'hero', capPx: 1440, fraction: 0.9}}
          title={article.title}
        />
      </div>
    )
  }

  {
    article.overview && (
      <section class="overview">
        <div class="overview-spacer" />
        <div class="overview-content">
          <h2 class="type-eyebrow overview-eyebrow">Overview</h2>
          <PortableText value={article.overview} class="editorial-title" />
        </div>
      </section>
    )
  }

  {body.map((block) => <ArticleBodyRenderer block={block} />)}

  {
    article.destination && (
      <section class="destination-cta">
        <div class="destination-cta-spacer" aria-hidden="true" />
        <Button
          href={article.destination}
          label={destinationCtaLabel}
          target="_blank"
          rel="noopener noreferrer"
        />
      </section>
    )
  }

  {
    relatedItems.length === 3 && (
      <nav class="related-items" aria-label="More stories">
        <CardCarousel label="More stories" heading="More stories">
          {relatedItems.map((item) => (
            <MixedArticleCard item={item} rail globalSettings={article.globalCardDefaults} showCopy />
          ))}
        </CardCarousel>
      </nav>
    )
  }
</article>

<style>
  h1,
  h2 {
    margin: 0;
  }

  .lead-media {
    margin-top: var(--space-xl);
    padding: 0 var(--page-inset);
  }

  .overview {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: var(--page-gutter);
    padding: var(--space-xl) var(--page-inset) 0;
  }

  .overview-content {
    min-width: 0;
  }

  .overview-eyebrow {
    margin: 0 0 var(--space-xs);
  }

  /* Mirrors the .overview grid so the news CTA's left edge aligns with the
     overview content column (1/4-width inset from the page edge). */
  .destination-cta {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: var(--page-gutter);
    justify-items: start;
    padding: var(--space-2xl) var(--page-inset);
  }

  .related-items {
    margin-top: var(--space-2xl);
    padding: var(--space-2xl) var(--page-inset);
    background: #000;
    color: #fff;
    --bg: #000;
    --fg: #fff;
  }

  @media (--bp-small) {
    .overview,
    .destination-cta {
      grid-template-columns: 1fr;
    }

    .overview-spacer,
    .destination-cta-spacer {
      display: none;
    }

    .overview-eyebrow {
      margin-bottom: var(--space-3xs);
    }
  }
</style>
