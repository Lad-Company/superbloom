---
import MediaFrame, {type Media} from '../MediaFrame.astro';
import type {MediaPlacement} from '../../lib/mediaRenderingPlan';

interface Props {
  layout?: 'full-width' | 'editorial-rail' | 'paired' | null;
  media?: Media | null;
  pairedMedia?: Media[] | null;
}

const {layout: layoutProp = 'full-width', media, pairedMedia} = Astro.props;
const layout: 'full-width' | 'editorial-rail' | 'paired' = layoutProp ?? 'full-width';
const frames = layout === 'paired' ? pairedMedia ?? [] : media ? [media] : [];

// full-width targets the wide content frame (~1440px); editorial-rail is
// narrower (~960px); paired splits the frame 50/50 below desktop.
const placementFor = (name: 'full-width' | 'editorial-rail' | 'paired'): MediaPlacement => {
  if (name === 'paired') return {context: 'split'}
  if (name === 'editorial-rail') return {context: 'layoutBlock', width: 'full', capPx: 960}
  return {context: 'layoutBlock', width: 'full', capPx: 1440}
}
---

{frames.length > 0 && (
  <section class:list={['article-media', `layout-${layout}`]}>
    {frames.map((frame) => <MediaFrame media={frame} ratio={layout === 'editorial-rail' ? '3:2' : '16:9'} placement={placementFor(layout)} />)}
  </section>
)}

<style>
  .article-media {
    display: grid;
    gap: var(--space-xs);
    width: min(100% - (2 * var(--page-inset)), 1440px);
    margin: var(--space-xl) auto;
  }

  .layout-editorial-rail {
    width: min(100% - (2 * var(--page-inset)), 960px);
  }

  .layout-paired {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (--bp-below-desktop) {
    .layout-paired {
      grid-template-columns: 1fr;
    }
  }
</style>
