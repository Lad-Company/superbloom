---
import MediaFrame, {type Media} from '../MediaFrame.astro';

interface Props {
  layout?: 'full-width' | 'editorial-rail' | 'paired' | null;
  media?: Media | null;
  pairedMedia?: Media[] | null;
}

const {layout: layoutProp = 'full-width', media, pairedMedia} = Astro.props;
const layout: 'full-width' | 'editorial-rail' | 'paired' = layoutProp ?? 'full-width';
const frames = layout === 'paired' ? pairedMedia ?? [] : media ? [media] : [];

// full-width targets the wide content frame (~1440px); editorial-rail is
// narrower (~960px); paired splits the frame 50/50 below 1440px. The single
// media-condition + length form is the only syntax `sizes` accepts, so we
// approximate the CSS-side min() caps with an explicit branch.
const sizesFor = (name: 'full-width' | 'editorial-rail' | 'paired') => {
  if (name === 'paired') return '(max-width: 1023px) 100vw, 50vw'
  if (name === 'editorial-rail') return '(max-width: 959px) 100vw, 960px'
  return '(max-width: 1439px) 100vw, 1440px'
}
---

{frames.length > 0 && (
  <section class:list={['article-media', `layout-${layout}`]}>
    {frames.map((frame) => <MediaFrame media={frame} ratio={layout === 'editorial-rail' ? '3:2' : '16:9'} sizes={sizesFor(layout)} />)}
  </section>
)}

<style>
  .article-media {
    display: grid;
    gap: var(--space-xs);
    width: min(100% - (2 * var(--page-inset)), 1440px);
    margin: var(--space-xl) auto;
  }

  .layout-editorial-rail {
    width: min(100% - (2 * var(--page-inset)), 960px);
  }

  .layout-paired {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 1023px) {
    .layout-paired {
      grid-template-columns: 1fr;
    }
  }
</style>
