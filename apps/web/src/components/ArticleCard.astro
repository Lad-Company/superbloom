---
import EditorialCard from './EditorialCard.astro'
import TagList from './TagList.astro'
import type {Media} from './MediaFrame.astro'
import {ARTICLE_TYPE_LABELS, type ArticleTypeFilter} from '../lib/articleTypes'
import {
  type CardWidth,
  type InfoPosition,
  type MediaAspectRatio,
  type PartialContentCardSettings,
} from '../lib/contentCard'

interface Tag {
  title?: string | null
  color?: string | null
}

interface ArticleItem {
  _id?: string | null
  articleType?: ArticleTypeFilter | null
  title: string | null
  slug: string | null
  overview?: Array<{children?: Array<{text?: string | null}>}> | null
  publicationDate?: string | null
  cardWidth?: CardWidth | null
  mediaAspectRatio?: MediaAspectRatio | null
  infoPosition?: InfoPosition | null
  tags: Tag[] | null
  cardMedia: Media | null
}

interface Props {
  item: ArticleItem
  showCopy?: boolean
  class?: string
  rail?: boolean
  settings?: PartialContentCardSettings
  listSettings?: PartialContentCardSettings
  globalSettings?: PartialContentCardSettings
  minimal?: boolean
}

const {
  item,
  showCopy = false,
  class: className,
  rail = false,
  settings,
  listSettings,
  globalSettings,
  minimal = false,
} = Astro.props
const href = item.slug ? `/articles/${item.slug}` : '#'
const summary = item.overview
  ?.flatMap((block) => block.children?.map((child) => child.text ?? '') ?? [])
  .join(' ')
  .trim()
const typeLabel = item.articleType ? ARTICLE_TYPE_LABELS[item.articleType] : 'Editorial'
---

<EditorialCard
  href={href}
  title={item.title}
  media={item.cardMedia}
  rail={rail}
  contentSettings={item}
  settings={settings}
  listSettings={listSettings}
  globalSettings={globalSettings}
  summary={showCopy && !minimal ? summary : undefined}
  publicationDate={item.publicationDate}
  class={className}
  cardId={item._id}
>
  <TagList slot="overlay" tags={item.tags} typeLabel={typeLabel} maxTags={1} />
</EditorialCard>
