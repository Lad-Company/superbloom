---
import {ARTICLE_TYPES, ARTICLE_TYPE_LABELS, type ArticleTypeFilter} from '../lib/articleTypes'
import DropdownChevron from './DropdownChevron.astro'

export interface Props {
  value: ArticleTypeFilter | null
  sort?: 'newest' | 'oldest'
}

const {value = null, sort = 'newest'} = Astro.props

// Filtering resets pagination; the selected type's option links back to the
// unfiltered URL so re-selecting it clears the filter.
const hrefFor = (type: ArticleTypeFilter | null) => {
  const params = new URLSearchParams()
  if (sort === 'oldest') params.set('sort', 'oldest')
  if (type) params.set('type', type)
  const query = params.toString()
  return query ? `/index?${query}` : '/index'
}
---

<div class="type-filter" data-type-filter-root>
  <button type="button" class="type-filter-label type-h5 underline-draw" data-mode-swap>
    Filter by
  </button>
  <details class="type-filter-dropdown" data-dropdown>
    <summary class="type-filter-summary type-h5">
      <span class="type-filter-value underline-draw">{value ? ARTICLE_TYPE_LABELS[value] : 'Type'}</span>
      <span class="type-filter-arrow" aria-hidden="true">
        <DropdownChevron />
      </span>
    </summary>
    <ul class="type-filter-menu">
    {
      ARTICLE_TYPES.map((type) => {
        const selected = type === value
        const label = ARTICLE_TYPE_LABELS[type]
        return (
          <li>
            <a
              class="type-filter-option underline-draw"
              href={hrefFor(selected ? null : type)}
              data-type-filter
              aria-current={selected ? 'true' : undefined}
              aria-label={selected ? `Clear the ${label} filter` : `Show only ${label}`}
            >
              {label}
            </a>
          </li>
        )
      })
    }
    </ul>
  </details>
</div>

<script>
  import {initBrowseSwap} from '../lib/browseSwap'
  import {initDropdownDismiss} from '../lib/dropdownDismiss'

  // Shares the SortControl in-place swap: selecting a type swaps only the
  // browse section instead of reloading the page.
  initBrowseSwap()

  // The details/summary dropdown works without JS; shared dismissal adds
  // outside-pointer and Escape close behaviors.
  initDropdownDismiss()
</script>

<style>
  .type-filter {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  /* Button reset only; font tokens come from the type-h5 class. */
  .type-filter-label {
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-30);
    cursor: pointer;
  }

  .type-filter-label:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .type-filter-dropdown {
    position: relative;
  }

  .type-filter-summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }

  .type-filter-summary::-webkit-details-marker {
    display: none;
  }

  .type-filter-summary::marker {
    content: none;
  }

  .type-filter-summary:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .type-filter-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--fg);
    transition: transform var(--motion-quick) var(--motion-ease-out);
  }

  .type-filter-dropdown[open] .type-filter-arrow {
    transform: rotate(180deg);
  }

  .type-filter-menu {
    position: absolute;
    z-index: 10;
    top: 100%;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-4);
    min-width: 100%;
    margin-top: var(--space-xs-4);
    padding: var(--space-3xs);
    background: var(--bg);
    border: 1px solid var(--fg-12);
    border-radius: var(--radius-control);
  }

  .type-filter-option {
    display: block;
    padding: var(--space-xs-4) var(--space-3xs);
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .type-filter-arrow {
      transition: none;
    }
  }
</style>
