---
import MediaFrame, {type Media, type MediaPlaybackProfile, type MediaRatio} from '../MediaFrame.astro'

interface Props {
  media: Media | null
  ratio?: MediaRatio | null
  title: string
  controls?: MediaPlaybackProfile
}

const {media, ratio = '16:9', title, controls = 'full'} = Astro.props
---

<section class="featured-media">
  <MediaFrame media={media} ratio={ratio} placement={{context: 'layoutBlock', width: 'full'}} title={title} controls={controls} />
</section>

<style>
  .featured-media {
    background: var(--bg);
    /* Symmetric 32px media inset inside the colored box (matches the
       case-study lead media). The larger 96px header→media hand-off lives on
       the black header above (see who-we-are), not in this blue box. */
    padding: var(--space-xs) var(--page-inset);
  }

  .featured-media :global(.media-frame) {
    border-radius: var(--radius-media);
  }

  @media (--bp-small) {
    /* Mobile keeps the same symmetric 32px vertical inset as desktop. */
    .featured-media {
      padding: var(--space-xs) var(--space-3xs);
    }
  }
</style>
