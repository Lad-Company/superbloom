---
import MediaFrame, {type Media, type MediaRatio} from '../MediaFrame.astro'

interface Props {
  media: Media | null
  ratio?: MediaRatio | null
  title: string
  controls?: boolean
}

const {media, ratio = '16:9', title, controls = true} = Astro.props
---

<section class="featured-media">
  <MediaFrame media={media} ratio={ratio} sizes="100vw" title={title} controls={controls} />
</section>

<style>
  .featured-media {
    background: var(--bg);
    padding: var(--space-xs) var(--page-inset) var(--space-2xl);
  }

  .featured-media :global(.media-frame) {
    border-radius: var(--radius-media);
  }

  @media (max-width: 768px) {
    /* Mobile featured media sits flush under the hero — the hero's own
       32px padding-bottom plus this 32px top form the consistent 64px
       hand-off used across pages. */
    .featured-media {
      padding: var(--space-xs) var(--space-3xs) var(--space-xl);
    }
  }
</style>
