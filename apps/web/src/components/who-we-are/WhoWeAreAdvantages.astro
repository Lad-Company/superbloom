---
import MediaFrame, { type Media } from '../MediaFrame.astro';

interface AdvantageBlock {
  _key?: string;
  heading: string | null;
  body?: string | null;
  media?: Media | null;
}

interface Props {
  headline: string;
  blocks: AdvantageBlock[];
}

const { headline, blocks } = Astro.props;
---

<section class="advantages-section">
  <div class="advantages-header">
    <p class="type-h3">{headline}</p>
  </div>
  <ul class="advantages-list">
    {blocks.map((block) => (
      <li class="advantage-item">
        <div class="item-text">
          {block.heading && <p class="item-heading type-h4">{block.heading}</p>}
          {block.body && <p class="item-body type-caption">{block.body}</p>}
        </div>
        <div class="item-media">
          <MediaFrame
            media={block.media ?? null}
            ratio="3:2"
            placement={{context: 'split', collapseAt: 'small'}}
            title={block.heading ?? undefined}
          />
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .advantages-section {
    --bg: #000000;
    --fg: #ffffff;
    background: var(--bg);
    color: var(--fg);
    display: flex;
    flex-direction: column;
    /* 160px between the section header and the list. */
    gap: var(--space-3xl);
    /* No bottom padding: the next section's own 200px top padding is the
       global inter-section rhythm (var(--space-4xl)), so padding here would
       double it. */
    padding: var(--space-4xl) var(--page-inset) 0;
  }

  .advantages-header p {
    margin: 0;
  }

  .advantages-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    /* 24px between items on desktop (var(--space-2xs)). */
    gap: var(--space-2xs);
  }

  .advantage-item {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .item-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-right: var(--space-3xl);
  }

  .item-heading,
  .item-body {
    margin: 0;
  }

  .item-media {
    flex: 1 0 0;
    min-width: 0;
  }

  .item-media :global(.media-frame) {
    width: 100%;
    border-radius: var(--radius-media);
  }

  @media (--bp-small) {
    .advantages-section {
      padding: var(--space-2xl) var(--space-3xs) 0;
    }

    /* Mobile headline stays left-aligned with the rest of the page rhythm
       (explicit so no inherited centering can creep in). */
    .advantages-header {
      text-align: left;
    }

    /* Stacked items need more air than the desktop 24px, otherwise each
       item's media bleeds into the next item's heading. */
    .advantages-list {
      gap: var(--space-m);
    }

    .advantage-item {
      flex-direction: column;
      /* The desktop row pins children to flex-start; stacked, that
         shrink-wraps the media column to its content width — images render
         at intrinsic size pinned left, and video frames (whose players are
         absolutely positioned and contribute no intrinsic size) collapse to
         zero. Stretch keeps media visible at full width. */
      align-items: stretch;
    }

    .item-text {
      padding-right: 0;
    }
  }
</style>
