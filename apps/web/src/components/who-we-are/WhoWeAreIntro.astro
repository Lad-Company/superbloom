---
import {type Media} from '../MediaFrame.astro';
import ParallaxStatement from '../ParallaxStatement.astro';

/* Thin wrapper around the shared ParallaxStatement section (see D2): the
   Who We Are intro adopts the home/zine ParallaxField look; the old
   PointerFollowMedia cursor-trailing cluster is sunset. */
interface Props {
  statement: string;
  media?: (Media | null)[];
  showImageLayers?: boolean | null;
}
const { statement, media = [], showImageLayers } = Astro.props;
---

<ParallaxStatement role="dark" headline={statement} media={media} showLayers={showImageLayers} />
