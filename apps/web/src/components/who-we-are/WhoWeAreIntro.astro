---
import {type Media} from '../MediaFrame.astro';
import ParallaxStatement from '../ParallaxStatement.astro';

/* Thin wrapper around the shared ParallaxStatement section (see D2): the
   Who We Are intro adopts the home/zine ParallaxField look; the old
   PointerFollowMedia cursor-trailing cluster is sunset. Unlike home/zine,
   its headline takes the compact size — one ramp step down (h3 → h4). */
interface Props {
  statement: string;
  media?: (Media | null)[];
  showImageLayers?: boolean | null;
  /* CMS black/white toggle for the section surface. Unset (existing
     documents) defaults to dark, preserving the pre-toggle appearance. */
  theme?: 'light' | 'dark' | null;
}
const { statement, media = [], showImageLayers, theme } = Astro.props;
---

<ParallaxStatement
  role={theme ?? 'dark'}
  headline={statement}
  media={media}
  showLayers={showImageLayers}
  headlineSize="compact"
  class="who-intro"
/>

<style>
  /* The fact cards below hand off flush (colored bands, no top padding), so
     on mobile this section owns the whole 64px gap instead of the usual 32. */
  @media (--bp-small) {
    :global(.parallax-statement.who-intro) {
      padding-bottom: var(--space-m);
    }
  }
</style>
