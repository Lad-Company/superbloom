---
import PointerFollowMedia from '../PointerFollowMedia.astro';
import { type Media } from '../MediaFrame.astro';

interface Props {
  statement: string;
  media?: (Media | null)[];
}

const { statement, media = [] } = Astro.props;
---

<div class="intro" data-pointer-scope>
  <p class="intro-statement type-h4">{statement}</p>
  <PointerFollowMedia media={media} />
</div>

<style>
  .intro {
    position: relative;
    padding: var(--space-4xl) var(--page-inset);
    overflow: hidden;
  }

  .intro-statement {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 24ch;
  }

  @media (max-width: 768px) {
    .intro {
      padding: var(--space-2xl) var(--space-3xs);
    }

    .intro :global(.pointer-follow) {
      display: none;
    }
  }
</style>
