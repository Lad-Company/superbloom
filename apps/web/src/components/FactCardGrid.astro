---
import Metric from './Metric.astro';
import SurfaceSection from './SurfaceSection.astro';

interface FactCard {
  _key?: string;
  label: string | null;
  value?: string | null;
  description?: string | null;
  items?: string[] | null;
}

interface Props {
  cards: FactCard[];
}

const { cards } = Astro.props;
const surfaceRoles = ['brand-muted', 'brand-deep', 'brand-accent'] as const;
---

<div class="fact-card-grid" data-fact-card-grid>
  {cards.map((card, index) => {
    const role = surfaceRoles[index % surfaceRoles.length];

    return (
      <SurfaceSection role={role} class="fact-card">
        <h2 class="label type-h5">{card.label}</h2>
        <div class="body">
          {card.value && <Metric value={card.value} />}
          {card.description && <p class="description type-caption">{card.description}</p>}
          {card.items && card.items.length > 0 && (
            <ul class="items type-body">
              {card.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      </SurfaceSection>
    );
  })}
</div>

<script>
  import { revealStats } from '../lib/motion';

  const cleanups: Array<() => void> = [];
  const initGrids = () =>
    document.querySelectorAll<HTMLElement>('[data-fact-card-grid]').forEach((grid) => {
      if (grid.dataset.statsInitialized) return;
      grid.dataset.statsInitialized = 'true';
      // Static cards: skip the slide-up entrance, keep the stat count-up.
      const destroy = revealStats(grid, '.fact-card', {entrance: false});
      cleanups.push(() => {
        destroy();
        delete grid.dataset.statsInitialized;
      });
    });

  const cleanupAll = () => cleanups.splice(0).forEach((cleanup) => cleanup());

  // Deferred by Layout until after the hero reveal: the revealStats triggers
  // are once:true, so arming them on settled layout + scroll position keeps
  // the count-up from firing during load — it plays when the section enters.
  document.addEventListener('sbh:motion-deferred', initGrids);
  document.addEventListener('astro:before-swap', cleanupAll);
</script>

<style>
  .fact-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  :global(.fact-card) {
    display: flex;
    flex-direction: column;
    /* Anchor the value/list block to the card bottom so stat items stay
       bottom-aligned across cards regardless of how many lines each block
       runs (the clients list is far taller than the value+description
       blocks). */
    justify-content: space-between;
    min-width: 0;
    min-height: 600px;
    padding: var(--space-xs);
  }

  :global(.fact-card .label),
  :global(.fact-card .description) {
    margin: 0;
  }

  :global(.fact-card .body) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  :global(.fact-card .description) {
    max-width: 32ch;
  }

  :global(.fact-card .items li) {
    margin: 0;
  }

  :global(.fact-card .body .value) {
    display: block;
    /* Fact numbers ride the shared type-h2 ramp (140 cap, spec §3.4). */
    font-size: var(--type-h2);
  }

  @media (--bp-small) {
    .fact-card-grid {
      grid-template-columns: 1fr;
    }

    /* Stacked full-width cards keep the bottom-anchored value. Mobile bumps
       the interior vertical padding (12 → 32) so the copy doesn't read
       cramped against the colored card edges; sides keep the 12px gutter. */
    :global(.fact-card) {
      min-height: 320px;
      padding: var(--space-xs) var(--space-3xs);
    }
  }
</style>
