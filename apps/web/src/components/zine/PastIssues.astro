---
import MediaFrame, {type Media} from '../MediaFrame.astro';

interface Issue {
  title?: string | null;
  slug?: string | null;
  eyebrow?: string | null;
  cardMedia?: Media | null;
}

interface Props {
  issues: Issue[];
}

const {issues} = Astro.props;
---

{
  issues.length > 0 && (
    <nav
      class="past-issues"
      aria-labelledby="past-issues-heading"
      data-surface-role="dark"
      style="--bg:#000000;--fg:#ffffff"
    >
      <h2 id="past-issues-heading" class="type-h3">Past Zines</h2>
      <ul>
        {issues.map((issue) => (
          <li>
            <a href={`/zine/issues/${issue.slug}`}>
              <MediaFrame
                media={issue.cardMedia}
                ratio="1:1"
                placement={{context: 'fixed', px: {small: 96, large: 210}}}
                title={issue.title}
              />
              <span class="copy">
                {issue.eyebrow && <span class="type-caption">{issue.eyebrow}</span>}
                <span class="type-h5">{issue.title}</span>
              </span>
              <span class="read-more type-eyebrow underline-draw">Read more</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* No vertical padding: the stories rail above owns the hand-off gap, and
     the last row sits flush against the next section. */
  .past-issues {
    padding: 0;
    background: #000;
    color: #fff;
  }

  h2 {
    margin: 0 0 var(--space-m);
    padding-inline: var(--page-inset);
  }

  ul {
    display: grid;
    gap: 0;
  }

  /* Rows are inset with a hairline divider; the pink band is the hover
     state (Figma Past Zines), not a permanent treatment on any row. The band
     bleeds past the row inset to the viewport edges via a ::before layer. */
  li {
    position: relative;
    margin-inline: var(--page-inset);
    border-top: 1px solid var(--fg-20);
  }

  li::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--page-inset));
    background: var(--pink);
    opacity: 0;
    transition: opacity var(--motion-quick) var(--motion-ease-out);
  }

  li:hover::before {
    opacity: 1;
  }

  /* No hairline across the band's top edge while it shows. */
  li:hover {
    border-top-color: transparent;
  }

  a {
    position: relative;
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
    color: #fff;
    text-decoration: none;
    transition: color var(--motion-quick) var(--motion-ease-out);
  }

  li:hover a {
    color: var(--pink-fg);
  }

  media-frame {
    width: 100%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (--bp-small) {
    .past-issues {
      /* Bottom 32 pairs with the next section's (ContactBand) 32 top for
         the consistent 64px mobile rhythm. */
      padding: var(--space-xs) 0;
    }

    a {
      grid-template-columns: 96px minmax(0, 1fr);
      padding-block: var(--space-3xs);
    }

    .read-more {
      grid-column: 2;
    }
  }
</style>
