---
import MediaFrame, {type Media} from '../MediaFrame.astro';

interface Issue {
  title?: string | null;
  slug?: string | null;
  eyebrow?: string | null;
  cardMedia?: Media | null;
}

interface Props {
  issues: Issue[];
}

const {issues} = Astro.props;
---

{
  issues.length > 0 && (
    <nav class="past-issues" aria-labelledby="past-issues-heading">
      <h2 id="past-issues-heading" class="type-h3">Past Zines</h2>
      <ul>
        {issues.map((issue, index) => (
          <li class:list={{featured: index === 0}}>
            <a href={`/zine/issues/${issue.slug}`}>
              <MediaFrame
                media={issue.cardMedia}
                ratio="1:1"
                placement={{context: 'fixed', px: {small: 96, large: 210}}}
                title={issue.title}
              />
              <span class="copy">
                {issue.eyebrow && <span class="type-caption">{issue.eyebrow}</span>}
                <span class="type-h5">{issue.title}</span>
              </span>
              <span class="read-more type-eyebrow underline-draw">Read more</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* No vertical padding: the stories rail above owns the hand-off gap, and
     the last row sits flush against the next section. */
  .past-issues {
    padding: 0;
    background: #000;
    color: #fff;
  }

  h2 {
    margin: 0 0 var(--space-m);
    padding-inline: var(--page-inset);
  }

  ul {
    display: grid;
    gap: 0;
  }

  /* Non-featured rows are inset with a hairline divider; the featured row's
     pink band bleeds to the section edges (Figma Past Zines). */
  li {
    margin-inline: var(--page-inset);
    border-top: 1px solid var(--fg-25);
  }

  li.featured {
    --item-bg: var(--pink);
    --item-fg: var(--pink-fg);
    margin-inline: 0;
    padding-inline: var(--page-inset);
    border-top: 0;
    background: var(--item-bg);
  }

  a {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
    color: var(--item-fg, #fff);
    text-decoration: none;
  }

  media-frame {
    width: 100%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (--bp-small) {
    .past-issues {
      padding-top: var(--space-xs);
    }

    a {
      grid-template-columns: 96px minmax(0, 1fr);
      padding-block: var(--space-3xs);
    }

    .read-more {
      grid-column: 2;
    }
  }
</style>
