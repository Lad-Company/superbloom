---
import {type Media} from '../MediaFrame.astro'
import ParallaxStatement from '../ParallaxStatement.astro'

/* Thin wrapper around the shared ParallaxStatement section (see D2); the
   zine instance keeps its CTA button and its per-issue fallback layers. */
interface Props {
  heading?: string | null
  imageLayers?: Media[] | null
  fallbackMedia?: Media[]
  ctaLabel?: string | null
  ctaHref: string
  showImageLayers?: boolean | null
}

const {heading, imageLayers, fallbackMedia = [], ctaLabel, ctaHref, showImageLayers} = Astro.props
const resolvedHeading =
  heading ??
  'Original stories, interviews, and visual essays from the creative collective on what helps ideas grow.'
const layers = imageLayers?.length ? imageLayers : fallbackMedia
const resolvedCtaLabel = ctaLabel ?? 'Explore the issue'
---

<ParallaxStatement
  role="dark"
  headline={resolvedHeading}
  media={layers}
  ctaLabel={resolvedCtaLabel}
  ctaHref={ctaHref}
  showLayers={showImageLayers}
/>
