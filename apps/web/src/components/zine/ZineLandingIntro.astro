---
import Button from '../Button.astro'
import {type Media} from '../MediaFrame.astro'
import PointerFollowMedia from '../PointerFollowMedia.astro'
import SurfaceSection from '../SurfaceSection.astro'

interface Props {
  heading?: string | null
  imageLayers?: Media[] | null
  fallbackMedia?: Media[]
  ctaLabel?: string | null
  ctaHref: string
}

const {heading, imageLayers, fallbackMedia = [], ctaLabel, ctaHref} = Astro.props
const resolvedHeading =
  heading ??
  'Original stories, interviews, and visual essays from the creative collective on what helps ideas grow.'
const resolvedImageLayers = imageLayers ?? []
const layers = (resolvedImageLayers.length > 0 ? resolvedImageLayers : fallbackMedia).slice(0, 4)
const resolvedCtaLabel = ctaLabel ?? 'Explore the issue'
---

<SurfaceSection
  role="dark"
  class="zine-landing-intro"
  data-pointer-scope
  aria-labelledby="zine-landing-intro-heading"
>
  <PointerFollowMedia media={layers} class="zine-media" />

  <div class="content">
    <h2 id="zine-landing-intro-heading">{resolvedHeading}</h2>
    <Button href={ctaHref} label={resolvedCtaLabel} target="_blank" rel="noopener noreferrer" />
  </div>
</SurfaceSection>

<style>
  .zine-landing-intro {
    position: relative;
    display: flex;
    align-items: start;
    min-height: clamp(460px, 56vw, 760px);
    overflow: hidden;
    padding: var(--space-4xl) var(--page-inset) var(--space-l);
    isolation: isolate;
  }

  .zine-landing-intro :global(.pointer-follow.zine-media) {
    z-index: 0;
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-xs);
    width: 100%;
  }

  h2 {
    width: 100%;
    max-width: none;
    margin: 0;
    font-family: var(--font-display-tight);
    /* Mid-page statement rides the shared type-h3 ramp (spec §3.4: snapped
       from a bespoke 128 cap to the canonical 120 step). */
    font-size: var(--type-h3);
    font-weight: 750;
    line-height: 0.88;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .zine-landing-intro {
      min-height: 580px;
      padding: var(--space-2xl) var(--page-inset) var(--space-m);
    }

    h2 {
      width: 100%;
      max-width: none;
    }
  }
</style>
