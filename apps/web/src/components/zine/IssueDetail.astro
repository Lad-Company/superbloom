---
import MediaFrame, {type Media} from '../MediaFrame.astro'
import Button from '../Button.astro'
import PageHero from '../PageHero.astro'
import SurfaceSection from '../SurfaceSection.astro'
import CardCarousel from '../CardCarousel.astro'
import PortableText from '../PortableText.astro'
import TagList from '../TagList.astro'
import ZineLandingIntro from './ZineLandingIntro.astro'
import ZineArticleCard from './ZineArticleCard.astro'
import PastIssues from './PastIssues.astro'
import type {TypedObject} from 'astro-portabletext/types'
import type {
  CardWidth,
  ContentCardSettingsInput,
  InfoPosition,
  MediaAspectRatio,
  PartialContentCardSettings,
} from '../../lib/contentCard'

type TextBlock = TypedObject & {children?: Array<{text?: string | null}>}
type Tag = {title?: string | null; color?: string | null}
type Article = {
  title?: string | null
  slug?: string | null
  overview?: TextBlock[] | null
  publicationDate?: string | null
  cardWidth?: CardWidth | null
  mediaAspectRatio?: MediaAspectRatio | null
  infoPosition?: InfoPosition | null
  cardMedia?: Media | null
  tags?: Tag[] | null
}
type PastIssue = {
  title?: string | null
  slug?: string | null
  cardMedia?: Media | null
}

interface Props {
  issue: {
    title?: string | null
    slug?: string | null
    eyebrow?: string | null
    cardMedia?: Media | null
    heroMedia?: Media | null
    editorLetter?: {
      labels?: string[] | null
      heading?: string | null
      body?: TextBlock[] | null
      media?: Media | null
      ctaLabel?: string | null
    } | null
    articles?: Article[] | null
    listDefaults?: PartialContentCardSettings
    articleOverrides?: Array<{articleId?: string | null} & ContentCardSettingsInput> | null
    issuuUrl?: string | null
    pdfUrl?: string | null
    globalCardDefaults?: PartialContentCardSettings
  }
  pastIssues?: PastIssue[]
  landingIntro?: {
    heading?: string | null
    imageLayers?: Media[] | null
    fallbackMedia?: Media[]
    ctaLabel?: string | null
    ctaHref: string
  }
}

const {issue, pastIssues = [], landingIntro} = Astro.props
const articles = issue.articles ?? []
const editorLetterLabels = issue.editorLetter?.labels?.map((title) => ({title}))
const readZineHref = issue.pdfUrl ?? issue.issuuUrl ?? null
const overrideFor = (id?: string | null) =>
  issue.articleOverrides?.find((override) => override.articleId === id)
---

<article class="issue-detail">
  <PageHero
    heading={issue.title ?? ''}
    eyebrow={issue.eyebrow}
    media={issue.heroMedia}
    mediaRatio="16:9"
  />

  {landingIntro && <ZineLandingIntro {...landingIntro} />}

  {
    issue.editorLetter && (
      <section class="editor-letter" aria-labelledby="editor-letter-heading">
        <div class="editor-letter-media">
          <MediaFrame
            media={issue.editorLetter.media ?? issue.heroMedia}
            ratio="1:1"
            sizes="(max-width: 1023.98px) 100vw, 50vw"
            title={issue.editorLetter.heading}
          >
            <TagList slot="overlay" tags={editorLetterLabels} />
          </MediaFrame>
        </div>
        <div class="editor-letter-copy">
          <h2 id="editor-letter-heading" class="type-h3">
            {issue.editorLetter.heading}
          </h2>
          {issue.editorLetter.body && (
            <PortableText value={issue.editorLetter.body} class="type-body" />
          )}
          {issue.editorLetter.ctaLabel && readZineHref && (
            <Button
              href={readZineHref}
              label={issue.editorLetter.ctaLabel}
              target="_blank"
              rel="noopener noreferrer"
            />
          )}
        </div>
      </section>
    )
  }

  <SurfaceSection role="dark" class="stories" aria-labelledby="stories-heading">
    {
      issue.slug && (
        <CardCarousel class="article-rail" label="More stories" heading="More stories" scrollJack={false}>
          {articles.map((article) => (
            <ZineArticleCard
              article={article}
              issueSlug={issue.slug!}
              settings={overrideFor((article as {_id?: string})._id)}
              listSettings={issue.listDefaults}
              globalSettings={issue.globalCardDefaults}
            />
          ))}
        </CardCarousel>
      )
    }
  </SurfaceSection>

  <PastIssues issues={pastIssues} />
</article>

<style>
  h2 {
    margin: 0;
  }

  .editor-letter {
    display: grid;
    /* True 50/50: media and copy blocks each take half the width. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    /* Min 64px between the columns (page-gutter is 24px). */
    gap: max(var(--space-m), var(--page-gutter));
    padding: clamp(var(--space-3xl), 14vw, var(--space-4xl)) var(--page-inset);
    background: #c3e4d3;
    color: #000;
  }

  .editor-letter-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-xs);
    max-width: 540px;
  }

  /* Trim line-box slack (heading descent reserve, body half-leading) so the
     32px flex gap reads as the true glyph-to-glyph distance between heading,
     body, and CTA. Progressive enhancement: unsupported browsers keep the
     untrimmed box gap. */
  .editor-letter-copy h2 {
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .editor-letter-copy :global(.portable-text) {
    max-width: 480px;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .editor-letter-copy :global(.portable-text p) {
    margin: 0 0 var(--space-xs);
  }

  .editor-letter-copy :global(.portable-text p:last-child) {
    margin-bottom: 0;
  }

  .editor-letter-media :global(.tag-list) {
    --bg: #000;
    --border-subtle: 0;
    --frosted-layer: #000;
  }

  .stories {
    padding: var(--space-4xl) var(--page-inset);
  }

  :global(.article-rail) {
    margin-top: var(--space-xl);
  }

  :global(.article-rail .rail) {
    margin-right: calc(-1 * var(--page-inset));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (--bp-below-desktop) {
    .editor-letter {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }

    .editor-letter-copy {
      max-width: none;
    }
  }

  @media (--bp-small) {
    .editor-letter {
      padding-block: var(--space-xs);
    }

    .stories {
      padding-block: var(--space-xs);
    }

    /* The section padding owns the top rhythm on mobile; the rail's desktop
       96px margin would double it. */
    :global(.article-rail) {
      margin-top: 0;
    }
  }
</style>
