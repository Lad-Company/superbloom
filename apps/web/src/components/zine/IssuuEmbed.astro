---
import {issuuEmbedUrl} from '../../lib/issuu'

interface Props {
  title?: string | null
  eyebrow?: string | null
  issuuUrl?: string | null
}

const {title, eyebrow, issuuUrl} = Astro.props
const heading = title ?? 'Zine'
const embedUrl = issuuEmbedUrl(issuuUrl)

// No sandbox attribute on the iframe: ISSUU's reader breaks inside a
// sandboxed frame (their own oEmbed output omits it).
---

<section class="issuu-page" aria-labelledby="issuu-page-heading">
  <header class="sr-only">
    {eyebrow && <p>{eyebrow}</p>}
    <h1 id="issuu-page-heading">{heading}</h1>
  </header>
  {
    embedUrl ? (
      <iframe
        class="embed-frame"
        src={embedUrl}
        title={`${heading} — ISSUU flipbook`}
        allow="clipboard-write"
        allowfullscreen={true}></iframe>
    ) : (
      <p class="fallback type-body">This issue is not available to read online yet.</p>
    )
  }
</section>

<style>
  /* Full-screen takeover: the flipbook fills the viewport edge to edge, no
     gutters, no header. Padding (not margin) offsets the reader past the
     overlay nav so the dark surface extends behind it. */
  .issuu-page {
    width: 100vw;
    height: 100vh;
    padding-top: var(--nav-height);
    background: #000;
    color: #fff;
  }

  @supports (height: 100dvh) {
    .issuu-page {
      height: 100dvh;
    }
  }

  .embed-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
  }

  .fallback {
    display: grid;
    place-items: center;
    height: 100%;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
