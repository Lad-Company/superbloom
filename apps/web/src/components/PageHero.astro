---
import MediaFrame, { type Media } from './MediaFrame.astro';
import { control } from '../lib/surfaceRole';

interface Props {
  heading: string;
  eyebrow?: string | null;
  tags?: string[];
  subheading?: string | null;
  media?: Media | null;
  /** Heading type scale: default h1 (200px); h3 (120px) for compact headers. */
  headingSize?: 'h1' | 'h3';
  /** Media hero aspect variant: home 3/2, zine 16:9 (capped at 90svh). */
  mediaRatio?: '3:2' | '16:9';
  id?: string;
}

const { heading, eyebrow, tags, subheading, media, headingSize = 'h1', mediaRatio = '3:2', id } =
  Astro.props;

const headingClass = ['hero-heading', `type-${headingSize}`, headingSize !== 'h1' && 'hero-heading-compact'];

// Layout mode derives from props: media → media hero (home); eyebrow/tags →
// case hero (work/[slug]); otherwise the plain text hero (work, who-we-are,
// index).
const isMedia = Boolean(media);
const isCase = !isMedia && (Boolean(eyebrow) || Boolean(tags && tags.length > 0));
---

{
  isMedia ? (
    <section class:list={['hero-media', `ratio-${mediaRatio.replace(':', '-')}`]} style={control.onDark}>
      <MediaFrame media={media} ratio="fill" sizes="100vw" title={heading} priority>
        <div class="scrim"></div>
        <div class="overlay">
          <div class="heading-stack">
            {eyebrow && <p class="hero-kicker">{eyebrow}</p>}
            <h1 id={id} class:list={headingClass} data-motion-text data-unit="chars" data-scroll="false">{heading}</h1>
          </div>
          {subheading && <p class="type-caption sub">{subheading}</p>}
        </div>
      </MediaFrame>
    </section>
  ) : isCase ? (
    <header class="hero-case">
      {eyebrow && <p class="case-eyebrow type-h5">{eyebrow}</p>}
      <h1 id={id} class:list={headingClass} data-motion-text data-unit="chars" data-scroll="false">{heading}</h1>
      {tags && tags.length > 0 && (
        <ul class="case-tags type-label" aria-label="Capabilities">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>
  ) : (
    <section class="hero-text">
      <h1 id={id} class:list={headingClass} data-motion-text data-unit="chars" data-scroll="false">{heading}</h1>
    </section>
  )
}

<style>
  /* Shared H1 — desktop is the Figma 200px/78% type-h1 token; below 1024 it
     scales with the viewport with no x-overflow. The type-h1 shortcut also
     applies line-clamp-4 from Uno; we override it here so long hero titles
     (e.g. "Superbloom House's 5th-Birthday Move? Open a Shop and Give the
     Artists All The…") wrap to every line instead of truncation. */
  .hero-heading {
    margin: 0;
    max-width: 21ch;
    display: block;
    overflow: visible;
  }

  @media (max-width: 1023px) {
    .hero-heading {
      max-width: none;
      font-size: clamp(64px, 18vw, 160px);
    }

    .hero-heading-compact {
      font-size: clamp(48px, 12vw, 120px);
    }
  }

  /* Text hero — top padding clears the overlay nav so there is a true 160px of
     visible space above the heading; bottom is 0 so the following section owns
     the header→content hand-off (96px on the browse/detail pages). */
  .hero-text {
    padding: calc(var(--nav-height) + var(--space-3xl)) var(--page-inset) 0;
  }

  @media (max-width: 1023px) {
    /* Mobile text hero anchors the heading at the bottom of the section so
       the min-height empty band sits at the top instead of below the
       heading — gives Work, Who We Are, Shop, and News Index a tight
       hand-off into the page below and a deliberate hero moment above. */
    .hero-text {
      display: flex;
      min-height: 60svh;
      flex-direction: column;
      justify-content: flex-end;
      padding: var(--space-xl) var(--space-3xs) var(--space-xs);
    }
  }

  /* Media hero (home 3/2, zine 16:9 capped) */
  .hero-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: clip;
    color: var(--bg);
  }

  /* Ratio variants apply on desktop only: scoped to min-width so this 0,2,0
     rule can't outspecificity the single-class mobile reset below (which sets
     aspect-ratio: auto and lets min-height: 100svh drive the section). */
  @media (min-width: 1024px) {
    .hero-media.ratio-16-9 {
      aspect-ratio: 16 / 9;
      max-height: 90svh;
    }
  }

  .hero-media :global(media-frame) {
    position: absolute;
    inset: 0;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.35));
    pointer-events: none;
  }

  .overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--page-gutter);
    align-items: end;
    padding: var(--space-l) var(--page-inset);
    pointer-events: none;
  }

  .overlay .heading-stack {
    grid-column: 1 / 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /* Super-header kicker above the H1 (e.g. zine "Issue No. 5"). Scales with
     the hero type ramp: 56px at the 1440 design width. */
  .hero-kicker {
    margin: 0;
    font-family: var(--font-display-tight);
    font-size: clamp(32px, 3.9vw, 56px);
    font-weight: 750;
    line-height: 0.88;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .sub {
    grid-column: 3;
    margin: 0;
    align-self: end;
  }

  @media (max-width: 1023px) {
    .hero-media {
      aspect-ratio: auto;
      min-height: 100svh;
      max-height: none;
    }

    .overlay {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-s);
      padding: var(--space-3xs);
    }

    .overlay .heading-stack,
    .sub {
      grid-column: 1;
    }
  }

  /* Case hero (work/[slug]) — eyebrow → heading → tags, top-anchored inside
     the case-primary surface. Height is content-driven (no min-height) and the
     tags sit flush to the bottom edge, so the following lead media's own 32px
     top padding is the entire header→media hand-off (Figma case hero). Top
     padding clears the overlay nav for a true 160px above the eyebrow. */
  .hero-case {
    display: flex;
    flex-direction: column;
    padding: calc(var(--nav-height) + var(--space-3xl)) var(--page-inset) 0;
  }

  .case-eyebrow {
    margin: 0 0 var(--space-s);
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs-4);
    margin: var(--space-l) 0 0;
  }

  .case-tags li {
    padding: var(--space-xs-4);
    border: 1px solid currentColor;
    border-radius: var(--radius-control);
  }

  @media (max-width: 767px) {
    /* Mobile case hero (Figma 375 symbol): 96px top (below the nav), 12px
       sides, 32px eyebrow→heading, 64px heading→tags, tags flush to the bottom
       edge so the lead media's 32px top padding is the whole hand-off. */
    .hero-case {
      padding: calc(var(--nav-height) + var(--space-xl)) var(--space-3xs) 0;
    }

    .case-eyebrow {
      margin-bottom: var(--space-xs);
      font-size: 32px;
    }

    .case-tags {
      margin-top: var(--space-m);
      font-size: 15px;
    }
  }
</style>
