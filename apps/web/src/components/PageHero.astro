---
import MediaFrame, { type Media } from './MediaFrame.astro';
import { control } from '../lib/surfaceRole';

interface Props {
  heading: string;
  eyebrow?: string | null;
  tags?: string[];
  subheading?: string | null;
  media?: Media | null;
  /** Heading type scale: default h1 (200px); h3 (120px) for compact headers. */
  headingSize?: 'h1' | 'h3';
  /** Media hero aspect variant: home 3/2, zine 16:9 (capped at 90svh). */
  mediaRatio?: '3:2' | '16:9';
  /**
   * Play the per-character Type Reveal on the heading. Reserved for navbar /
   * sitemap destinations (home, work, who-we-are, index, zine, shop); detail
   * routes pass false so their headings render immediately.
   */
  reveal?: boolean;
  id?: string;
}

const {
  heading,
  eyebrow,
  tags,
  subheading,
  media,
  headingSize = 'h1',
  mediaRatio = '3:2',
  reveal = true,
  id,
} = Astro.props;

const headingClass = ['hero-heading', `type-${headingSize}`];
// Without data-motion-text the heading is never hidden by motion.css, so a
// non-revealing hero is fully static (no JS work, no fallback timer).
const revealAttrs = reveal ? {'data-motion-text': true, 'data-unit': 'chars', 'data-scroll': 'false'} : {};

// Layout mode derives from props: media → media hero (home); eyebrow/tags →
// case hero (work/[slug]); otherwise the plain text hero (work, who-we-are,
// index).
const isMedia = Boolean(media);
const isCase = !isMedia && (Boolean(eyebrow) || Boolean(tags && tags.length > 0));
---

{
  isMedia ? (
    <section
      class:list={['hero-media', `ratio-${mediaRatio.replace(':', '-')}`]}
      style={control.onDark}
      data-nav-surface="dark"
    >
      <MediaFrame media={media} ratio="fill" placement={{context: 'hero'}} title={heading}>
        <div class="scrim"></div>
        <div class="overlay">
          <div class="heading-stack">
            {eyebrow && <p class="type-section-heading hero-kicker">{eyebrow}</p>}
            <h1 id={id} class:list={headingClass} {...revealAttrs}>{heading}</h1>
          </div>
          {subheading && <p class="type-caption sub">{subheading}</p>}
        </div>
      </MediaFrame>
    </section>
  ) : isCase ? (
    <header class="hero-case">
      {eyebrow && <p class="case-eyebrow type-h5">{eyebrow}</p>}
      <h1 id={id} class:list={headingClass} {...revealAttrs}>{heading}</h1>
      {tags && tags.length > 0 && (
        <ul class="case-tags type-label" aria-label="Tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>
  ) : (
    <section class="hero-text">
      <h1 id={id} class:list={headingClass} {...revealAttrs}>{heading}</h1>
    </section>
  )
}

<style>
  /* Shared H1 — rides the fluid type-h1/type-h3 ramp tokens (one continuous
     360→1440 curve, no 1024 snap). The shortcut also applies line-clamp-4
     from Uno; we override it here so long hero titles (e.g. "Superbloom
     House's 5th-Birthday Move? Open a Shop and Give the Artists All The…")
     wrap to every line instead of truncation. */
  .hero-heading {
    margin: 0;
    /* 28ch floor: titles get at least ~28 characters of flow per line before
       wrapping (the old 21ch broke even mid-length titles too early). */
    max-width: 28ch;
    display: block;
    overflow: visible;
    /* Balance multi-line headings so a long CMS title can't strand a lone
       word ("the") on its own line. Plain CSS for non-revealed heroes; for
       the char-split reveal it shapes the layout split-type measures at
       split/resplit time. */
    text-wrap: balance;
  }

  @media (--bp-below-desktop) {
    .hero-heading {
      max-width: none;
    }
  }

  /* Text hero — top padding clears the overlay nav so there is a true 160px of
     visible space above the heading; bottom is 0 so the following section owns
     the header→content hand-off (96px on the browse/detail pages). */
  .hero-text {
    padding: calc(var(--nav-height) + var(--space-3xl)) var(--page-inset) 0;
  }

  @media (--bp-below-desktop) {
    /* Mobile text hero is top-anchored like the case hero: a fixed
       nav + 3xl clearance above the heading on every page. (The old 60svh
       bottom-anchored band made the void content-dependent, so /index read
       taller than /work and /who-we-are.) Bottom 32 pairs with the next
       section's 32 for the consistent 64px hand-off. */
    .hero-text {
      padding: calc(var(--nav-height) + var(--space-3xl)) var(--page-inset) var(--space-xs);
    }
  }

  /* Media hero (home 3/2, zine 16:9 capped) */
  .hero-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: clip;
    color: var(--bg);
  }

  /* Ratio variants apply on desktop only: scoped to min-width so this 0,2,0
     rule can't outspecificity the single-class mobile reset below (which sets
     aspect-ratio: auto and lets min-height: 100svh drive the section). */
  @media (--bp-desktop) {
    .hero-media.ratio-16-9 {
      aspect-ratio: 16 / 9;
      max-height: 90svh;
      /* Definite width: aspect-ratio transfers a max-height constraint to an
         automatic width (acting as max-width: 160svh), which shrank the hero
         off the right edge on viewports wider than 1.6:1 (white strip). */
      width: 100%;
    }
  }

  .hero-media :global(media-frame) {
    position: absolute;
    inset: 0;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.35));
    pointer-events: none;
  }

  .overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--page-gutter);
    align-items: end;
    padding: var(--space-l) var(--page-inset);
    pointer-events: none;
  }

  /* The heading spans the full overlay width (Figma home hero: the headline
     box runs edge to edge). The old 2/3 column forced real-length titles
     into tall 4-line stacks with orphaned words at desktop sizes; full width
     plus text-wrap: balance keeps them on few, even lines. */
  .overlay .heading-stack {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /* Super-header kicker above the H1 (e.g. zine "Issue No. 5"). Rides the
     shared type-section-heading ramp via the Uno class in the markup. */
  .hero-kicker {
    margin: 0;
  }

  /* The intro sits on its own row below the now-full-width heading (still
     the right-hand column), so a long final heading line can never run
     under it. */
  .sub {
    grid-column: 3;
    grid-row: 2;
    margin: 0;
    align-self: end;
  }

  @media (--bp-below-desktop) {
    .hero-media {
      aspect-ratio: auto;
      min-height: 100svh;
      max-height: none;
    }

    /* Mobile media hero: 24px between stacked hero items (heading ↔ subcopy;
       kicker ↔ heading already uses --space-2xs in .heading-stack) and 64px
       beneath the last item so more media shows before the section edge. */
    .overlay {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
      padding: var(--space-3xs) var(--page-inset) var(--space-m);
    }

    .overlay .heading-stack,
    .sub {
      grid-column: 1;
    }
  }

  /* Case hero (work/[slug]) — eyebrow → heading → tags, top-anchored inside
     the case-primary surface. Height is content-driven (no min-height) and the
     tags sit flush to the bottom edge, so the following lead media's own 32px
     top padding is the entire header→media hand-off (Figma case hero). Top
     padding clears the overlay nav for a true 160px above the eyebrow. */
  .hero-case {
    display: flex;
    flex-direction: column;
    padding: calc(var(--nav-height) + var(--space-3xl)) var(--page-inset) 0;
  }

  .case-eyebrow {
    margin: 0 0 var(--space-s);
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs-4);
    margin: var(--space-l) 0 0;
  }

  .case-tags li {
    padding: var(--space-xs-4);
    border: 1px solid var(--fg-20);
    border-radius: var(--radius-control);
  }

  @media (--bp-small) {
    /* Mobile case hero (Figma 375 symbol): 96px top (below the nav), 12px
       sides, 32px eyebrow→heading, 64px heading→tags, tags flush to the bottom
       edge so the lead media's 32px top padding is the whole hand-off. */
    .hero-case {
      padding: calc(var(--nav-height) + var(--space-xl)) var(--page-inset) 0;
    }

    .case-eyebrow {
      margin-bottom: var(--space-xs);
    }

    .case-tags {
      margin-top: var(--space-m);
      font-size: 15px;
    }
  }
</style>
