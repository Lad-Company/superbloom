---
import SurfaceSection from './SurfaceSection.astro'
import PageGrid from './PageGrid.astro'
import Button from './Button.astro'
import SelectDropdown from './SelectDropdown.astro'

type ContactSurfaceRole = 'brand-accent' | 'brand-deep' | 'brand-muted' | 'brand-tertiary'

interface Props {
  role: ContactSurfaceRole
}

const {role} = Astro.props
---

<SurfaceSection id="contact" role={role}>
  <section class="contact-band" aria-labelledby="contact-heading">
    <PageGrid class="contact-grid">
      <div class="page-grid-item contact-left">
        <h2 id="contact-heading" class="type-h5">
          Got a challenge that's too interesting for a normal agency?<br /><br />Let's talk.
        </h2>
      </div>
      <div class="page-grid-item contact-right">
        <form class="contact-form" id="contact-form">
          <div class="fields">
            <SelectDropdown
              name="inquiryType"
              label="Inquiry type"
              placeholder="Inquiry type*"
              required
              filled
              options={[
                {value: 'agency-partner', label: 'I am a brand looking for an agency partner'},
                {value: 'creator', label: 'I am a Creator'},
                {value: 'press', label: 'I am press / media'},
                {value: 'other', label: 'Other'},
              ]}
            />
            <label class="sr-only" for="contact-name">Name</label>
            <input
              class="input"
              id="contact-name"
              type="text"
              name="name"
              placeholder="Name*"
              autocomplete="name"
              required
            />
            <label class="sr-only" for="contact-email">Email address</label>
            <input
              class="input"
              id="contact-email"
              type="email"
              name="email"
              placeholder="Email*"
              autocomplete="email"
              required
            />
            <SelectDropdown
              name="hearAboutUs"
              label="How did you hear about us?"
              placeholder="How did you hear about us?*"
              required
              options={[
                {value: 'referral', label: 'Referral'},
                {value: 'instagram', label: 'Instagram'},
                {value: 'linkedin', label: 'LinkedIn'},
                {value: 'google', label: 'Google'},
                {value: 'event', label: 'Event'},
                {value: 'other', label: 'Other'},
              ]}
            />
            <label class="sr-only" for="contact-message">Message</label>
            <textarea
              class="input input--message"
              id="contact-message"
              name="message"
              placeholder="Message*"
              rows="3"
              required></textarea>
            <input
              class="honeypot"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <input type="hidden" name="startedAt" />
          </div>
          <div class="contact-actions">
            <Button as="button" type="submit" label="Submit" class="btn-submit" />
            <p class="status" id="contact-status" aria-live="polite" role="status"></p>
          </div>
        </form>
      </div>
    </PageGrid>
  </section>
</SurfaceSection>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const status = document.getElementById('contact-status')
  const startedAt = form?.elements.namedItem('startedAt') as HTMLInputElement | null

  if (startedAt) startedAt.value = String(Date.now())

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!form.reportValidity()) return

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement
    button.disabled = true
    if (status) status.textContent = ''

    try {
      const response = await fetch('/api/contact', {method: 'POST', body: new FormData(form)})
      const data = (await response.json()) as {success?: boolean; error?: string}
      if (!data.success) throw new Error(data.error ?? 'Unknown error')
      form.reset()
      if (startedAt) startedAt.value = String(Date.now())
      if (status) {
        status.textContent = 'Thanks — we’ll be in touch.'
        status.classList.remove('status--error')
        status.classList.add('status--ok')
      }
    } catch {
      if (status) {
        status.textContent = 'Something went wrong. Please try again.'
        status.classList.add('status--error')
        status.classList.remove('status--ok')
      }
    } finally {
      button.disabled = false
    }
  })
</script>

<style>
  .contact-band {
    padding-block: var(--space-4xl);
  }
  .contact-grid {
    align-items: start;
  }
  .contact-left {
    padding-right: var(--space-xl);
  }
  /* Headline rides the shared fluid type-h5 ramp via the Uno class. */
  .type-h5 {
    margin: 0;
  }
  .contact-form,
  .fields {
    display: flex;
    flex-direction: column;
  }
  .contact-form {
    gap: var(--space-xs);
  }
  .fields {
    gap: var(--space-3xs);
  }
  .contact-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .status {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
  }
  .status--ok {
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }
  .status--error {
    color: #ff6b6b;
  }
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (--bp-below-desktop) {
    .contact-band {
      padding-block: var(--space-3xl);
    }
    .contact-left {
      padding-right: var(--space-2xs);
    }
  }
  @media (--bp-small) {
    .contact-band {
      padding-block: var(--space-xs);
    }
    .contact-left {
      padding-right: 0;
    }
  }
</style>
