---
import {buildImageRendering, type CropRatio} from '../lib/imageCropping'
import {
  HERO_POSTER_WIDTHS,
  muxPosterRendering,
  muxSkeletonThumbUrl,
  planMediaRendering,
  progressiveLoopSources,
  type MediaPlacement,
  type MuxMaxResolution,
  type StaticRenditionRef,
} from '../lib/mediaRenderingPlan'
import {muxBlurUpDataUri} from '../lib/muxBlurUp'

export type MediaRatio = CropRatio

export interface ImageProjection {
  _type: 'image'
  asset?: {_ref?: string | null; _type?: string | null} | null
  crop?: {
    top?: number | null
    bottom?: number | null
    left?: number | null
    right?: number | null
  } | null
  hotspot?: {x?: number | null; y?: number | null; width?: number | null; height?: number | null} | null
  width?: number | null
  height?: number | null
  mimeType?: string | null
  /** Sanity-generated blur-up preview (data URI); drives the frame's
   *  skeleton surface (ARCHITECTURE.md ADR-0039). */
  lqip?: string | null
}

export interface VideoProjection {
  _type: 'mux.video'
  playbackId?: string | null
  aspectRatio?: string | null
  /** Editor-picked poster frame (seconds) on the Mux asset in Sanity;
   *  defaults to time=0 (see muxPosterRendering). */
  thumbTime?: number | null
  /** Ready MP4 static renditions on the Mux asset (projected only where
   *  `status == "ready"`). Present on the hero loop assets; absent on
   *  everything else, which streams HLS. */
  staticRenditions?: StaticRenditionRef[] | null
}

export type ProjectedAsset = ImageProjection | VideoProjection

export interface Media {
  asset?: ProjectedAsset | null
  /** Curated still for a video asset (ARCHITECTURE.md ADR-0036). When set
   *  on a `mux.video` asset the frame becomes Gated Ambient: dormant until
   *  the visitor reveals it (hover/focus/tap), at which point the poster
   *  zooms in and fades out. When unset the video keeps today's Ambient
   *  autoplay. */
  poster?: ImageProjection | null
  altText?: string | null
  decorative?: boolean | null
}

/** Playback profiles (ARCHITECTURE.md ADR-0035):
 *  - `'none'` (Ambient — cards, background, scroll-driven) renders no controls
 *    and is the default. Visibility-gated muted loop, paused when offscreen,
 *    background-tab, reduced-motion, or `active=false`.
 *  - `'compact'` (rare mid-page featured video) shows the play/pause button
 *    as a free-floating 40px circle bottom-right, no scrubber, no mute toggle.
 *  - `'full'` (Presented — WhoWeAre featured, Case Study lead video) shows the
 *    Media Control Bar: play/pause + scrubber + mute toggle. Visibility-gated
 *    muted loop still applies — the bar adds user override, not ambient
 *    gating.
 */
export type MediaPlaybackProfile = 'none' | 'compact' | 'full'

interface Props {
  media?: Media | null
  ratio?: MediaRatio | null
  /** Where this frame sits in the page composition. The plan derives
   *  `sizes`, poster widths, and the load-priority bundle from it — callers
   *  state the Placement, never the math. */
  placement: MediaPlacement
  title?: string | null
  /** Overrides the placement's load-priority default (heroes eager,
   *  everything else lazy). */
  priority?: boolean
  /** Overrides the placement's Mux rendition cap (ADR-0038) — e.g. Capes
   *  stacks full-viewport ambient loops that never need 1080p. */
  maxResolution?: MuxMaxResolution
  active?: boolean
  /** Render the overlay poster with no `src`/`srcset` (data-* only) so it
   *  fetches nothing until `promotePoster()` is called — used by the Capes
   *  stack, whose eight lazy frames all sit inside the browser's lazy-load
   *  threshold and would otherwise fetch eight thumbnails at first layout. */
  deferPoster?: boolean
  /** Home-hero entrance ceremony (GH #172), three bundled opt-ins:
   *  1. the poster joins the ADR-0039 load crossfade despite the frame's
   *     priority status — the GH #162 exemption exists because priority
   *     posters are the LCP element on /work and /index, but a
   *     full-viewport hero poster is excluded from LCP candidacy (Chrome
   *     112+), so it can dissolve in over the blur-up instead of popping;
   *  2. the poster srcset pins to HERO_POSTER_WIDTHS (two rungs) so every
   *     visitor warms the same on-demand Mux thumbnail URLs;
   *  3. the media layers play a slow scale(1.04 → 1) settle (~1.2s,
   *     compositor-only, off under prefers-reduced-motion).
   *  Only the homepage hero should set this. */
  heroEntrance?: boolean
  controls?: MediaPlaybackProfile
  class?: string
}

const {
  media,
  ratio = '16:9',
  placement,
  title,
  priority: priorityProp,
  maxResolution,
  active = true,
  deferPoster = false,
  heroEntrance = false,
  controls = 'none',
  class: className,
} = Astro.props

const plan = planMediaRendering(
  placement,
  priorityProp === undefined && maxResolution === undefined
    ? undefined
    : {
        ...(priorityProp === undefined ? {} : {priority: priorityProp}),
        ...(maxResolution === undefined ? {} : {maxResolution}),
      },
)
const frameSizes = plan.sizes

const ratioMap: Record<MediaRatio, string> = {
  intrinsic: 'auto',
  '1:1': '1 / 1',
  '16:9': '16 / 9',
  '4:5': '4 / 5',
  '9:16': '9 / 16',
  '3:2': '3 / 2',
  '2:1': '2 / 1',
  fill: 'auto',
}

const asset = media?.asset
const altText = media?.altText
const isDecorative = media?.decorative ?? false
const mediaRatio: MediaRatio = ratio ?? '16:9'
const ratioValue = ratioMap[mediaRatio]
const intrinsicVideoRatio =
  asset?._type === 'mux.video' && asset.aspectRatio?.match(/^\d+:\d+$/)
    ? asset.aspectRatio.replace(':', ' / ')
    : '16 / 9'
const styleAttr =
  mediaRatio === 'fill' || (mediaRatio === 'intrinsic' && asset?._type !== 'mux.video')
    ? ''
    : `aspect-ratio: ${mediaRatio === 'intrinsic' ? intrinsicVideoRatio : ratioValue};`
const hasAsset =
  (asset?._type === 'image' && Boolean(asset.asset?._ref)) ||
  (asset?._type === 'mux.video' && Boolean(asset.playbackId))
const videoPoster =
  asset?._type === 'mux.video' && asset.playbackId
    ? muxPosterRendering(
        asset.playbackId,
        placement,
        asset.thumbTime,
        heroEntrance ? HERO_POSTER_WIDTHS : undefined,
      )
    : undefined
const isVideo = asset?._type === 'mux.video' && Boolean(asset.playbackId)
const showControls = isVideo && controls !== 'none'
const isFullControls = isVideo && controls === 'full'
// Gated Ambient (ARCHITECTURE.md ADR-0036): a curated poster on a video
// asset turns the frame dormant until the card link toggles `revealed`.
const poster = media?.poster
const posterRendering =
  isVideo && poster?.asset?._ref
    ? buildImageRendering({
        source: {
          asset: poster.asset,
          crop: poster.crop ?? undefined,
          hotspot: poster.hotspot ?? undefined,
        },
        mimeType: poster.mimeType,
        nativeWidth: poster.width,
        nativeHeight: poster.height,
        ratio: mediaRatio,
      })
    : null
const isGated = Boolean(isVideo && posterRendering?.src)
// Progressive loop: an ambient hero whose asset ships MP4 renditions plays
// in a plain <video> with the browser's own loader — no mux-video chunk, no
// manifest round trips. Presented (controls) and Gated frames keep HLS: the
// scrubber wants the deeper ABR buffer, and a dormant frame must not
// preload anything.
const loopSources =
  isVideo && plan.progressiveLoop && controls === 'none' && !isGated && asset?._type === 'mux.video'
    ? progressiveLoopSources(asset.playbackId!, asset.staticRenditions)
    : null
const isProgressiveLoop = loopSources !== null
/** Skeleton surface backdrop (ADR-0039): the image asset's own LQIP; for
 *  Gated Ambient video, the curated poster's LQIP (that poster is the layer
 *  that fades in over the skeleton). Ungated video has no LQIP, so it falls
 *  back to a tiny Mux thumbnail (~1-2KB) so big video frames get the same
 *  blur-up instead of a flat gray box — except deferred frames (Capes),
 *  which must fetch nothing until promoted and keep the bare token
 *  skeleton. Every backdrop is a ~20-24px source (Sanity's LQIP is a tiny
 *  JPEG, not a blurred one), so the CSS blurs all of them in proportion to
 *  the frame — see .media-frame__skeleton-image. Priority frames
 *  (heroes) inline that thumb as a data URI fetched at render
 *  (lib/muxBlurUp.ts) so the first frame is already a blur-up, not a bare
 *  token box waiting on a request; the URL stays the fallback. */
const muxSkeletonUrl =
  !deferPoster && asset?._type === 'mux.video' && asset.playbackId && !poster?.lqip
    ? muxSkeletonThumbUrl(asset.playbackId, asset.thumbTime)
    : null
const muxSkeletonInline =
  muxSkeletonUrl && plan.priority && asset?._type === 'mux.video' && asset.playbackId
    ? await muxBlurUpDataUri(asset.playbackId, asset.thumbTime)
    : null
const skeletonBackdrop: string | null =
  asset?._type === 'image'
    ? (asset.lqip ?? null)
    : (poster?.lqip ?? (muxSkeletonUrl ? (muxSkeletonInline ?? muxSkeletonUrl) : null))
// Large-canvas frames (hero / split / full layoutBlock) cap at 1080p for
// desktop, but no phone viewport can resolve that: even 430px at DPR 3 is
// 1290 device px, inside the 720p rung. The element script drops the cap to
// 720p under the small breakpoint before the player upgrades (ADR-0038).
const mobileMaxResolution = plan.maxResolution === '1080p' ? '720p' : undefined
const imageRendering =
  asset?._type === 'image' && asset.asset?._ref
    ? buildImageRendering({
        source: {
          asset: asset.asset,
          crop: asset.crop ?? undefined,
          hotspot: asset.hotspot ?? undefined,
        },
        mimeType: asset.mimeType,
        nativeWidth: asset.width,
        nativeHeight: asset.height,
        ratio: mediaRatio,
      })
    : null
---

<media-frame
  active={active ? true : undefined}
  gated={isGated ? true : undefined}
  data-priority={plan.priority ? true : undefined}
  data-hero-entrance={heroEntrance ? true : undefined}
  data-mobile-max-resolution={mobileMaxResolution}
  class:list={[
    'media-frame',
    className,
    {'media-placeholder': !hasAsset, intrinsic: mediaRatio === 'intrinsic'},
  ]}
  style={styleAttr}
  data-controls={controls}
>
  {
    /* Skeleton surface (ADR-0039): a permanent placeholder filling the
       reserved aspect-ratio box behind every layer, so no frame ever
       paints blank or transparent alt text — token color, upgraded to a
       blur-up (Sanity LQIP inline, or a tiny Mux thumbnail for ungated
       video) wherever the asset offers one. Absolute inside the reserved
       box, so nothing reflows (CLS stays 0). First child: DOM order alone
       keeps it behind every media layer. */
    hasAsset && (
      <div class="media-frame__skeleton" aria-hidden="true">
        {skeletonBackdrop && (
          <div
            class="media-frame__skeleton-image"
            style={`background-image: url('${skeletonBackdrop}')`}
          />
        )}
      </div>
    )
  }
  {
    /* Deferred posters render with data-* instead of src/srcset, so they
       fetch nothing until promotePoster() restores them. `sizes` stays on
       the element so it is already correct when promotion sets the srcset. */
    isVideo && videoPoster && (
      <img
        class="media-frame__poster"
        src={deferPoster ? undefined : videoPoster.src}
        srcset={deferPoster ? undefined : videoPoster.srcset}
        data-src={deferPoster ? videoPoster.src : undefined}
        data-srcset={deferPoster ? videoPoster.srcset : undefined}
        sizes={frameSizes}
        alt=""
        loading={plan.loading}
        fetchpriority={plan.fetchpriority}
        decoding="async"
        aria-hidden="true"
      />
    )
  }
  {
    /* No `poster` attribute, ever: it takes exactly one URL (no srcset), so
       it fetched a second copy of every frame's thumbnail — and WebKit
       ignores `object-fit: cover` on the shadow <video> poster, so the
       browser's own letterboxed 16:9 poster painted on top of the covering
       3:2 overlay image (a visible scale jump, then another when real
       frames started — GH #172). The overlay poster stays painted
       underneath and the player itself sits at opacity 0 until
       `data-video-ready` (a presented frame, not just `playing`), which
       covers the fade-to-first-frame gap the player poster used to guard.
       `playsinline` is load-bearing on iOS: without it Safari throws
       any gesture-driven play() (gated-card reveal tap, Presented play/mute
       buttons) into the fullscreen native player, hijacking the page.
       `disablepictureinpicture` keeps PiP out of the native context menus
       (desktop right-click, iPadOS long-press, the Firefox hover toggle) —
       the frame's custom controls are the whole interface. */
    isProgressiveLoop && loopSources && (
      <video
        class="media-frame__loop"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload={plan.priority ? 'auto' : 'none'}
        aria-hidden="true"
      >
        {loopSources.map((source) => (
          <source src={source.src} type="video/mp4" media={source.media} />
        ))}
      </video>
    )
  }
  {
    isVideo && !isProgressiveLoop && (
      <mux-video
        playback-id={asset?._type === 'mux.video' ? asset.playbackId ?? undefined : undefined}
        metadata-video-title={title ?? undefined}
        stream-type="on-demand"
        muted
        loop
        playsinline
        disablepictureinpicture
        max-resolution={plan.maxResolution}
        preload={plan.preload}
      />
    )
  }
  {
    /* Curated poster (Gated Ambient) — paints above the player and the Mux
       thumbnail, below the overlay slot (DOM order alone, no z-index, so
       TagList overlays stay on top). Zooms in and fades out on `revealed`;
       the video's ready-fade composes underneath. */
    isGated && posterRendering?.src && (
      <img
        class="media-frame__curated-poster"
        src={posterRendering.src}
        srcset={posterRendering.srcset}
        sizes={frameSizes}
        alt={isDecorative ? '' : (altText ?? '')}
        width={posterRendering.width || undefined}
        height={posterRendering.height || undefined}
        loading={plan.loading}
        fetchpriority={plan.fetchpriority}
        decoding="async"
      />
    )
  }
  {
    imageRendering && imageRendering.src && (
      <img
        class="media-frame__image"
        src={imageRendering.src}
        srcset={imageRendering.srcset}
        sizes={frameSizes}
        alt={isDecorative ? '' : (altText ?? '')}
        width={imageRendering.width || undefined}
        height={imageRendering.height || undefined}
        loading={plan.loading}
        fetchpriority={plan.fetchpriority}
      />
    )
  }
  {!hasAsset && <div class="placeholder-content" />}
  {
    /*
     * Controls are rendered before the default slot so any overlay headline /
     * CTA dropped in via <slot /> sits above the bar and stays readable
     * (no shadow, no z-fighting — DOM order alone). On Presented media with
     * no overlay (today's only consumers: WhoWeAre featured & Case Study
     * lead), this is invisible because nothing else fills the slot.
     */
    showControls && isFullControls && (
      <div class="media-controls" data-media-controls>
        <button
          type="button"
          class="media-controls__btn media-controls__btn--play surface-wipe"
          data-media-control
          data-motion-control
          aria-label="Play video"
          aria-pressed="false"
        >
          <span class="media-controls__icon" aria-hidden="true">
            <svg class="icon icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            <svg class="icon icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6 5h4v14H6zm8 0h4v14h-4z" />
            </svg>
          </span>
        </button>
        <div
          class="media-controls__scrubber"
          role="slider"
          tabindex="0"
          aria-label="Seek"
          aria-orientation="horizontal"
          aria-valuemin="0"
          aria-valuemax="0"
          aria-valuenow="0"
          aria-valuetext="0:00 / 0:00"
          data-media-scrubber
        >
          <div class="media-controls__track" data-scrubber-track>
            <div class="media-controls__buffered" data-scrubber-buffered />
            <div class="media-controls__played" data-scrubber-played />
          </div>
          <div class="media-controls__handle" data-scrubber-knob aria-hidden="true" />
        </div>
        <button
          type="button"
          class="media-controls__btn media-controls__btn--mute surface-wipe"
          data-media-mute
          data-motion-control
          aria-label="Unmute video"
          aria-pressed="false"
        >
          <span class="media-controls__icon" aria-hidden="true">
            <svg class="icon icon-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5l-5 4H4z" />
              <path d="M16 9l5 6m0-6l-5 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg class="icon icon-unmuted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5l-5 4H4z" />
              <path d="M16.2 8.8a4.5 4.5 0 0 1 0 6.4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" />
              <path d="M19 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" />
            </svg>
          </span>
        </button>
      </div>
    )
  }
  {
    showControls && !isFullControls && (
      <button
        type="button"
        class="media-control surface-wipe"
        data-media-control
        data-motion-control
        aria-label="Play video"
        aria-pressed="false"
      >
        <span class="media-control__icon" aria-hidden="true">
          <svg class="icon icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg class="icon icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 5h4v14H6zm8 0h4v14h-4z" />
          </svg>
        </span>
      </button>
    )
  }
  <slot />
  <slot name="overlay" />
</media-frame>

<script>
  import { BREAKPOINTS } from '../lib/breakpoints'

  const AUTO_HIDE_MS = 2500
  const SEEK_STEP_S = 5
  /** Time outside [0, duration] that we consider the player still settling. */
  const SCRUBBER_READY_EPSILON_S = 0.05

  /** The `<mux-video>` surface we drive; `_hlsConfig` is the mux-video /
   *  playback-core hook for hls.js options, `_hls` the live hls.js instance
   *  (undefined under native HLS, i.e. Safari/iOS). Only the dev guardrail
   *  reads `_hls.config` — keep it that narrow so dependency upgrades can
   *  only break the guardrail, never playback. */
  type MuxVideoElement = HTMLVideoElement & {
    _hlsConfig?: Record<string, unknown>
    _hls?: {
      config: Record<string, unknown>
    }
    /** Declared optionally so the feature detect narrows correctly even
     *  where lib.dom predates it (Firefox < 132). */
    requestVideoFrameCallback?: (callback: () => void) => number
  }

  /** Startup selection: disable hls.js's lowest-rung bandwidth test and give
   *  ABR a generous default estimate. firstAutoLevel then starts on the
   *  highest rung allowed by the player-size cap (capLevelToPlayerSize,
   *  defaulted on by playback-core with its own MinCapLevelController —
   *  never set the `cap-rendition-to-player-size` attribute, which swaps in
   *  the stock controller and drops `max-resolution` enforcement) instead of
   *  the bottom of the ladder. The estimate only needs to exceed the top
   *  rung of the capped ladder (measured 2026-09-30: 15.8 Mbps at
   *  max_resolution=1080p, 6.2 Mbps at 720p) so the size cap is the sole
   *  selector; measured bandwidth replaces it after the first fragment, so
   *  slow connections still drop for segment two onward. Do NOT write
   *  `capLevelToPlayerSize` here — rely on the playback-core default (the
   *  dev guardrail warns if an upgrade flips it). Safari/iOS play HLS
   *  natively and ignore all of this; only the `max-resolution` URL param
   *  applies there. */
  const STARTUP_HLS_CONFIG = {
    testBandwidth: false,
    abrEwmaDefaultEstimate: 20_000_000,
  }

  /** Constrained startup: same disabled bandwidth test, but a 2 Mbps seed so
   *  firstAutoLevel opens on a low rung and measured bandwidth climbs from
   *  there. Used on save-data, cellular-class connections (2g/3g), and small
   *  viewports — the small-viewport clause doubles as the mobile heuristic
   *  where the Network Information API is absent (Safari) or reports the
   *  downlink, not the user's real budget. A 20 Mbps seed under simulated
   *  throttling opened on the top capped rung and pulled ~17 MB of segments
   *  into one Lighthouse trace (2026-10-01); the first fragment still
   *  replaces the seed with a real measurement, so fast connections upgrade
   *  within a segment or two. */
  const CONSTRAINED_STARTUP_HLS_CONFIG = {
    testBandwidth: false,
    abrEwmaDefaultEstimate: 2_000_000,
  }

  type NetworkInformationLike = { saveData?: boolean; effectiveType?: string; downlink?: number }

  const readConnection = (): NetworkInformationLike | undefined =>
    (navigator as Navigator & { connection?: NetworkInformationLike }).connection

  const cellularClass = (connection: NetworkInformationLike | undefined): boolean =>
    Boolean(
      connection?.saveData ||
        (connection?.effectiveType && ['slow-2g', '2g', '3g'].includes(connection.effectiveType)),
    )

  const constrainedNetwork = (): boolean => {
    if (cellularClass(readConnection())) return true
    return window.matchMedia(`(max-width: ${BREAKPOINTS.smallMax}px)`).matches
  }

  /** The progressive loop has no ABR ladder to fall back on: its 720p
   *  rendition runs ~3.9 Mbps, and on a 1.6 Mbps link it stalled four times
   *  in 30s where HLS downshifted to 480p and played through (CDP probe,
   *  2026-10-06). Under this reported downlink — or on save-data /
   *  cellular-class connections — the hero holds its poster instead of
   *  stuttering. Chrome caps the reported downlink at 10 Mbps, and Safari
   *  has no Network Information API at all, so a missing value means "no
   *  evidence, play". Unlike constrainedNetwork(), viewport size is not a
   *  signal here: a phone on wifi plays the 720p rung fine. */
  const PROGRESSIVE_LOOP_MIN_DOWNLINK_MBPS = 4

  const holdProgressiveLoop = (): boolean => {
    const connection = readConnection()
    if (cellularClass(connection)) return true
    return (
      typeof connection?.downlink === 'number' &&
      connection.downlink < PROGRESSIVE_LOOP_MIN_DOWNLINK_MBPS
    )
  }

  /** Ambient loops are short and cyclic, so the hls.js defaults (30s forward
   *  buffer, unbounded cap growth) download far more of the stream than the
   *  loop can ever show. A flat 10s forward buffer bounds that worst case.
   *  Presented media (controls != 'none') keeps the default buffer —
   *  scrubbing wants the deeper runway. */
  const AMBIENT_HLS_CONFIG = {
    ...STARTUP_HLS_CONFIG,
    maxBufferLength: 10,
    maxMaxBufferLength: 10,
  }

  const CONSTRAINED_AMBIENT_HLS_CONFIG = {
    ...CONSTRAINED_STARTUP_HLS_CONFIG,
    maxBufferLength: 10,
    maxMaxBufferLength: 10,
  }

  /** How far below the viewport a frame may sit before we fetch the mux
   *  chunk — roughly one viewport of scroll runway. */
  const LOAD_ROOT_MARGIN = '100% 0px'

  class MediaFrameElement extends HTMLElement {
    static observedAttributes = ['active', 'revealed']

    private observer: IntersectionObserver | null = null
    private loadObserver: IntersectionObserver | null = null
    private playerLoading: Promise<void> | null = null
    private player: MuxVideoElement | null = null
    private posterImg: HTMLImageElement | null = null
    private curatedPoster: HTMLImageElement | null = null
    private control: HTMLButtonElement | null = null
    private motionPreference: MediaQueryList | null = null
    private isVisible = false
    private userIntent: 'paused' | 'playing' | null = null

    private isFullControls = false
    private scrubberRoot: HTMLElement | null = null
    private playedFill: HTMLElement | null = null
    private bufferedFill: HTMLElement | null = null
    private knob: HTMLElement | null = null
    private mute: HTMLButtonElement | null = null
    private controlsBar: HTMLElement | null = null
    private trackElement: HTMLElement | null = null

    private durationS = 0
    private isDragging = false
    private dragPointerId: number | null = null
    private autoHideTimer: ReturnType<typeof setTimeout> | null = null

    private handleVisibilityChange = () => this.updatePlayback()
    private handleMotionChange = () => this.updatePlayback()
    private handlePlay = () => {
      this.updateControl()
      this.refreshScrubber()
      this.scheduleAutoHide()
    }
    private handlePause = () => {
      this.updateControl()
      this.refreshScrubber()
      this.showControlsBar()
    }
    private handleActivity = () => this.markActivity()
    private handleControlClick = () => this.togglePlayback()
    /** Frame-accurate readiness (GH #172): `playing` only means the playback
     *  pipeline started — Safari (native HLS) fires it before compositing the
     *  first frame, and Chrome can show the same gap for a frame or two, so
     *  stamping on `playing` dissolved the poster onto a blank/gray video.
     *  Stamp only once a frame has actually been presented:
     *  requestVideoFrameCallback where it exists (Chrome, Safari, Firefox
     *  132+), falling back to `playing` + one rAF. The `playing` trigger is
     *  kept so non-playing frames (reduced motion, paused before the first
     *  frame) hold the poster and never mark ready. */
    private handleReady = () => {
      if (this.hasAttribute('data-video-ready')) return
      const stamp = () => this.setAttribute('data-video-ready', '')
      if (this.player && typeof this.player.requestVideoFrameCallback === 'function') {
        this.player.requestVideoFrameCallback(stamp)
      } else {
        requestAnimationFrame(stamp)
      }
    }
    private handleSourceReady = () => this.updatePlayback()
    private handleMuteClick = () => this.toggleMute()
    private handleVolumeChange = () => this.updateMute()
    private handleImgLoad = (event: Event) => {
      const img = event.currentTarget as HTMLImageElement
      img.removeEventListener('load', this.handleImgLoad)
      img.setAttribute('data-loaded', '')
    }

    private handleTimeUpdate = () => this.refreshScrubber()
    private handleDurationChange = () => this.refreshScrubber()
    private handleLoadedMeta = () => this.refreshScrubber()
    private handleProgress = () => this.refreshBuffered()
    private handleSeeked = () => {
      this.refreshScrubber()
      this.scheduleAutoHide()
    }
    private handleScrubberPointerDown = (event: PointerEvent) => this.startScrub(event)
    private handleScrubberKey = (event: KeyboardEvent) => this.onScrubberKey(event)

    connectedCallback() {
      const playerElement = this.querySelector('mux-video') as MuxVideoElement | null
      // Progressive loop: a plain <video> over MP4 renditions. No chunk to
      // import, no hls.js config — the browser's loader already started on
      // the <source> list at parse time (preload="auto" on priority frames).
      const loopElement = this.querySelector('video.media-frame__loop') as MuxVideoElement | null
      if (playerElement) {
        // Small viewports can't resolve 1080p (even 430px at DPR 3 is 1290
        // device px, inside the 720p rung), so drop the rendition cap before
        // the player upgrades — mobile never opens the 15.8 Mbps top rung.
        const mobileMaxResolution = this.dataset.mobileMaxResolution
        if (
          mobileMaxResolution &&
          window.matchMedia(`(max-width: ${BREAKPOINTS.smallMax}px)`).matches
        ) {
          playerElement.setAttribute('max-resolution', mobileMaxResolution)
        }
        // Assign before the element upgrades so the value lands as an own
        // property and playback-core reads it when it builds hls.js — the
        // prototype accessor only exists after `@mux/mux-video` defines the
        // element, which happens on the deferred import below.
        const constrained = constrainedNetwork()
        const startupConfig = constrained ? CONSTRAINED_STARTUP_HLS_CONFIG : STARTUP_HLS_CONFIG
        const ambientConfig = constrained ? CONSTRAINED_AMBIENT_HLS_CONFIG : AMBIENT_HLS_CONFIG
        playerElement._hlsConfig =
          this.dataset.controls === 'none' ? ambientConfig : startupConfig
      }
      this.posterImg = this.querySelector('.media-frame__poster') as HTMLImageElement | null
      this.curatedPoster = this.querySelector(
        '.media-frame__curated-poster',
      ) as HTMLImageElement | null
      // Sync with a `revealed` attribute set before this element connected
      // (attributeChangedCallback fires before curatedPoster is queried).
      this.curatedPoster?.setAttribute('aria-hidden', String(this.hasAttribute('revealed')))
      // Load crossfade (ADR-0039): non-priority layers start at opacity 0
      // over the skeleton (CSS, gated on html.js) and fade in on their own
      // load event. Priority frames (data-priority) are exempt from the
      // opacity gate — they paint as soon as the browser decodes them
      // (GH #162, LCP) — but the stamping below still runs for them so the
      // contract stays uniform. A layer already complete at connect (browser
      // cache, View Transition swap, bfcache) is marked synchronously so the
      // first paint shows it at full opacity — no skeleton flash, no
      // transition.
      // Deferred posters (deferPoster) have no currentSrc yet but report
      // complete, so the check requires a resolved URL; promotePoster()
      // fires their load later. A failed load leaves the layer hidden and
      // the skeleton up — the frame still never paints blank.
      for (const img of this.querySelectorAll('img')) {
        if (img.currentSrc && img.complete && img.naturalWidth > 0) {
          img.setAttribute('data-loaded', '')
        } else {
          img.addEventListener('load', this.handleImgLoad)
        }
      }
      this.control = this.querySelector('[data-media-control]') as HTMLButtonElement | null
      this.isFullControls = this.dataset.controls === 'full'
      this.controlsBar = this.querySelector('[data-media-controls]') as HTMLElement | null
      this.scrubberRoot = this.querySelector('[data-media-scrubber]') as HTMLElement | null
      this.playedFill = this.querySelector('[data-scrubber-played]') as HTMLElement | null
      this.bufferedFill = this.querySelector('[data-scrubber-buffered]') as HTMLElement | null
      this.knob = this.querySelector('[data-scrubber-knob]') as HTMLElement | null
      this.trackElement = this.querySelector('[data-scrubber-track]') as HTMLElement | null
      this.mute = this.querySelector('[data-media-mute]') as HTMLButtonElement | null

      if (this.control) {
        this.control.addEventListener('click', this.handleControlClick)
        this.updateControl()
      }

      if (this.mute) {
        this.mute.addEventListener('click', this.handleMuteClick)
        this.updateMute()
      }

      if (this.isFullControls && this.scrubberRoot) {
        const scrubber = this.scrubberRoot
        scrubber.addEventListener('pointerdown', this.handleScrubberPointerDown)
        scrubber.addEventListener('keydown', this.handleScrubberKey)
      }
      // Single host-element activity tracker — pointermove and focusin
      // bubble up from any control or scrubber inside the frame, so the
      // entire bar (and any future overlays) shows on hover-or-focus and
      // re-schedules the auto-hide in one place. See ARCHITECTURE.md
      // ADR-0035 — auto-hide after inactivity, hover/focus/pause to show.
      this.addEventListener('pointermove', this.handleActivity)
      this.addEventListener('pointerdown', this.handleActivity)
      this.addEventListener('focusin', this.handleActivity)

      if (!playerElement && !loopElement) return

      // Constrained network: keep the poster rather than a loop that
      // stutters. Priority frames carry preload="auto", so the browser
      // already opened the MP4 at parse; dropping the sources and
      // re-running the load algorithm aborts that fetch. With no player
      // adopted, updatePlayback() is a no-op and data-video-ready never
      // lands, so the poster stays painted.
      if (loopElement && holdProgressiveLoop()) {
        for (const source of loopElement.querySelectorAll('source')) source.remove()
        loopElement.removeAttribute('preload')
        loopElement.load()
        this.setAttribute('data-loop-held', '')
        return
      }

      this.motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)')
      this.observer = new IntersectionObserver(
        ([entry]) => {
          this.isVisible = entry.isIntersecting
          this.updatePlayback()
        },
        {threshold: 0},
      )
      this.observer.observe(this)

      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      this.motionPreference.addEventListener('change', this.handleMotionChange)

      // The mux-video chunk (~1MB raw with media-chrome on mux-player) is the
      // largest JS cost on media pages, so it loads lazily: priority frames
      // (heroes) fetch it immediately, gated frames on reveal (ADR-0036 — a
      // dormant frame must not fetch anything), everything else about one
      // viewport before it can scroll in.
      const isGated = this.hasAttribute('gated')
      if (loopElement) {
        // No poster copy (GH #172 — the player poster is gone everywhere):
        // the loop fades in over the always-painted overlay poster via the
        // same data-video-ready opacity gate as the HLS path.
        this.wirePlayer(loopElement)
        // Resolve the never-awaited promise so togglePlayback()'s "chunk in
        // flight" branch can't fire for a frame that has no chunk.
        this.playerLoading = Promise.resolve()
      } else if (isGated) {
        if (this.hasAttribute('revealed')) void this.loadPlayer()
      } else if (this.hasAttribute('data-priority')) {
        void this.loadPlayer()
      } else {
        this.loadObserver = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return
            this.loadObserver?.disconnect()
            this.loadObserver = null
            void this.loadPlayer()
          },
          {rootMargin: LOAD_ROOT_MARGIN},
        )
        this.loadObserver.observe(this)
      }
    }

    /** Imports the mux-video chunk and wires the player. Idempotent; safe to
     *  call from the load observer, the reveal hook, or connectedCallback. */
    private loadPlayer(): Promise<void> {
      if (!this.playerLoading) {
        this.playerLoading = (async () => {
          // `/base` is mux-video without the CastableMediaMixin / media-tracks
          // wrappers — we drive the plain HTMLVideoElement surface only, and
          // the full build still pulled gstatic cast_sender.js. Base doesn't
          // self-define, so register the element here.
          const {MuxVideoBaseElement} = await import('@mux/mux-video/base')
          if (!customElements.get('mux-video')) {
            customElements.define('mux-video', MuxVideoBaseElement)
          }
          if (!this.isConnected) return
          const player = this.querySelector('mux-video') as MuxVideoElement | null
          if (!player) return
          this.wirePlayer(player)

          if (import.meta.env.DEV) {
            // Startup quality and the buffer cap ride on two contracts:
            // `_hlsConfig` being read as an own property before upgrade (see
            // connectedCallback), and playback-core defaulting
            // `capLevelToPlayerSize` on with its own size-cap controller.
            // Both are dependency internals, so surface a break in dev
            // instead of silently regressing to a low-res start or 30s
            // buffers. `_hls` is undefined under native HLS (Safari), where
            // none of this applies — the check is a no-op there.
            player.addEventListener(
              'playing',
              () => {
                const hlsConfig = this.player?._hls?.config
                if (!hlsConfig) return
                if (hlsConfig.testBandwidth !== false) {
                  console.warn(
                    '[media-frame] hls.js bandwidth test not disabled; check the _hlsConfig hook against the installed @mux/mux-video',
                    hlsConfig,
                  )
                }
                if (hlsConfig.capLevelToPlayerSize !== true) {
                  console.warn(
                    '[media-frame] player-size rendition cap off; a playback-core upgrade may have changed the capLevelToPlayerSize default',
                    hlsConfig,
                  )
                }
                if (
                  this.dataset.controls === 'none' &&
                  hlsConfig.maxBufferLength !== AMBIENT_HLS_CONFIG.maxBufferLength
                ) {
                  console.warn(
                    '[media-frame] ambient hls.js buffer cap not applied; check the _hlsConfig hook against the installed @mux/mux-video',
                    hlsConfig,
                  )
                }
              },
              {once: true},
            )
          }
        })()
      }
      return this.playerLoading
    }

    /** Adopts an HTMLVideoElement surface (an upgraded `<mux-video>` or the
     *  progressive-loop `<video>`) as `this.player` and attaches the shared
     *  listeners. Everything above this layer — visibility gating, controls,
     *  the poster crossfade — drives the element surface only, so the two
     *  delivery paths diverge nowhere else. */
    private wirePlayer(player: MuxVideoElement) {
      this.player = player

      // Safari regressed on the `disablepictureinpicture` attribute
      // (mdn/browser-compat-data#24399) but still honors the property,
      // so set it here too; the template attribute covers the rest.
      player.disablePictureInPicture = true

      player.addEventListener('play', this.handlePlay)
      player.addEventListener('pause', this.handlePause)
      player.addEventListener('volumechange', this.handleVolumeChange)
      // The video layer sits at opacity 0 until `data-video-ready` and
      // fades in over the poster (which never fades — GH #172). The
      // readiness stamp itself is frame-accurate: see handleReady.
      player.addEventListener('playing', this.handleReady)
      // playback-core attaches hls.js to the <video> asynchronously after
      // upgrade. A play() issued before that attach is voided by the media
      // load algorithm (paused resets to true, the promise rejects), so a
      // visible frame would sit on its poster until the next intersection
      // change. Re-evaluate once the source is really in. (Harmless on the
      // progressive loop, where the source is in from parse.)
      player.addEventListener('loadedmetadata', this.handleSourceReady)

      if (this.isFullControls) {
        player.addEventListener('timeupdate', this.handleTimeUpdate)
        player.addEventListener('durationchange', this.handleDurationChange)
        player.addEventListener('loadedmetadata', this.handleLoadedMeta)
        player.addEventListener('progress', this.handleProgress)
        player.addEventListener('seeked', this.handleSeeked)
      }

      this.updateControl()
      this.updateMute()
      this.updatePlayback()
      this.refreshScrubber()
    }


    /** Restores a deferred poster's src/srcset so it fetches (see the
     *  `deferPoster` prop). Idempotent, so callers can prefetch the next
     *  frame's poster before it is shown. */
    public promotePoster() {
      const img = this.posterImg
      if (!img?.dataset.src) return
      // srcset before src so the no-srcset fallback never wins a fetch.
      if (img.dataset.srcset) img.setAttribute('srcset', img.dataset.srcset)
      img.setAttribute('src', img.dataset.src)
      delete img.dataset.src
      delete img.dataset.srcset
    }

    attributeChangedCallback(name: string) {
      if (name === 'revealed') {
        // The poster conveys the same content as the video it covers, so it
        // leaves the accessibility tree while revealed (ARCHITECTURE.md
        // ADR-0036). The reveal transition itself is attribute-driven CSS.
        this.curatedPoster?.setAttribute(
          'aria-hidden',
          String(this.hasAttribute('revealed')),
        )
        // A gated frame's first reveal is also what fetches the mux chunk.
        if (this.hasAttribute('revealed')) void this.loadPlayer()
      }
      this.updatePlayback()
    }

    /** Card-link hook (EditorialCard / HomeWork): a touch tap that reveals a
     *  gated poster is explicit play intent, honored even under
     *  reduced-motion — same rule as the Presented play button
     *  (ARCHITECTURE.md ADR-0036). */
    public revealWithIntent() {
      this.userIntent = 'playing'
      this.setAttribute('revealed', '')
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.loadObserver?.disconnect()
      for (const img of this.querySelectorAll('img')) {
        img.removeEventListener('load', this.handleImgLoad)
      }
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this.motionPreference?.removeEventListener('change', this.handleMotionChange)
      this.player?.removeEventListener('play', this.handlePlay)
      this.player?.removeEventListener('pause', this.handlePause)
      this.player?.removeEventListener('playing', this.handleReady)
      this.player?.removeEventListener('loadedmetadata', this.handleSourceReady)
      this.player?.removeEventListener('volumechange', this.handleVolumeChange)
      this.player?.removeEventListener('timeupdate', this.handleTimeUpdate)
      this.player?.removeEventListener('durationchange', this.handleDurationChange)
      this.player?.removeEventListener('loadedmetadata', this.handleLoadedMeta)
      this.player?.removeEventListener('progress', this.handleProgress)
      this.player?.removeEventListener('seeked', this.handleSeeked)
      this.control?.removeEventListener('click', this.handleControlClick)
      this.mute?.removeEventListener('click', this.handleMuteClick)
      this.scrubberRoot?.removeEventListener('pointerdown', this.handleScrubberPointerDown)
      this.scrubberRoot?.removeEventListener('keydown', this.handleScrubberKey)
      this.removeEventListener('pointermove', this.handleActivity)
      this.removeEventListener('pointerdown', this.handleActivity)
      this.removeEventListener('focusin', this.handleActivity)
      if (this.autoHideTimer !== null) {
        clearTimeout(this.autoHideTimer)
        this.autoHideTimer = null
      }
      if (this.dragPointerId !== null) {
        try {
          this.trackElement?.releasePointerCapture(this.dragPointerId)
        } catch {
          // already released by the browser; swallow
        }
        this.dragPointerId = null
      }
      this.isDragging = false
    }

    private updatePlayback() {
      if (!this.player) return

      const isActive = this.hasAttribute('active')
      const isDocVisible = document.visibilityState === 'visible'
      const prefersReducedMotion = this.motionPreference?.matches ?? false
      const isPaused = this.player.paused ?? true
      // Gated Ambient (ARCHITECTURE.md ADR-0036): a poster card is dormant until
      // the card link toggles `revealed`; with preload="none" and no play()
      // call, Mux fetches no segments before the first reveal.
      const isGated = this.hasAttribute('gated')
      const isRevealed = !isGated || this.hasAttribute('revealed')

      let shouldPlay =
        isRevealed && isActive && this.isVisible && isDocVisible && !prefersReducedMotion

      if (this.control || isGated) {
        if (this.userIntent === 'paused') {
          shouldPlay = false
        } else if (this.userIntent === 'playing') {
          shouldPlay = isRevealed && isActive && this.isVisible && isDocVisible
        }
      }

      if (shouldPlay && isPaused) {
        this.player.play?.().catch(() => {})
      } else if (!shouldPlay && !isPaused) {
        this.player.pause?.()
      }
    }

    private togglePlayback() {
      if (!this.player) {
        // The chunk can still be in flight on a lazy frame; treat the click
        // as play intent so the video starts as soon as the player wires up.
        this.userIntent = 'playing'
        void this.loadPlayer()
        return
      }

      if (this.player.paused) {
        this.userIntent = 'playing'
        if (this.isVisible && document.visibilityState === 'visible') {
          this.player.play?.().catch(() => {})
        }
      } else {
        this.userIntent = 'paused'
        this.player.pause?.()
      }
      this.updateControl()
      this.refreshScrubber()
      this.showControlsBar()
    }

    private updateControl() {
      if (!this.control || !this.player) return

      const isPlaying = !this.player.paused
      this.control.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video')
      this.control.setAttribute('aria-pressed', String(isPlaying))
      this.control.dataset.state = isPlaying ? 'playing' : 'paused'
    }

    private toggleMute() {
      if (!this.player) return
      const next = this.player.muted
      this.player.muted = !next
      // Unmuting requires a user gesture, which the click already satisfied.
      if (!this.player.paused && this.player.muted === false) {
        // Play() resolves the autoplay-policy promise once unmuted; harmless noop if already playing.
        this.player.play?.().catch(() => {})
      }
      this.updateMute()
    }

    private updateMute() {
      if (!this.mute || !this.player) return
      const isMuted = this.player.muted
      this.mute.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video')
      this.mute.setAttribute('aria-pressed', String(!isMuted))
      this.mute.dataset.state = isMuted ? 'muted' : 'playing'
    }

    private readDuration(): number {
      if (!this.player) return 0
      const d = this.player.duration
      if (!d || !Number.isFinite(d) || d < 0) return 0
      return d
    }

    private currentTime(): number {
      if (!this.player) return 0
      const t = this.player.currentTime
      if (!Number.isFinite(t)) return 0
      return Math.max(0, t)
    }

    private formatTime(valueS: number): string {
      const total = Math.max(0, Math.round(valueS))
      const minutes = Math.floor(total / 60)
      const seconds = total % 60
      return `${minutes}:${seconds.toString().padStart(2, '0')}`
    }

    private ratioFromEvent(target: HTMLElement, clientX: number): number {
      const rect = target.getBoundingClientRect()
      if (rect.width <= 0) return 0
      const clamped = Math.min(Math.max(clientX - rect.left, 0), rect.width)
      return clamped / rect.width
    }

    private refreshScrubber() {
      if (!this.isFullControls || !this.scrubberRoot) return
      this.durationS = this.readDuration()
      const current = this.currentTime()
      const ratio =
        this.durationS > SCRUBBER_READY_EPSILON_S ? current / this.durationS : 0
      const pct = `${Math.min(100, Math.max(0, ratio * 100)).toFixed(2)}%`

      if (this.playedFill && !this.isDragging) {
        this.playedFill.style.width = pct
      }
      if (this.knob && !this.isDragging) {
        this.knob.style.left = pct
      }

      const durationSafe = this.durationS > 0 ? this.durationS : 0
      const currentSafe = this.durationS > 0 ? current : 0
      this.scrubberRoot.setAttribute('aria-valuemin', '0')
      this.scrubberRoot.setAttribute('aria-valuemax', String(Math.round(durationSafe)))
      this.scrubberRoot.setAttribute('aria-valuenow', String(Math.round(currentSafe)))
      this.scrubberRoot.setAttribute(
        'aria-valuetext',
        `${this.formatTime(currentSafe)} / ${this.formatTime(durationSafe)}`,
      )
      this.refreshBuffered()
    }

    private refreshBuffered() {
      if (!this.isFullControls || !this.bufferedFill || !this.player) return
      const duration = this.readDuration()
      if (duration <= SCRUBBER_READY_EPSILON_S) {
        this.bufferedFill.style.width = '0%'
        return
      }
      const buffered = this.player.buffered
      let end = 0
      for (let i = 0; i < buffered.length; i++) {
        end = Math.max(end, buffered.end(i))
      }
      const ratio = Math.min(1, end / duration)
      this.bufferedFill.style.width = `${(ratio * 100).toFixed(2)}%`
    }

    private seekToRatio(ratio: number) {
      if (!this.player || this.durationS <= SCRUBBER_READY_EPSILON_S) return
      const clamped = Math.min(1, Math.max(0, ratio))
      this.player.currentTime = clamped * this.durationS
      this.refreshScrubber()
    }

    private startScrub(event: PointerEvent) {
      if (!this.player || !this.scrubberRoot || !this.trackElement) return
      if (this.durationS <= SCRUBBER_READY_EPSILON_S) {
        // Scrubber has no timeline yet (poster showing, mux-video still
        // fetching metadata). Ignore the gesture rather than confusing the
        // user with a no-op seek.
        return
      }
      if (event.button !== undefined && event.button !== 0) return
      this.isDragging = true
      this.dragPointerId = event.pointerId
      this.trackElement.setPointerCapture(event.pointerId)
      this.trackElement.addEventListener('pointermove', this.handleScrubMove)
      this.trackElement.addEventListener('pointerup', this.handleScrubEnd)
      this.trackElement.addEventListener('pointercancel', this.handleScrubEnd)
      this.scrubberRoot.classList.add('is-dragging')
      this.scrubberRoot.focus({preventScroll: true})
      this.seekToRatio(this.ratioFromEvent(this.trackElement, event.clientX))
      this.markActivity()
    }

    private handleScrubMove = (event: PointerEvent) => {
      if (!this.isDragging || !this.trackElement) return
      this.seekToRatio(this.ratioFromEvent(this.trackElement, event.clientX))
    }

    private handleScrubEnd = (event: PointerEvent) => {
      if (!this.trackElement) return
      this.isDragging = false
      try {
        this.trackElement.releasePointerCapture(event.pointerId)
      } catch {
        // already released
      }
      this.trackElement.removeEventListener('pointermove', this.handleScrubMove)
      this.trackElement.removeEventListener('pointerup', this.handleScrubEnd)
      this.trackElement.removeEventListener('pointercancel', this.handleScrubEnd)
      this.scrubberRoot?.classList.remove('is-dragging')
      this.dragPointerId = null
      // Mouse-up after a click-to-seek should count as play intent: the user
      // explicitly engaged with the timeline, so don't let an offscreen pause
      // immediately undo it.
      if (this.userIntent === null) this.userIntent = 'playing'
      this.refreshScrubber()
      this.scheduleAutoHide()
    }

    private onScrubberKey(event: KeyboardEvent) {
      if (!this.player || this.durationS <= SCRUBBER_READY_EPSILON_S) return
      let handled = false
      switch (event.key) {
        case 'ArrowLeft':
          this.player.currentTime = Math.max(0, this.currentTime() - SEEK_STEP_S)
          handled = true
          break
        case 'ArrowRight':
          this.player.currentTime = Math.min(
            this.durationS,
            this.currentTime() + SEEK_STEP_S,
          )
          handled = true
          break
        case 'Home':
          this.player.currentTime = 0
          handled = true
          break
        case 'End':
          this.player.currentTime = this.durationS
          handled = true
          break
        default:
          break
      }
      if (handled) {
        event.preventDefault()
        this.refreshScrubber()
        this.markActivity()
      }
    }

    private markActivity() {
      if (!this.isFullControls || !this.controlsBar) return
      this.showControlsBar()
      this.scheduleAutoHide()
    }

    private showControlsBar() {
      this.removeAttribute('data-controls-hidden')
    }

    private scheduleAutoHide() {
      if (this.autoHideTimer !== null) {
        clearTimeout(this.autoHideTimer)
        this.autoHideTimer = null
      }
      if (!this.isFullControls || !this.player) return
      // Always show while paused — see ARCHITECTURE.md ADR-0035.
      if (this.player.paused) {
        this.showControlsBar()
        return
      }
      this.autoHideTimer = setTimeout(() => {
        this.autoHideTimer = null
        // Re-check pause at the moment of hiding so a pause during the timer
