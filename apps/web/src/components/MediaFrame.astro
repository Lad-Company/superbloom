     video (Safari fires `playing` before compositing the first frame). */
  .media-frame :global(mux-video),
  .media-frame__loop,
  .media-frame__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-frame__poster {
    pointer-events: none;
  }

  .media-frame :global(mux-video),
  .media-frame__loop {
    opacity: 0;
    transition: opacity var(--motion-standard) var(--motion-ease-out);
