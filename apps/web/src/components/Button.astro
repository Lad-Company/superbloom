---
interface Props {
  href?: string
  label: string
  class?: string
  target?: string
  rel?: string
  as?: 'button'
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  [key: `data-${string}`]: string | boolean | number | undefined
}

const {
  href,
  label,
  class: className,
  target,
  rel,
  as,
  type = 'button',
  disabled,
  ...rest
} = Astro.props
---

{
  href ? (
    <a
      class:list={['btn', 'surface-wipe', className]}
      href={href}
      target={target}
      rel={rel}
      data-motion-control
      {...rest}
    >
      <span class="btn__label">{label}</span>
    </a>
  ) : as === 'button' ? (
    <button
      class:list={['btn', 'surface-wipe', className]}
      type={type}
      disabled={disabled}
      data-motion-control
      {...rest}
    >
      <span class="btn__label">{label}</span>
    </button>
  ) : (
    <span class:list={['btn', 'surface-wipe', className]} data-motion-control {...rest}>
      <span class="btn__label">{label}</span>
    </span>
  )
}
