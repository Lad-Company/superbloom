---
import { blockId } from '../lib/blockId';

interface Discipline {
  _key?: string;
  title: string | null;
  description?: string | null;
}

interface Props {
  items: Discipline[];
}

const { items } = Astro.props;
---

<ul class="discipline-list">
  {items.map((item) => (
    /* The id is the deep-link target for the home Capes capability list;
       both sides derive it from the title via blockId. */
    <li class="row" id={item.title ? `discipline-${blockId(item.title)}` : undefined}>
      <p class="title type-h4">{item.title}</p>
      {item.description && (
        <p class="description type-caption">{item.description}</p>
      )}
    </li>
  ))}
</ul>

<style>
  .discipline-list {
    margin: 0;
    padding: 0 var(--space-xs);
    list-style: none;
  }
  .row {
    display: flex;
    gap: var(--page-gutter);
    /* Deep links (from the home Capes list) land the row just below the nav,
       matching the case-study chapter offset. */
    scroll-margin-top: 72px;
    /* Description column pins to the top of the row, level with the title. */
    align-items: flex-start;
    /* 32px of vertical padding inside each row's divider boundaries. */
    padding: var(--space-xs) 0;
    border-top: 1px solid var(--fg-20);
  }
  .title {
    flex: 1 0 0;
    min-width: 0;
    margin: 0;
  }
  .description {
    flex: 1 0 0;
    min-width: 0;
    margin: 0;
    color: var(--fg-60);
  }
  @media (--bp-small) {
    .discipline-list {
      padding: 0 var(--space-3xs);
    }
    .row {
      flex-direction: column;
      gap: var(--space-3xs);
      /* Mobile keeps its pre-existing compact centered stack; the desktop
         alignment and 32px row padding above don't apply here. */
      align-items: center;
      padding: var(--space-3xs) 0;
    }
    .description {
      padding-top: 8px;
    }
  }
</style>
