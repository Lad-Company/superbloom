---
import EditorialCard from './EditorialCard.astro'
import TagList from './TagList.astro'
import type {Media} from './MediaFrame.astro'
import {
  type CardWidth,
  type InfoPosition,
  type MediaAspectRatio,
  type PartialContentCardSettings,
} from '../lib/contentCard'

interface Tag {
  title?: string | null
  color?: string | null
}

interface NewsItem {
  _id?: string | null
  title: string | null
  slug?: string | null
  overview?: Array<{children?: Array<{text?: string | null}>}> | null
  publicationDate?: string | null
  destination?: string | null
  source?: string | null
  cardWidth?: CardWidth | null
  mediaAspectRatio?: MediaAspectRatio | null
  infoPosition?: InfoPosition | null
  tags: Tag[] | null
  cardMedia: Media | null
}

interface Props {
  item: NewsItem
  showCopy?: boolean
  class?: string
  settings?: PartialContentCardSettings
  listSettings?: PartialContentCardSettings
  globalSettings?: PartialContentCardSettings
}

const {
  item,
  class: className,
  settings,
  listSettings,
  globalSettings,
} = Astro.props
const href = item.destination ?? '#'
---

<EditorialCard
  href={href}
  title={item.title}
  media={item.cardMedia}
  contentSettings={item}
  settings={settings}
  listSettings={listSettings}
  globalSettings={globalSettings}
  class={className}
  target="_blank"
  rel="noopener noreferrer"
  externalLabel={item.source ?? undefined}
  cardId={item._id}
  publicationDate={item.publicationDate}
>
  <TagList slot="overlay" tags={item.tags} typeLabel="News" maxTags={1} />
</EditorialCard>
