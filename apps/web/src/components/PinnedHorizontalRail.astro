---
import CardCarousel from './CardCarousel.astro'

interface Props {
  label: string
  class?: string
  showControls?: boolean
}

const {label, class: className, showControls = true} = Astro.props
---

<CardCarousel
  label={label}
  class:list={['pinned-horizontal-rail', className]}
  showControls={showControls}
>
  <slot />
</CardCarousel>
