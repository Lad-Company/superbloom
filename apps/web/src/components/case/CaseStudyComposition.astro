---
import MediaFrame from '../MediaFrame.astro';
import PageHero from '../PageHero.astro';
import SurfaceSection from '../SurfaceSection.astro';
import CaseStudyNarrativeSection from './CaseStudyNarrativeSection.astro';
import CaseStudyPress from './CaseStudyPress.astro';
import CaseStudySpineNav from './CaseStudySpineNav.astro';
import NextProject from './NextProject.astro';
import Results from './Results.astro';
import { caseStudySections } from '../../lib/caseStudySections';
import type { CaseStudyBySlugQueryResult } from '../../sanity.types';

type CaseStudy = NonNullable<CaseStudyBySlugQueryResult>;

interface Props {
  caseStudy: CaseStudy;
}

// Brand color vars are set on <body> by pages/work/[slug].astro (see
// caseBrandVars) so the Layout-rendered Navigation resolves case tokens too.
const { caseStudy } = Astro.props;
// GROQ `tags[]->` yields null for dangling references (tag deleted or
// unpublished while still referenced), so entries can be null.
const tagTitles = (caseStudy.tags ?? [])
  .filter((tag) => tag != null)
  .map((tag) => tag.title)
  .filter((title): title is string => Boolean(title));
---

<div class="case-study">
  <SurfaceSection role="case-primary">
    <div class="hero-shell">
      <PageHero
        heading={caseStudy.title ?? ''}
        eyebrow={caseStudy.client}
        tags={tagTitles}
      />
    </div>
  </SurfaceSection>

  {caseStudy.leadMedia && (
    <SurfaceSection role="case-primary">
      <div class="lead-media">
        <MediaFrame
          media={caseStudy.leadMedia}
          ratio="16:9"
          placement={{context: 'hero', capPx: 1440}}
          title={caseStudy.title}
          controls={caseStudy.leadMedia.asset?._type === 'mux.video' ? 'full' : 'none'}
        />
      </div>
    </SurfaceSection>
  )}

  <CaseStudySpineNav />

  {caseStudySections.map((sectionDefinition) => {
    if (sectionDefinition.field === 'results') {
      return caseStudy.results && (
        <Results
          id={sectionDefinition.id}
          label={sectionDefinition.label}
          results={caseStudy.results}
        />
      );
    }

    const section = caseStudy[sectionDefinition.field];
    return section && (
      <CaseStudyNarrativeSection
        id={sectionDefinition.id}
        label={sectionDefinition.label}
        section={section}
        title={caseStudy.title}
      />
    );
  })}

  <CaseStudyPress items={caseStudy.press ?? []} globalSettings={caseStudy.globalCardDefaults} />
  {caseStudy.nextProject && <NextProject project={caseStudy.nextProject} globalSettings={caseStudy.globalCardDefaults} />}
</div>

<style>
  .case-study {
    overflow: clip;
  }
  .hero-shell {
    position: relative;
    background: var(--bg);
    color: var(--fg);
  }
  .lead-media {
    padding: var(--space-xs) var(--page-inset) var(--space-2xl);
  }
  .lead-media :global(.media-frame) {
    border-radius: var(--radius-media);
  }
  @media (--bp-small) {
    /* Mobile lead media sits flush under the case hero — the hero's own
       32px padding-bottom plus this 32px top form the consistent 64px
       hand-off used across pages. */
    .lead-media {
      padding: var(--space-xs) var(--space-3xs) var(--space-xl);
    }
  }
</style>
