---
import { caseStudySections } from '../../lib/caseStudySections';
---

{/* Zero-height marker at the strip's flow position: the script reads its
    rect on every scroll tick to know when the strip is actually stuck to the
    viewport top (reading the strip itself would oscillate — the dock
    transform moves its own rect). */}
<span class="spine-sentinel" aria-hidden="true"></span>
<nav class="spine-nav type-label" aria-label="Case study sections">
  <ul>
    {caseStudySections.map((section, index) => (
      <li>
        <a
          href={`#${section.id}`}
          data-spine-link={section.id}
          aria-current={index === 0 ? 'location' : undefined}
        >
          {section.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.spine-nav');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spine-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.spineLink ?? ''))
    .filter((section): section is HTMLElement => section !== null);
  let activeId = links.find((link) => link.hasAttribute('aria-current'))?.dataset.spineLink;

  // Keep the active chapter visible in the horizontally scrollable strip:
  // as the scrollspy moves the highlight, slide the strip so the active tab
  // centers itself. scrollBy on the overflow container only ever moves the
  // strip, never the page.
  const centerActiveLink = (link: HTMLAnchorElement) => {
    if (!nav) return;
    const navRect = nav.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const delta = linkRect.left - navRect.left - (navRect.width - linkRect.width) / 2;
    if (Math.abs(delta) < 1) return;
    nav.scrollBy({
      left: delta,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    });
  };

  const setActive = (id: string) => {
    if (id === activeId) return;
    activeId = id;
    links.forEach((link) => {
      if (link.dataset.spineLink === id) {
        link.setAttribute('aria-current', 'location');
        centerActiveLink(link);
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  // Reading-line scrollspy: the active chapter is the last section whose top
  // has passed the bottom edge of this sticky nav. A pure function of scroll
  // position, so the highlight crosses each chapter boundary exactly once.
  // (The IntersectionObserver this replaces only saw entries whose state had
  // just changed; picking the topmost of those flipped the highlight to
  // whichever neighbour last crossed a threshold — the mid-scroll flicker.)
  // Click-scroll lands a chapter at its scroll-margin-top (72px), so the line
  // must sit at or below that offset — otherwise a freshly landed chapter
  // reads as "not yet reached" and the highlight bounces back on arrival.
  const scrollMargin = Math.max(
    0,
    ...sections.map((section) => parseFloat(getComputedStyle(section).scrollMarginTop) || 0),
  );

  const updateActive = () => {
    updateStuck();
    const first = sections.at(0);
    if (!first) return;
    // Fire 15% of a viewport height before the chapter top reaches the nav,
    // so the highlight moves as the chapter enters rather than on arrival.
    const line = Math.max(nav?.offsetHeight ?? 0, scrollMargin) + 1 + window.innerHeight * 0.15;
    let current = first;
    for (const section of sections) {
      if (section.getBoundingClientRect().top > line) break;
      current = section;
    }
    // The final chapter can sit too close to the page end for its top to ever
    // reach the line; at the bottom of the page, hand it the highlight.
    const last = sections.at(-1);
    const atPageBottom =
      window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atPageBottom && last) current = last;
    setActive(current.id);
  };

  let updateQueued = false;
  const queueUpdate = () => {
    if (updateQueued) return;
    updateQueued = true;
    requestAnimationFrame(() => {
      updateQueued = false;
      updateActive();
    });
  };

  // Dock gate: the shy-bar offset (CSS below) must apply only while the
  // strip is actually stuck to the viewport top. Translating the in-flow
  // strip shoves it --shy-bar-h below its seat, opening a gap between it and
  // the lead media whenever the bar reveals before the strip has stuck —
  // always the case on mobile, where the strip starts inside the initial
  // viewport. The sentinel sits at the strip's flow position; once it
  // crosses above the top edge, the strip is stuck. Checked synchronously on
  // the scroll path, not with an IntersectionObserver: IO deliveries are
  // batched and can lag the scroll handler by several frames, so the dock
  // engaged late — the revealed bar covered the strip, then the strip jumped
  // down a beat later (and symmetrically lingered docked after unsticking,
  // reopening the in-flow gap). The reading-line scrollspy above replaced an
  // IO for the same flakiness.
  const sentinel = document.querySelector('.spine-sentinel');
  const updateStuck = () => {
    if (!nav || !sentinel) return;
    // Stuck at the top edge only: past the flow position, but not yet
    // bottomed out against the parent's end (there the strip rides up with
    // the content — in flow again — and the dock would shove it --shy-bar-h
    // below its seat, the same hole as the never-stuck case).
    const pastTop = sentinel.getBoundingClientRect().top < 0;
    const parentBottom = nav.parentElement?.getBoundingClientRect().bottom ?? 0;
    nav.toggleAttribute('data-stuck', pastTop && parentBottom >= nav.offsetHeight);
  };

  // Anchor glides ride native `scroll-behavior: smooth` (motion.css), so
  // plain scroll events stay in sync with the animated motion.
  window.addEventListener('scroll', queueUpdate, { passive: true });
  window.addEventListener('resize', queueUpdate);
  updateActive();

  const clickHandlers = new Map<HTMLAnchorElement, (event: MouseEvent) => void>();
  links.forEach((link) => {
    const handleClick = (event: MouseEvent) => {
      const section = document.getElementById(link.dataset.spineLink ?? '');
      if (!section) return;
      event.preventDefault();
      section.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
      history.replaceState(null, '', link.hash);
      section.focus({ preventScroll: true });
      setActive(section.id);
    };
    clickHandlers.set(link, handleClick);
    link.addEventListener('click', handleClick);
  });

  const cleanup = () => {
    window.removeEventListener('scroll', queueUpdate);
    window.removeEventListener('resize', queueUpdate);
    clickHandlers.forEach((handler, link) => link.removeEventListener('click', handler));
  };
  document.addEventListener('astro:before-swap', cleanup, { once: true });
</script>

<style>
  .spine-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    overflow-x: auto;
    background: var(--bg);
    color: var(--fg);
    scrollbar-width: none;
    /* The slide rides the shy bar's own ramp so the dock reads as one piece
       of chrome moving, not a second animation chasing it. */
    transition: transform var(--motion-quick) var(--motion-ease-out);
  }
  /* While the shy bar is revealed it owns the viewport's top edge (fixed,
     z-30, same strip this sticky nav pins to): its frost ghosts the tab
     text and the bar eats every tap meant for the chapters. Dock the strip
     beneath the bar by its height (--shy-bar-h, published by lib/shyNav.ts)
     while revealed; the offset lifts when the bar hides. Gated on
     data-stuck (tracked from the sentinel's rect in the script) so a strip
     in document flow is never pushed off its seat. */
  :global(body:has(.navigation.is-shy.is-revealed)) .spine-nav[data-stuck] {
    transform: translateY(var(--shy-bar-h, 0px));
  }
  .spine-sentinel {
    display: block;
    height: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .spine-nav {
      transition: none;
    }
  }
  .spine-nav::-webkit-scrollbar {
    display: none;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(max-content, 1fr));
    min-width: max-content;
  }
  a {
    display: block;
    padding: var(--space-2xs) var(--pad-10);
    border-bottom: 2px solid transparent;
    color: var(--fg-60);
    text-align: center;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible,
  a[aria-current='location'] {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
  a:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: -4px;
  }
  @media (--bp-small) {
    a {
      padding: var(--space-16) var(--space-3xs);
    }
  }
</style>
