---
import SurfaceSection from '../SurfaceSection.astro';
import WorkCard from '../WorkCard.astro';
import ContentCardList from '../ContentCardList.astro';
import { fgForHex } from '../../lib/luminance';
import type { CaseStudyBySlugQueryResult } from '../../sanity.types';
import type {PartialContentCardSettings} from '../../lib/contentCard';

type NextProjectData = NonNullable<NonNullable<CaseStudyBySlugQueryResult>['nextProject']>;

interface Props {
  project: NextProjectData;
  globalSettings?: PartialContentCardSettings;
}

const { project, globalSettings } = Astro.props;
const background = project.primaryColor ?? '#ffffff';
const foreground = fgForHex(background);
const vars = `--case-primary-bg: ${background}; --case-primary-fg: ${foreground};`;
// Fixed Composition: the template art-directs this section, so the card layout
// is pinned (full-width 50/50, info right, 1:1 media) and the case study's own
// browse-card settings cannot leak in.
const cardSettings = {cardWidth: 'full', infoPosition: 'right', mediaAspectRatio: '1:1'} as const;
---

{project.slug && (
  <div style={vars}>
    <SurfaceSection role="case-primary">
      <section class="next-project" aria-labelledby="next-project-heading">
        <h2 id="next-project-heading" class="type-eyebrow">Next Project</h2>
        <ContentCardList>
          <WorkCard
            item={project}
            class="next-project-card"
            settings={cardSettings}
            globalSettings={globalSettings}
          />
        </ContentCardList>
      </section>
    </SurfaceSection>
  </div>
)}

<style>
  .next-project {
    padding: var(--space-3xl) var(--page-inset);
  }
  h2 {
    margin: 0 0 var(--space-m);
  }
  .next-project :global(.next-project-card .content) {
    gap: var(--space-3xs);
  }
  .next-project :global(.next-project-card .headline) {
    font-family: var(--font-display-tight);
    /* Card headline rides the shared type-h3 ramp (spec §3.4 — was a fixed
       120px that snapped to a bespoke clamp below 1024). */
    font-size: var(--type-h3);
    font-weight: 750;
    line-height: 0.88;
    text-transform: uppercase;
  }
  .next-project :global(.next-project-card .summary) {
    color: var(--fg);
  }
  /* Figma measures a 64px channel between media and info, not the shared
     24px page gutter EditorialCard uses for left/right cards. Desktop only —
     below 1024 the card stacks and keeps its compact gap. */
  @media (--bp-desktop) {
    .next-project :global(.next-project-card[data-info-position='right']) {
      gap: var(--space-m);
    }
  }
  /* Keep the frame filling its half of the row: with an aspect-ratio box the
     60svh cap would otherwise shrink-wrap the width (justify-self: auto ->
     fit-content), leaving dead space in the column. With a definite width the
     cap crops via object-fit instead, per the card media rule. */
  .next-project :global(.next-project-card .media-frame) {
    width: 100%;
  }
  @media (--bp-small) {
    .next-project {
      padding-block: var(--space-2xl);
    }
  }
</style>
