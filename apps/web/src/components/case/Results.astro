---
import Metric from '../Metric.astro';
import SurfaceSection from '../SurfaceSection.astro';
import ContentLayoutRow from '../ContentLayoutRow.astro';
import type {SurfaceRole} from '../../lib/surfaceRole';
import type { CaseStudyBySlugQueryResult } from '../../sanity.types';

type ResultsData = NonNullable<NonNullable<CaseStudyBySlugQueryResult>['results']>;

interface Props {
  id: string;
  label: string;
  results: ResultsData;
}

const { id, label, results } = Astro.props;
// Variant is new schema; documents saved before it existed default to the
// original quantitative grid.
const qualitative = results.variant === 'qualitative';
// Qualitative bands always ride the primary brand surface; the Background
// Color choice applies only to the quantitative grid.
const role: SurfaceRole =
  !qualitative && results.backgroundColor === 'secondary' ? 'case-secondary' : 'case-primary';
const stats = results.stats ?? [];
const supportingRows = results.supportingRows ?? [];
---

{qualitative ? (
  <SurfaceSection role={role} id={id} tabindex={-1} class="results-surface">
    <div class="results results--qualitative">
      <h2 class="sr-only">{label}</h2>
      <ul class="bands">
        {stats.map((stat) => (
          <li class="band">
            {stat.value && <p class="band-value type-h4">{stat.value}</p>}
            {stat.label && <p class="band-label type-caption">{stat.label}</p>}
          </li>
        ))}
      </ul>
      {supportingRows.length > 0 && (
        <div class="supporting">
          {supportingRows.map((row) => (
            <ContentLayoutRow row={row} mediaControls="full" />
          ))}
        </div>
      )}
    </div>
  </SurfaceSection>
) : (
  <SurfaceSection role={role} id={id} tabindex={-1} class="results-surface">
    <div class="results">
      <h2 class="type-section-heading">{label}</h2>
      <ul data-results-stats>
        {stats.map((stat) => (
          <li>
            <Metric value={stat.value} label={stat.label} />
          </li>
        ))}
      </ul>
      {supportingRows.map((row) => (
        <ContentLayoutRow row={row} mediaControls="full" />
      ))}
    </div>
  </SurfaceSection>
)}

<script>
  import {revealStats} from '../../lib/motion';

  // Count-up + rise reveal runs only for the quantitative variant — the
  // qualitative bands render their final state with no animation. The
  // [data-results-stats] hook exists only in the quantitative branch, so
  // this is a no-op on qualitative pages.
  const cleanups: Array<() => void> = [];
  const initStats = () =>
    document.querySelectorAll<HTMLElement>('[data-results-stats]').forEach((container) => {
      if (container.dataset.statsInitialized) return;
      container.dataset.statsInitialized = 'true';
      const destroy = revealStats(container, ':scope > li');
      cleanups.push(() => {
        destroy();
        delete container.dataset.statsInitialized;
      });
    });

  const cleanupAll = () => cleanups.splice(0).forEach((cleanup) => cleanup());

  initStats();
  document.addEventListener('astro:page-load', initStats);
  document.addEventListener('astro:before-swap', cleanupAll);
</script>

<style>
  :global(.results-surface) {
    scroll-margin-top: 72px;
  }
  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin-top: var(--space-4xl);
    padding: var(--space-2xl) var(--page-inset) var(--space-3xl);
  }
  h2 {
    margin: 0;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--page-gutter);
  }
  li {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  li :global(.value) {
    overflow-wrap: anywhere;
  }

  /* Qualitative: full-bleed statement bands stacked flush on the primary
     brand surface, separated by the same faint ink hairline as the contact
     footer divider (--fg-20) — one above the first band and one between
     each band. The section heading stays available to assistive tech (and
     the spine-nav anchor) but is not shown — the bands carry the section
     on their own. */
  .results--qualitative {
    gap: 0;
    padding: 0;
  }
  .results--qualitative .bands {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .band {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-m) var(--page-inset);
    border-top: 1px solid var(--fg-20);
  }
  .band-value,
  .band-label {
    margin: 0;
  }
  .band-value {
    overflow-wrap: anywhere;
  }
  .results--qualitative .supporting {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-2xl) var(--page-inset) var(--space-3xl);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (--bp-below-desktop) {
    .results {
      margin-top: var(--space-3xl);
    }
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-xl);
    }
  }
  @media (--bp-small) {
    .results {
      margin-top: var(--space-2xl);
      padding-block: var(--space-xl);
    }
    ul {
      grid-template-columns: 1fr;
    }
    .results--qualitative {
      padding-block: 0;
    }
    .band {
      padding: var(--space-xs) var(--page-inset);
    }
    .results--qualitative .supporting {
      padding-block: var(--space-xl);
    }
  }
</style>
