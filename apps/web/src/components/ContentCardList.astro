---
interface Props {
  class?: string;
  featured?: boolean;
  columnPack?: boolean;
}

const {class: className, featured = false, columnPack = false} = Astro.props;
---

<content-card-list
  class:list={['content-card-list', className]}
  data-featured={featured ? true : undefined}
  data-column-pack={columnPack ? true : undefined}
>
  <slot />
</content-card-list>

<script>
  class ContentCardListElement extends HTMLElement {
    private observer?: ResizeObserver;

    connectedCallback() {
      if (this.hasAttribute('data-column-pack')) {
        this.packColumns();
        this.observer = new ResizeObserver(() => this.syncPack());
        this.observer.observe(this);
        const lead = this.querySelector(':scope > .content-card') as HTMLElement | null;
        const leadMedia = lead?.querySelector('.media-frame') as HTMLElement | null;
        if (leadMedia) {
          this.observer.observe(leadMedia);
          this.watchLeadMedia(leadMedia);
        }
        this.syncPack();
        return;
      }
      if (!this.hasAttribute('data-featured')) return;
      this.observer = new ResizeObserver(() => this.layout());
      this.observer.observe(this);
      Array.from(this.children).forEach((card) => this.observer?.observe(card));
      this.layout();
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }

    private packColumns() {
      if (this.querySelector(':scope > .pack-stack')) return;
      const cards = Array.from(this.children) as HTMLElement[];
      if (cards.length < 2) return;
      const stack = document.createElement('div');
      stack.className = 'pack-stack';
      cards.slice(1).forEach((card) => stack.appendChild(card));
      this.appendChild(stack);
    }

    private watchLeadMedia(leadMedia: HTMLElement) {
      const assets = Array.from(
        leadMedia.querySelectorAll('img, mux-player'),
      ) as HTMLElement[];
      assets.forEach((asset) => {
        if (asset instanceof HTMLImageElement) {
          if (!asset.complete) {
            asset.addEventListener('load', () => this.syncPack(), {once: true});
          }
        } else {
          asset.addEventListener('loadedmetadata', () => this.syncPack(), {once: true});
        }
      });
    }

    private syncPack() {
      const stack = this.querySelector(':scope > .pack-stack') as HTMLElement | null;
      const lead = this.querySelector(':scope > .content-card') as HTMLElement | null;
      if (!stack || !lead) return;
      const mediaFrames = Array.from(stack.children).map(
        (card) => card.querySelector('.media-frame') as HTMLElement | null,
      );
      const mobile = window.innerWidth < 1024;
      if (mobile) {
        mediaFrames.forEach((media) => {
          media?.style.removeProperty('height');
          media?.style.removeProperty('width');
        });
        return;
      }
      const leadMedia = lead.querySelector('.media-frame') as HTMLElement | null;
      if (!leadMedia) return;
      const gap = Number.parseFloat(getComputedStyle(stack).rowGap) || 0;
      const count = mediaFrames.length;
      const perMedia = (leadMedia.getBoundingClientRect().height - gap * (count - 1)) / count;
      if (perMedia <= 0) return;
      Array.from(stack.children).forEach((card) => {
        const media = card.querySelector('.media-frame') as HTMLElement | null;
        if (!media) return;
        media.style.height = `${perMedia}px`;
        const info = card.getAttribute('data-info-position');
        if (info === 'right' || info === 'left') {
          media.style.width = `${perMedia}px`;
        } else {
          media.style.removeProperty('width');
        }
      });
    }

    private layout() {
      const mobile = window.innerWidth < 1024;
      const gap =
        Number.parseFloat(getComputedStyle(this).getPropertyValue('--space-2xl')) || 32;
      Array.from(this.children).forEach((card) => {
        const element = card as HTMLElement;
        element.style.gridRowEnd = mobile
          ? 'auto'
          : `span ${Math.ceil(element.getBoundingClientRect().height + gap)}`;
      });
    }
  }

  if (!customElements.get('content-card-list')) {
    customElements.define('content-card-list', ContentCardListElement);
  }
</script>

<style>
  .content-card-list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: row;
    align-items: start;
    gap: var(--space-2xl) var(--page-gutter);
    min-width: 0;
    width: 100%;
  }

  .content-card-list[data-featured] {
    grid-auto-rows: 1px;
    grid-auto-flow: row dense;
    row-gap: 0;
  }

  .content-card-list[data-column-pack] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: row;
    align-items: start;
    gap: var(--page-gutter);
  }

  .content-card-list[data-column-pack] > :global(.content-card:first-child) {
    grid-column: 1;
  }

  .content-card-list[data-column-pack] > :global(.pack-stack) {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .content-card-list[data-column-pack]
    :global(.pack-stack .content-card[data-info-position='right']) {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .content-card-list[data-column-pack]
    :global(.pack-stack .content-card[data-info-position='left']) {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .content-card-list > :global(.content-card[data-card-width='1/4']) {
    grid-column: span 3;
  }

  .content-card-list > :global(.content-card[data-card-width='1/3']) {
    grid-column: span 4;
  }

  .content-card-list > :global(.content-card[data-card-width='1/2']) {
    grid-column: span 6;
  }

  .content-card-list > :global(.content-card[data-card-width='2/3']) {
    grid-column: span 8;
  }

  .content-card-list > :global(.content-card[data-card-width='3/4']) {
    grid-column: span 9;
  }

  .content-card-list > :global(.content-card[data-card-width='full']) {
    grid-column: 1 / -1;
  }

  @media (max-width: 1023px) {
    .content-card-list {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .content-card-list[data-featured] {
      grid-auto-rows: auto;
      row-gap: var(--space-xl);
    }

    .content-card-list > :global(.content-card[data-card-width]) {
      grid-column: 1 / -1;
      width: 100%;
    }

    .content-card-list[data-column-pack] {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .content-card-list[data-column-pack] > :global(.content-card:first-child) {
      grid-column: 1;
      width: 100%;
    }

    .content-card-list[data-column-pack] > :global(.pack-stack) {
      grid-column: 1;
      gap: var(--space-xl);
    }
  }
</style>
