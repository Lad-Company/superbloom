---
import MediaFrame, {type Media, type MediaRatio} from './MediaFrame.astro'
import {
  cardImageSizes,
  resolveContentCardSettings,
  type PartialContentCardSettings,
} from '../lib/contentCard'
import {formatPublicationDateIndex} from '../lib/publicationDate'

interface Props {
  href: string
  title: string | null
  media: Media | null
  summary?: string | null
  publicationDate?: string | null
  class?: string
  target?: string
  rel?: string
  externalLabel?: string
  ctaLabel?: string | null
  cardId?: string | null
  contentSettings?: PartialContentCardSettings
  settings?: PartialContentCardSettings
  listSettings?: PartialContentCardSettings
  globalSettings?: PartialContentCardSettings
}

const {
  href,
  title,
  media,
  summary,
  publicationDate,
  class: className,
  target,
  rel,
  externalLabel,
  ctaLabel,
  cardId,
  contentSettings,
  settings,
  listSettings,
  globalSettings,
} = Astro.props
const resolved = resolveContentCardSettings({
  global: globalSettings,
  content: contentSettings,
  list: listSettings,
  item: settings,
})
const sizes = cardImageSizes(resolved)
const formattedDate = publicationDate ? formatPublicationDateIndex(publicationDate) : null
---

<a
  class:list={['editorial-card', 'content-card', className]}
  href={href}
  target={target}
  rel={rel}
  data-card-width={resolved.cardWidth}
  data-info-position={resolved.infoPosition}
  data-content-card-id={cardId}
>
  <MediaFrame
    media={media}
    ratio={resolved.mediaAspectRatio as MediaRatio}
    sizes={sizes}
    title={title}
  >
    <slot name="overlay" />
  </MediaFrame>
  <div class="content">
    {title && <p class="headline type-h6 line-clamp-2">{title}</p>}
    {summary && <p class="summary type-caption line-clamp-1">{summary}</p>}
    {
      formattedDate && (
        <time class="publication-date type-caption" datetime={formattedDate.dateTime}>
          {formattedDate.label}
        </time>
      )
    }
    {
      externalLabel && (
        <p class="external-label type-caption">
          {externalLabel} <span aria-hidden="true">↗</span>
        </p>
      )
    }
    {
      ctaLabel && (
        <span class="btn cta surface-wipe">
          <span class="btn__label">{ctaLabel}</span>
        </span>
      )
    }
  </div>
</a>

<script>
  import {initPosterReveal} from '../lib/posterReveal'

  // Card Poster Reveal (docs/card-poster-reveal-spec.md §4): wires hover /
  // focus / tap reveal onto card links hosting a gated media-frame. Runs on
  // every page-load so ClientRouter navigations re-bind; posterReveal
  // dedupes per card.
  document.addEventListener('astro:page-load', () => initPosterReveal())
</script>

<style>
  .editorial-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
    color: var(--fg);
    text-decoration: none;
  }

  /* Height ceiling on card media, on every surface (rails and grids): tall
     ratios like 9:16 crop via object-fit instead of towering over the row.
     svh ties the cap to the screen height; tune the single value here. */
  .editorial-card :global(.media-frame) {
    max-height: 60svh;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-4);
  }

  .editorial-card[data-info-position='left'],
  .editorial-card[data-info-position='right'] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--page-gutter);
  }

  .editorial-card[data-info-position='left'] .content {
    grid-column: 1;
    grid-row: 1;
  }

  .editorial-card[data-info-position='left'] :global(.media-frame) {
    grid-column: 2;
  }

  .headline,
  .summary {
    margin: 0;
  }

  .headline {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .summary {
    color: var(--fg-60);
  }

  .external-label {
    margin: 0;
  }

  .cta {
    align-self: start;
    margin-top: var(--space-xs-4);
  }

  /* Reveal the shared Surface Wipe from card hover/focus, since the whole
     card is the link and the CTA is not separately focusable. */
  .editorial-card:hover .cta,
  .editorial-card:focus-visible .cta {
    color: var(--wipe-ink, var(--bg));
  }

  .editorial-card:hover .cta::before,
  .editorial-card:focus-visible .cta::before {
    transform: scaleY(1);
  }

  .editorial-card:hover .cta::after,
  .editorial-card:focus-visible .cta::after {
    border-color: var(--surface-wipe-outline, var(--wipe-outline, transparent));
  }

  .publication-date {
    color: var(--fg-60);
  }

  .editorial-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (--bp-below-desktop) {
    .editorial-card[data-info-position='left'],
    .editorial-card[data-info-position='right'] {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }
  }
</style>
