---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/forms.css';
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PreviewBar from '../components/PreviewBar.astro';
import { type SurfaceRole } from '../lib/surfaceRole';
import { isPreviewRequest } from '../lib/preview';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  navRole?: SurfaceRole;
  bodyStyle?: string;
  /** Page renders Mux video somewhere; warms the Mux poster/stream hosts with
     a preconnect. Pages without video skip it so Lighthouse doesn't flag an
     unused preconnect (and the browser doesn't burn an idle connection). */
  hasVideo?: boolean;
  /** Extra origins to warm with a preconnect (e.g. cdn.shopify.com on the
     shop pages). Keep page-scoped for the same reason as hasVideo. */
  preconnects?: string[];
}

const {
  title = 'Superbloom House',
  description = 'Superbloom House helps brands make work people actually want to watch, share, and talk about.',
  canonicalUrl = Astro.url.pathname,
  image,
  navRole,
  bodyStyle,
  hasVideo = false,
  preconnects = [],
} = Astro.props;

const canonical = new URL(canonicalUrl, Astro.site ?? Astro.url.origin).href;

// Sentry browser SDK is deferred to after `window load` (GH #164); the
// inline buffer below only exists when the SDK does.
const sentryEnabled = import.meta.env.SENTRY_ENABLED === 'true';

// Draft preview: stamp the request marker and keep editor/share-link
// preview traffic out of prod analytics.
const preview = isPreviewRequest(Astro.cookies);

// www is canonical (the apex 308-redirects to it); accept both so GA keeps
// running even if a request somehow lands on the apex.
const host = Astro.url.hostname;
const gaMode = preview
  ? 'off'
  : host === 'www.superbloomhouse.com' || host === 'superbloomhouse.com'
    ? 'prod'
    : host === 'superbloom-theta.vercel.app'
      ? 'staging'
      : 'off';
---

<!doctype html>
<html lang="en" data-preview={preview || undefined} data-ga-id={gaMode !== 'off' ? 'G-M4H5NZVDCB' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead title={title} description={description} canonicalUrl={canonical} image={image} />
    {/* Preload the site fonts so they are available before first paint. Without
       these, the heading wraps with the system fallback (Arial Narrow / Inter)
       and re-flows when PP Neue Corp / Graphik swap in via font-display: swap.
       That re-flow is what makes the heading visibly shift lower on hard
       refresh, while navbar navigations keep the heading stable because the
       fonts are already cached. */}
    <link
      rel="preload"
      href="/fonts/PPNeueCorp-TightUltrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* The marquee variable font is deliberately not preloaded: it only
       appears below the fold on Who We Are, so it swaps in lazily. */}
    <link
      rel="preload"
      href="/fonts/Graphik-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* The logo SVG is only referenced as a CSS mask-image (nav), so it is
       discovered at style resolution instead of during HTML parsing. The nav
       is above the fold on every page, so 4KB buys its discovery at parse
       time. */}
    <link rel="preload" href="/superbloom-house-logo.svg" as="image" type="image/svg+xml" />
    {/* Warm the Mux hosts (poster thumbnails + HLS manifests) so video frames
       don't pay a fresh DNS+TLS round trip when the player upgrades. Only on
       pages that actually render Mux video — an unused preconnect is flagged
       by Lighthouse and holds an idle connection. */}
    {hasVideo && (
      <>
        <link rel="preconnect" href="https://image.mux.com" crossorigin />
        <link rel="preconnect" href="https://stream.mux.com" crossorigin />
      </>
    )}
    {preconnects.map((origin) => (
      <link rel="preconnect" href={origin} crossorigin />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {gaMode !== 'off' && (
      <>
        {/* Consent Mode v2: bootstrap gtag and default every storage type to
           denied before the config runs, so GA only sends cookieless pings
           until the visitor accepts via the consent banner. A previously
           granted choice (localStorage) is re-applied here so returning
           visitors get analytics_storage on from first paint. */}
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500
          });
          try {
            var c = JSON.parse(localStorage.getItem('sbh_consent') || 'null');
            if (c && c.v === 1 && c.status === 'granted') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            }
          } catch (e) {}
        `}></script>
        {/* The gtag/js library (~170 KB gz) is injected from the client on
           idle or first interaction (see the body script below) so it never
           competes with first paint. The config calls below only push onto
           dataLayer, so they queue safely until the library arrives. */}
        <script is:inline set:html={`
          gtag('js', new Date());
          gtag('config', 'G-M4H5NZVDCB', {
            send_page_view: false${gaMode === 'staging' ? `,
            debug_mode: true,
            traffic_type: 'internal'` : ''}
          });
        `}></script>
      </>
    )}
    <ClientRouter />
    {sentryEnabled && (
      // Sentry pre-init error buffer (GH #164): the browser SDK loads after
      // `window load` (lib/sentryDeferred.ts), so errors thrown before then
      // would be lost. Queue every error / unhandled rejection with its
      // timestamp; the deferred loader replays them through the SDK's own
      // exception parser with the original timestamp. `__sbhSentryLive`
      // stops queueing once the SDK's handlers take over. Guarded so a View
      // Transition re-running this inline script doesn't double-register.
      <script is:inline>
        (function () {
          if (window.__sbhSentryQueue) return;
          const queue = (window.__sbhSentryQueue = []);
          window.addEventListener('error', function (event) {
            if (window.__sbhSentryLive) return;
            queue.push({
              kind: 'error',
              error: event.error || null,
              message: event.message || 'Unknown error',
              timestamp: Date.now() / 1000,
            });
          });
          window.addEventListener('unhandledrejection', function (event) {
            if (window.__sbhSentryLive) return;
            queue.push({
              kind: 'unhandledrejection',
              error: event.reason || null,
              message: (event.reason && event.reason.message) || String(event.reason),
              timestamp: Date.now() / 1000,
            });
          });
        })();
      </script>
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Fonts-ready stamp: the hero Type Reveal (HeroHeading) is pure CSS
      // keyed on html[data-fonts-ready], so the words rise in the real
      // glyphs instead of swapping faces mid-animation. Inline with no
      // imports so it never waits on the bundle. Until the stamp lands the
      // heading's words are clipped at translateY(110%)
      // (html.js:not([data-fonts-ready]) in HeroHeading), so the cold-load
      // rise plays from hidden — GH #171, amending ADR-0040's
      // visible-at-first-paint invariant. The wait is on fonts.load() for
      // the display face itself, not document.fonts.ready: WebKit can
      // resolve fonts.ready before the preloaded Neue Corp Tight is
      // applied, which rose the words in Arial Narrow and swapped faces
      // mid-flight. The cap keeps a hung font load from hiding the heading
      // forever.
      (function () {
        const stamp = function () {
          document.documentElement.setAttribute('data-fonts-ready', '');
        };
        if (!document.fonts || !document.fonts.load) {
          stamp();
          return;
        }
        const capped = new Promise(function (resolve) {
          window.setTimeout(resolve, 1000);
        });
        Promise.race([document.fonts.load('750 1em "PP Neue Corp Tight"'), capped]).then(
          stamp,
          stamp,
        );
      })();
    </script>
    <style is:global>
      /* Route Transition — native View Transition swipe: the outgoing page lifts
         and fades, the incoming page rises from below into place. The page's own
         Type Reveal plays on top of the swipe (see the astro:before-swap handler
         below, which stamps the incoming document so reveal targets start
         hidden). */
      @keyframes sbh-route-out {
        to {
          opacity: 0;
          transform: translateY(-1.5rem);
        }
      }
      @keyframes sbh-route-in {
        from {
          opacity: 0;
          transform: translateY(1.5rem);
        }
      }
      ::view-transition-old(root) {
        animation: 280ms cubic-bezier(0.65, 0, 0.35, 1) both sbh-route-out;
      }
      ::view-transition-new(root) {
        animation: 460ms cubic-bezier(0.215, 0.61, 0.355, 1) both sbh-route-in;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body style={bodyStyle}>
    {navRole && <Navigation role={navRole} />}
    <slot />
    <CartDrawer />
    {preview && <PreviewBar />}
    {(gaMode !== 'off' || import.meta.env.DEV) && <CookieConsent />}
    <script>
      import { prefersReducedMotion } from '../lib/motion/config';
      import { initAnalytics } from '../lib/analytics';
      import { initDeferredSentry } from '../lib/sentryDeferred';

      initAnalytics();

      // Sentry browser SDK: deferred to after `window load` so it never
      // competes with first paint (GH #164); a static no-op when Sentry is
      // disabled. Errors thrown before then sit in the head script's
      // buffer and are replayed with their original timestamps.
      initDeferredSentry();

      // Lazy gtag/js: the library is ~170 KB gz and only ever receives queued
      // dataLayer pushes, so it loads on first interaction only — never on an
      // idle timer — so it can't compete with the critical path or the
      // Lighthouse trace window. Injected once per session; bundled scripts
      // persist across View Transitions, so the module-level flag is enough.
      // No-op when gaMode is 'off' (the attribute is absent).
      const gaId = document.documentElement.dataset.gaId;
      let gtagRequested = false;
      const loadGtag = () => {
        if (gtagRequested || !gaId) return;
        gtagRequested = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(script);
      };
      if (gaId) {
        for (const eventName of ['pointerdown', 'keydown', 'scroll'] as const) {
          window.addEventListener(eventName, loadGtag, { once: true, passive: true });
        }
      }

      let destroyMotion = () => {};
      let destroySmoothScroll = () => {};
      // Supersede guard: setup() awaits the motion chunk, and a View
      // Transition can land mid-flight; the newer setup must win.
      let setupGeneration = 0;

      // Recorded on astro:before-preparation so page-load can tell fresh
      // navigations (land at the top) from history traversal (browser restores
      // the saved scroll position).
      let navigationType: 'push' | 'replace' | 'traverse' = 'push';

      // Fresh route navigations land at the top of the new page; a URL hash
      // lands on its section. Scrolling goes through Lenis (when active) so its
      // internal scroll state resets too — otherwise Lenis re-applies the
      // previous page's offset on the next frame and the new page appears to
      // load scrolled down (e.g. at the footer). The Lenis instance comes from
      // the lazily-imported motion module, so callers pass it in.
      const settleScrollPosition = (
        lenis: { scrollTo: (target: HTMLElement | number, options?: { immediate?: boolean; force?: boolean }) => void } | null,
      ) => {
        if (navigationType === 'traverse') return;
        const hash = window.location.hash;
        const target = hash ? document.getElementById(hash.slice(1)) : null;
        if (lenis) {
          lenis.scrollTo(target ?? 0, { immediate: true, force: true });
        } else if (target) {
          target.scrollIntoView();
        } else {
          window.scrollTo(0, 0);
        }
      };

      const setup = async () => {
        const generation = ++setupGeneration;
        // Motion (GSAP + Lenis + split-type) ships as its own chunk so the
        // eager base bundle isn't half-unused motion/scroll code on first
        // paint. The hero entry reveal does not depend on it (HeroHeading is
        // CSS-only); this chunk owns below-fold scroll reveals, smooth
        // scroll, and the deferred scroll systems.
        const [motion, { ScrollTrigger }] = await Promise.all([
          import('../lib/motion'),
          import('gsap/ScrollTrigger'),
        ]);
        // A navigation superseded this setup while the chunk was in flight;
        // the new page's own setup owns motion now.
        if (generation !== setupGeneration) return;

        destroySmoothScroll = motion.initSmoothScroll();
        settleScrollPosition(motion.getLenis());
        destroyMotion = motion.initMotion();

        // Heavier scroll systems (Capes pin, parallax rAF) listen for
        // sbh:motion-deferred and init only once the hero reveal has had the
        // first frames to itself, so their pin-spacer/refresh reflow never
        // competes with the reveal.
        const runDeferredMotion = () => {
          document.dispatchEvent(new CustomEvent('sbh:motion-deferred'));
          // Re-assert after ScrollTrigger measures: pin spacers and splits
          // shift layout, and Lenis must not drift back to a stale offset.
          ScrollTrigger.refresh();
          settleScrollPosition(motion.getLenis());
        };
        // No reveal competes under reduced motion, so bring everything up
        // now; otherwise defer to idle (fixed beat where idle is
        // unavailable).
        if (prefersReducedMotion()) {
          runDeferredMotion();
        } else {
          const idle = (
            window as Window & {
              requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
            }
          ).requestIdleCallback;
          if (idle) {
            idle(runDeferredMotion, { timeout: 1200 });
          } else {
            window.setTimeout(runDeferredMotion, 800);
          }
        }
      };

      const teardown = () => {
        // Supersede any in-flight setup still awaiting the motion chunk.
        setupGeneration++;
        destroyMotion();
        destroySmoothScroll();
        destroyMotion = () => {};
        destroySmoothScroll = () => {};
      };

      // Runs on the initial load and after every View Transition navigation.
      document.addEventListener('astro:page-load', setup);
      document.addEventListener('astro:before-swap', (event) => {
        teardown();
        // Astro resets <html> on swap, dropping the `js` class that hides
        // scroll Type Reveal targets. Stamp the incoming document so they
        // start hidden and animate in on navigations instead of flashing
        // visible-then-hidden.
        const newDocument = (event as unknown as { newDocument?: Document }).newDocument;
        newDocument?.documentElement.classList.add('js');
        // Fonts are already cached on a navigation, so stamp the incoming
        // document directly: the hero word reveal plays alongside the route
        // swipe without waiting for the head script to re-run.
        newDocument?.documentElement.setAttribute('data-fonts-ready', '');
        // The preview flag rides the SSR'd <html>, but a prerendered surface
        // can't vary by cookie — propagate it so draft content and GA-off
        // survive every View Transition navigation of the preview session.
        if (document.documentElement.hasAttribute('data-preview')) {
          newDocument?.documentElement.setAttribute('data-preview', '');
        }
      });
      document.addEventListener('astro:before-preparation', (event) => {
        const type = (event as Event & { navigationType?: typeof navigationType }).navigationType;
        if (type) navigationType = type;
      });
    </script>
    {/* The Presentation tool's connection endpoint. Preview-only: regular
       visitors never pay for it. Runs once per session (bundled scripts are
       deduped across View Transitions), which is what the comlink channel
       wants. */}
    {preview && (
      <script>
        import { initVisualEditing } from '../lib/visualEditing';

        initVisualEditing();
      </script>
    )}
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 19px;
        line-height: 1.3;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      img,
      video {
        display: block;
        max-width: 100%;
      }
      a {
        color: inherit;
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
    </style>
  </body>
</html>
