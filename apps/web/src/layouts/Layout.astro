---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/forms.css';
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import { type SurfaceRole } from '../lib/surfaceRole';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  navRole?: SurfaceRole;
  bodyStyle?: string;
}

const {
  title = 'Superbloom House',
  description = 'Superbloom House helps brands make work people actually want to watch, share, and talk about.',
  canonicalUrl = Astro.url.pathname,
  image,
  navRole,
  bodyStyle,
} = Astro.props;

const canonical = new URL(canonicalUrl, Astro.site ?? Astro.url.origin).href;

const host = Astro.url.hostname;
const gaMode =
  host === 'superbloomhouse.com'
    ? 'prod'
    : host === 'superbloom-theta.vercel.app'
      ? 'staging'
      : 'off';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead title={title} description={description} canonicalUrl={canonical} image={image} />
    {/* Preload the site fonts so they are available before first paint. Without
       these, the heading wraps with the system fallback (Arial Narrow / Inter)
       and re-flows when PP Neue Corp / Graphik swap in via font-display: swap.
       That re-flow is what makes the heading visibly shift lower on hard
       refresh, while navbar navigations keep the heading stable because the
       fonts are already cached. */}
    <link
      rel="preload"
      href="/fonts/PPNeueCorp-TightUltrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/PPNeueCorp-CompactUltrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Graphik-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {gaMode !== 'off' && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M4H5NZVDCB"></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-M4H5NZVDCB', {
            send_page_view: false${gaMode === 'staging' ? `,
            debug_mode: true,
            traffic_type: 'internal'` : ''}
          });
        `}></script>
      </>
    )}
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style is:global>
      /* Route Transition — native View Transition swipe: the outgoing page lifts
         and fades, the incoming page rises from below into place. The page's own
         Type Reveal plays on top of the swipe (see the astro:before-swap handler
         below, which stamps the incoming document so reveal targets start
         hidden). */
      @keyframes sbh-route-out {
        to {
          opacity: 0;
          transform: translateY(-1.5rem);
        }
      }
      @keyframes sbh-route-in {
        from {
          opacity: 0;
          transform: translateY(1.5rem);
        }
      }
      ::view-transition-old(root) {
        animation: 280ms cubic-bezier(0.65, 0, 0.35, 1) both sbh-route-out;
      }
      ::view-transition-new(root) {
        animation: 460ms cubic-bezier(0.215, 0.61, 0.355, 1) both sbh-route-in;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body style={bodyStyle}>
    {navRole && <Navigation role={navRole} />}
    <slot />
    <CartDrawer />
    <script>
      import { getLenis, initMotion, initSmoothScroll } from '../lib/motion';
      import { initAnalytics } from '../lib/analytics';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      initAnalytics();

      let destroyMotion = () => {};
      let destroySmoothScroll = () => {};
      // Recorded on astro:before-preparation so page-load can tell fresh
      // navigations (land at the top) from history traversal (browser restores
      // the saved scroll position).
      let navigationType: 'push' | 'replace' | 'traverse' = 'push';

      // Fresh route navigations land at the top of the new page; a URL hash
      // lands on its section. Scrolling goes through Lenis (when active) so its
      // internal scroll state resets too — otherwise Lenis re-applies the
      // previous page's offset on the next frame and the new page appears to
      // load scrolled down (e.g. at the footer).
      const settleScrollPosition = () => {
        if (navigationType === 'traverse') return;
        const hash = window.location.hash;
        const target = hash ? document.getElementById(hash.slice(1)) : null;
        const lenis = getLenis();
        if (lenis) {
          lenis.scrollTo(target ?? 0, { immediate: true, force: true });
        } else if (target) {
          target.scrollIntoView();
        } else {
          window.scrollTo(0, 0);
        }
      };

      const setup = () => {
        destroySmoothScroll = initSmoothScroll();
        settleScrollPosition();
        // The full page-entry Type Reveal plays on the genuine first load and
        // on every View Transition navigation.
        destroyMotion = initMotion();
        // Re-assert after ScrollTrigger measures: pin spacers and splits shift
        // layout, and Lenis must not drift back to a stale offset.
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
          settleScrollPosition();
        });
      };

      const teardown = () => {
        destroyMotion();
        destroySmoothScroll();
        destroyMotion = () => {};
        destroySmoothScroll = () => {};
      };

      // Runs on the initial load and after every View Transition navigation.
      document.addEventListener('astro:page-load', setup);
      document.addEventListener('astro:before-swap', (event) => {
        teardown();
        // Astro resets <html> on swap, dropping the `js` class that hides
        // Type Reveal targets. Stamp the incoming document so hero text starts
        // hidden and the reveal animates on navigations instead of flashing
        // visible-then-hidden.
        const newDocument = (event as unknown as { newDocument?: Document }).newDocument;
        newDocument?.documentElement.classList.add('js');
      });
      document.addEventListener('astro:before-preparation', (event) => {
        const type = (event as Event & { navigationType?: typeof navigationType }).navigationType;
        if (type) navigationType = type;
      });
    </script>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 19px;
        line-height: 1.3;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      img,
      video {
        display: block;
        max-width: 100%;
      }
      a {
        color: inherit;
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
    </style>
  </body>
</html>
