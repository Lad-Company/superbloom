---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/forms.css';
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PageLoader from '../components/PageLoader.astro';
import PreviewBar from '../components/PreviewBar.astro';
import { type SurfaceRole } from '../lib/surfaceRole';
import { isPreviewRequest } from '../lib/preview';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  navRole?: SurfaceRole;
  bodyStyle?: string;
  /** Page renders Mux video somewhere; warms the Mux poster/stream hosts with
     a preconnect. Pages without video skip it so Lighthouse doesn't flag an
     unused preconnect (and the browser doesn't burn an idle connection). */
  hasVideo?: boolean;
}

const {
  title = 'Superbloom House',
  description = 'Superbloom House helps brands make work people actually want to watch, share, and talk about.',
  canonicalUrl = Astro.url.pathname,
  image,
  navRole,
  bodyStyle,
  hasVideo = false,
} = Astro.props;

const canonical = new URL(canonicalUrl, Astro.site ?? Astro.url.origin).href;

// Draft preview: stamp the request marker and keep editor/share-link
// preview traffic out of prod analytics.
const preview = isPreviewRequest(Astro.cookies);

const host = Astro.url.hostname;
const gaMode = preview
  ? 'off'
  : host === 'superbloomhouse.com'
    ? 'prod'
    : host === 'superbloom-theta.vercel.app'
      ? 'staging'
      : 'off';
---

<!doctype html>
<html lang="en" data-preview={preview || undefined} data-ga-id={gaMode !== 'off' ? 'G-M4H5NZVDCB' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead title={title} description={description} canonicalUrl={canonical} image={image} />
    {/* Preload the site fonts so they are available before first paint. Without
       these, the heading wraps with the system fallback (Arial Narrow / Inter)
       and re-flows when PP Neue Corp / Graphik swap in via font-display: swap.
       That re-flow is what makes the heading visibly shift lower on hard
       refresh, while navbar navigations keep the heading stable because the
       fonts are already cached. */}
    <link
      rel="preload"
      href="/fonts/PPNeueCorp-TightUltrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* The marquee variable font is deliberately not preloaded: it only
       appears below the fold on Who We Are, so it swaps in lazily. */}
    <link
      rel="preload"
      href="/fonts/Graphik-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* Warm the Mux hosts (poster thumbnails + HLS manifests) so video frames
       don't pay a fresh DNS+TLS round trip when the player upgrades. Only on
       pages that actually render Mux video — an unused preconnect is flagged
       by Lighthouse and holds an idle connection. */}
    {hasVideo && (
      <>
        <link rel="preconnect" href="https://image.mux.com" crossorigin />
        <link rel="preconnect" href="https://stream.mux.com" crossorigin />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {gaMode !== 'off' && (
      <>
        {/* Consent Mode v2: bootstrap gtag and default every storage type to
           denied before the config runs, so GA only sends cookieless pings
           until the visitor accepts via the consent banner. A previously
           granted choice (localStorage) is re-applied here so returning
           visitors get analytics_storage on from first paint. */}
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500
          });
          try {
            var c = JSON.parse(localStorage.getItem('sbh_consent') || 'null');
            if (c && c.v === 1 && c.status === 'granted') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            }
          } catch (e) {}
        `}></script>
        {/* The gtag/js library (~170 KB gz) is injected from the client on
           idle or first interaction (see the body script below) so it never
           competes with first paint. The config calls below only push onto
           dataLayer, so they queue safely until the library arrives. */}
        <script is:inline set:html={`
          gtag('js', new Date());
          gtag('config', 'G-M4H5NZVDCB', {
            send_page_view: false${gaMode === 'staging' ? `,
            debug_mode: true,
            traffic_type: 'internal'` : ''}
          });
        `}></script>
      </>
    )}
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style is:global>
      /* Route Transition — native View Transition swipe: the outgoing page lifts
         and fades, the incoming page rises from below into place. The page's own
         Type Reveal plays on top of the swipe (see the astro:before-swap handler
         below, which stamps the incoming document so reveal targets start
         hidden). */
      @keyframes sbh-route-out {
        to {
          opacity: 0;
          transform: translateY(-1.5rem);
        }
      }
      @keyframes sbh-route-in {
        from {
          opacity: 0;
          transform: translateY(1.5rem);
        }
      }
      ::view-transition-old(root) {
        animation: 280ms cubic-bezier(0.65, 0, 0.35, 1) both sbh-route-out;
      }
      ::view-transition-new(root) {
        animation: 460ms cubic-bezier(0.215, 0.61, 0.355, 1) both sbh-route-in;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body style={bodyStyle}>
    <PageLoader />
    {navRole && <Navigation role={navRole} />}
    <slot />
    <CartDrawer />
    {preview && <PreviewBar />}
    {(gaMode !== 'off' || import.meta.env.DEV) && <CookieConsent />}
    <script>
      import { getLenis, initMotion, initSmoothScroll, prefersReducedMotion } from '../lib/motion';
      import { initAnalytics } from '../lib/analytics';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      initAnalytics();

      // Lazy gtag/js: the library is ~170 KB gz and only ever receives queued
      // dataLayer pushes, so it loads on idle (or first interaction, whichever
      // comes first) instead of blocking the critical path. Injected once per
      // session; bundled scripts persist across View Transitions, so the
      // module-level flag is enough. No-op when gaMode is 'off' (the attribute
      // is absent).
      const gaId = document.documentElement.dataset.gaId;
      let gtagRequested = false;
      const loadGtag = () => {
        if (gtagRequested || !gaId) return;
        gtagRequested = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(script);
      };
      if (gaId) {
        const idle = (
          window as Window & {
            requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
          }
        ).requestIdleCallback;
        if (idle) {
          idle(loadGtag, { timeout: 3000 });
        } else {
          window.setTimeout(loadGtag, 2000);
        }
        for (const eventName of ['pointerdown', 'keydown', 'scroll'] as const) {
          window.addEventListener(eventName, loadGtag, { once: true, passive: true });
        }
      }

      let destroyMotion = () => {};
      let destroySmoothScroll = () => {};
      // The global veil only runs on the genuine first load; View Transition
      // navigations dismiss it in astro:before-swap and this flips false.
      let isFirstLoad = true;

      const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));

      // Resolve once fonts and every above-the-fold media element are in,
      // capped so a slow asset can never strand the veil. "Above the fold" is
      // the eager / high-priority images (each video frame's poster included)
      // plus any lazy image whose box intersects the initial viewport: card
      // grids mark only their lead card eager, so without the rect check the
      // veil lifted onto neighbouring cards still painting alt text.
      const whenCriticalMediaReady = (timeoutMs: number) => {
        const viewportH = window.innerHeight;
        const inInitialViewport = (img: HTMLImageElement) => {
          const rect = img.getBoundingClientRect();
          return rect.bottom > 0 && rect.top < viewportH && rect.width > 0 && rect.height > 0;
        };
        const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('img')).filter(
          (img) =>
            !img.complete &&
            (img.fetchPriority === 'high' || img.loading === 'eager' || inInitialViewport(img)),
        );
        const imgReady = imgs.map(
          (img) =>
            new Promise<void>((resolve) => {
              img.addEventListener('load', () => resolve(), { once: true });
              img.addEventListener('error', () => resolve(), { once: true });
            }),
        );
        const fontsReady = document.fonts?.ready ?? Promise.resolve();
        return Promise.race([Promise.all([...imgReady, fontsReady]), wait(timeoutMs)]);
      };

      // Two thresholds (design-system §4, Three-Phase Loading). If critical
      // media lands almost at once (warm cache) the veil was never perceptibly
      // visible, so lift immediately: the hero only registers as LCP once the
      // veil lifts (Chrome excludes the opacity-0 reveal-gated paint), and a
      // flat floor here was 280ms of LCP on every repeat visit for nothing.
      // Past that point the user has seen the veil, so hold it to the 400ms
      // beat: it reads as a deliberate moment rather than a flicker, and on a
      // cold load the media wait usually exceeds it anyway. The clock starts at
      // script start, later than first paint, so the imperceptible window is
      // conservative.
      const VEIL_IMPERCEPTIBLE_MS = 100;
      const VEIL_BEAT_MS = 400;
      const runPageLoader = async (loader: HTMLElement) => {
        const start = performance.now();
        await whenCriticalMediaReady(4000);
        const elapsed = performance.now() - start;
        if (!prefersReducedMotion() && elapsed > VEIL_IMPERCEPTIBLE_MS) {
          const remaining = VEIL_BEAT_MS - elapsed;
          if (remaining > 0) await wait(remaining);
        }
        loader.setAttribute('data-loader-done', '');
      };
      // Recorded on astro:before-preparation so page-load can tell fresh
      // navigations (land at the top) from history traversal (browser restores
      // the saved scroll position).
      let navigationType: 'push' | 'replace' | 'traverse' = 'push';

      // Fresh route navigations land at the top of the new page; a URL hash
      // lands on its section. Scrolling goes through Lenis (when active) so its
      // internal scroll state resets too — otherwise Lenis re-applies the
      // previous page's offset on the next frame and the new page appears to
      // load scrolled down (e.g. at the footer).
      const settleScrollPosition = () => {
        if (navigationType === 'traverse') return;
        const hash = window.location.hash;
        const target = hash ? document.getElementById(hash.slice(1)) : null;
        const lenis = getLenis();
        if (lenis) {
          lenis.scrollTo(target ?? 0, { immediate: true, force: true });
        } else if (target) {
          target.scrollIntoView();
        } else {
          window.scrollTo(0, 0);
        }
      };

      // Heavier scroll systems (Capes pin, parallax rAF) listen for this and
      // init only once the hero reveal has had the first frames to itself, so
      // their pin-spacer/refresh reflow never competes with the reveal.
      const runDeferredMotion = () => {
        document.dispatchEvent(new CustomEvent('sbh:motion-deferred'));
        // Re-assert after ScrollTrigger measures: pin spacers and splits shift
        // layout, and Lenis must not drift back to a stale offset.
        ScrollTrigger.refresh();
        settleScrollPosition();
      };

      const scheduleDeferredMotion = () => {
        // No reveal competes under reduced motion, so bring everything up now.
        if (prefersReducedMotion()) {
          runDeferredMotion();
          return;
        }
        const idle = (
          window as Window & {
            requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
          }
        ).requestIdleCallback;
        if (idle) {
          idle(runDeferredMotion, { timeout: 1200 });
        } else {
          window.setTimeout(runDeferredMotion, 800);
        }
      };

      const setup = async () => {
        destroySmoothScroll = initSmoothScroll();
        settleScrollPosition();
        // First hard load: hold the veil until fonts + above-the-fold media are
        // ready, so startup layout work and any media fetch happen behind it and
        // the hero reveal plays on a clean frame as the veil lifts.
        if (isFirstLoad) {
          const loader = document.querySelector<HTMLElement>('[data-page-loader]');
          if (loader && !loader.hasAttribute('data-loader-done')) {
            await runPageLoader(loader);
          }
        }
        isFirstLoad = false;
        // The full page-entry Type Reveal plays on the genuine first load and
        // on every View Transition navigation.
        destroyMotion = initMotion();
        // Let the reveal own the first frames, then bring up the heavy scroll
        // systems and re-measure on idle (fixed beat where idle is unavailable).
        scheduleDeferredMotion();
      };

      const teardown = () => {
        destroyMotion();
        destroySmoothScroll();
        destroyMotion = () => {};
        destroySmoothScroll = () => {};
      };

      // Runs on the initial load and after every View Transition navigation.
      document.addEventListener('astro:page-load', setup);
      document.addEventListener('astro:before-swap', (event) => {
        teardown();
        // Astro resets <html> on swap, dropping the `js` class that hides
        // Type Reveal targets. Stamp the incoming document so hero text starts
        // hidden and the reveal animates on navigations instead of flashing
        // visible-then-hidden.
        const newDocument = (event as unknown as { newDocument?: Document }).newDocument;
        newDocument?.documentElement.classList.add('js');
        // The preview flag rides the SSR'd <html>, but a prerendered surface
        // can't vary by cookie — propagate it so draft content and GA-off
        // survive every View Transition navigation of the preview session.
        if (document.documentElement.hasAttribute('data-preview')) {
          newDocument?.documentElement.setAttribute('data-preview', '');
        }
        // The route swipe owns navigations, so the incoming page's veil starts
        // already dismissed and never flashes over a client-side transition.
        newDocument?.querySelector('[data-page-loader]')?.setAttribute('data-loader-done', '');
      });
      document.addEventListener('astro:before-preparation', (event) => {
        const type = (event as Event & { navigationType?: typeof navigationType }).navigationType;
        if (type) navigationType = type;
      });
    </script>
    {/* The Presentation tool's connection endpoint. Preview-only: regular
       visitors never pay for it. Runs once per session (bundled scripts are
       deduped across View Transitions), which is what the comlink channel
       wants. */}
    {preview && (
      <script>
        import { initVisualEditing } from '../lib/visualEditing';

        initVisualEditing();
      </script>
    )}
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 19px;
        line-height: 1.3;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      img,
      video {
        display: block;
        max-width: 100%;
      }
      a {
        color: inherit;
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
    </style>
  </body>
</html>
