---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/forms.css';
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import { type SurfaceRole } from '../lib/surfaceRole';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  navRole?: SurfaceRole;
  bodyStyle?: string;
}

const {
  title = 'Superbloom House',
  description = 'Superbloom House helps brands make work people actually want to watch, share, and talk about.',
  canonicalUrl = Astro.url.pathname,
  image,
  navRole,
  bodyStyle,
} = Astro.props;

const canonical = new URL(canonicalUrl, Astro.site ?? Astro.url.origin).href;

const host = Astro.url.hostname;
const gaMode =
  host === 'superbloomhouse.com'
    ? 'prod'
    : host === 'superbloom-theta.vercel.app'
      ? 'staging'
      : 'off';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead title={title} description={description} canonicalUrl={canonical} image={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {gaMode !== 'off' && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M4H5NZVDCB"></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-M4H5NZVDCB', {
            send_page_view: false${gaMode === 'staging' ? `,
            debug_mode: true,
            traffic_type: 'internal'` : ''}
          });
        `}></script>
      </>
    )}
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style is:global>
      /* Route Transition — native View Transition swipe: the outgoing page lifts
         and fades, the incoming page rises from below into place. The page's own
         Type Reveal plays on top of the swipe (see the astro:before-swap handler
         below, which stamps the incoming document so reveal targets start
         hidden). */
      @keyframes sbh-route-out {
        to {
          opacity: 0;
          transform: translateY(-1.5rem);
        }
      }
      @keyframes sbh-route-in {
        from {
          opacity: 0;
          transform: translateY(1.5rem);
        }
      }
      ::view-transition-old(root) {
        animation: 280ms cubic-bezier(0.65, 0, 0.35, 1) both sbh-route-out;
      }
      ::view-transition-new(root) {
        animation: 460ms cubic-bezier(0.215, 0.61, 0.355, 1) both sbh-route-in;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body style={bodyStyle}>
    {navRole && <Navigation role={navRole} />}
    <slot />
    <CartDrawer />
    <script>
      import { initMotion, initSmoothScroll } from '../lib/motion';
      import { initAnalytics } from '../lib/analytics';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      initAnalytics();

      let destroyMotion = () => {};
      let destroySmoothScroll = () => {};

      const setup = () => {
        destroySmoothScroll = initSmoothScroll();
        // The full page-entry Type Reveal plays on the genuine first load and
        // on every View Transition navigation.
        destroyMotion = initMotion();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      };

      const teardown = () => {
        destroyMotion();
        destroySmoothScroll();
        destroyMotion = () => {};
        destroySmoothScroll = () => {};
      };

      // Runs on the initial load and after every View Transition navigation.
      document.addEventListener('astro:page-load', setup);
      document.addEventListener('astro:before-swap', (event) => {
        teardown();
        // Astro resets <html> on swap, dropping the `js` class that hides
        // Type Reveal targets. Stamp the incoming document so hero text starts
        // hidden and the reveal animates on navigations instead of flashing
        // visible-then-hidden.
        const newDocument = (event as unknown as { newDocument?: Document }).newDocument;
        newDocument?.documentElement.classList.add('js');
      });
    </script>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 19px;
        line-height: 1.3;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      img,
      video {
        display: block;
        max-width: 100%;
      }
      a {
        color: inherit;
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
    </style>
  </body>
</html>
