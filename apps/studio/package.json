{
  "name": "studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --path schema.json --force && sanity typegen generate",
    "audit:zine": "sanity exec migrations/audit-zine-membership.ts",
    "audit:article-locations": "sanity exec migrations/audit-article-locations.ts",
    "backup:zine": "sanity exec migrations/backup-zine-data.ts",
    "backup:index": "sanity exec migrations/backup-index-page-data.ts",
    "migrate:index": "pnpm run backup:index && sanity exec migrations/migrate-index-page.ts",
    "backup:card-carousel": "sanity exec migrations/backup-card-carousel-data.ts",
    "migrate:card-carousel": "pnpm run backup:card-carousel && sanity exec migrations/migrate-card-carousel-data.ts",
    "backup:work": "sanity exec migrations/backup-work-index-data.ts",
    "migrate:work": "pnpm run backup:work && sanity exec migrations/migrate-work-index.ts",
    "migrate:zine": "sanity exec migrations/migrate-zine-issues.ts",
    "migrate:zine-issue-mode": "sanity exec migrations/migrate-zine-issue-mode.ts",
    "migrate:zine-landing": "sanity exec migrations/migrate-zine-landing-content.ts",
    "migrate:zine-landing-intro": "sanity exec migrations/migrate-zine-landing-intro.ts",
    "migrate:article-body": "sanity exec migrations/migrate-article-body.ts",
    "migrate:standardize-article": "sanity exec migrations/standardize-article.ts",
    "migrate:prune-empty-media": "sanity exec migrations/prune-empty-mediabox-assets.ts",
    "migrate:case-study-rows": "sanity exec migrations/migrate-case-study-narrative-sections.ts",
    "backup:text-block-headings": "sanity exec migrations/backup-text-block-headings.ts --with-user-token",
    "migrate:text-block-headings": "pnpm run backup:text-block-headings && sanity exec migrations/remove-text-block-headings.ts --with-user-token",
    "backup:capability-contextual-copy": "sanity exec migrations/backup-capability-contextual-copy.ts --with-user-token",
    "migrate:capability-contextual-copy": "pnpm run backup:capability-contextual-copy && sanity exec migrations/remove-capability-contextual-copy.ts --with-user-token",
    "seed:capabilities": "sanity dataset import seed-capabilities.ndjson production --replace",
    "seed:tyson": "sanity exec migrations/seed-tyson.ts"
  },
  "dependencies": {
    "@sanity/color-input": "^6.1.3",
    "@sanity/orderable-document-list": "^2.0.20",
    "@superbloom/schemas": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "sanity": "^6.9.2",
    "sanity-plugin-mux-input": "^5.0.10",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.3"
  }
}
